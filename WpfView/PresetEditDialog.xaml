<Window x:Class="BarcodePrint.WpfView.PresetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="라벨 규격 프리셋 수정" Height="410" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="라벨 규격 프리셋 수정" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                    <TextBlock Text="메인 화면의 규격 명칭 및 가로/세로 인쇄 크기를 변경합니다." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- 1. 규격 명칭 (Title) -->
            <TextBlock Text="규격 명칭 (이름)" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtTitle" Height="34" FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1.2" Margin="0,0,0,14" Background="White"/>

            <!-- 2. 규격 크기 (Width x Height) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="가로 너비 (mm)" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtWidth" Height="34" FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1.2" Background="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="세로 높이 (mm)" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtHeight" Height="34" FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1.2" Background="White"/>
                </StackPanel>
            </Grid>

            <!-- 3. 간단 설명 (Description) -->
            <TextBlock Text="용도 및 설명" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDescription" Height="34" FontSize="12.5" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#CBD5E1" BorderThickness="1.2" Margin="0,0,0,8" Background="White"/>

            <TextBlock Text="💡 크기는 10 ~ 300 mm 범위 내에서 소수점 입력도 가능합니다." FontSize="11" Foreground="#94A3B8" Margin="2,0,0,0"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Click="Cancel_Click" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" FontSize="12.5" Height="34" Width="76" Margin="0,0,8,0" Cursor="Hand" BorderThickness="1" BorderBrush="#CBD5E1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="저장 완료" Click="Save_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12.5" Height="34" Width="92" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
