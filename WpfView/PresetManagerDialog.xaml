<Window x:Class="BarcodePrint.WpfView.PresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자주 사용하는 라벨 규격 관리 &amp; 순서 변경" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="자주 사용하는 라벨 규격 관리 &amp; 순서 변경" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                    <TextBlock Text="메인 화면에 배치될 4가지 라벨 규격의 순서를 변경하거나 크기를 직접 설정합니다." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Body: List + Action Controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- Preset Items List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="6">
                <ListBox x:Name="LstPresets" BorderThickness="0" Background="Transparent" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 순번 번호 -->
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IndexNumber}" FontWeight="Bold" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- 명칭 & 설명 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 크기 배지 -->
                                <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplaySize}" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Control Buttons (순서 변경 & 수정) -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Button Content="▲ 위로 이동" Click="OnMoveUpClick" Height="34" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="▼ 아래로 이동" Click="OnMoveDownClick" Height="34" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,0,14">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Separator Margin="0,0,0,14" Background="#E2E8F0"/>

                <Button Content="✏️ 규격 수정..." Click="OnEditSelectedClick" Height="34" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="↺ 기본값 복원" Click="OnResetDefaultsClick" Height="32" Background="#F8FAFC" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="💡 항목을 선택 후 [▲ 위로], [▼ 아래로]를 눌러 순서를 조정하세요." FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Click="OnCancelClick" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" FontSize="12.5" Height="34" Width="76" Margin="0,0,8,0" Cursor="Hand" BorderThickness="1" BorderBrush="#CBD5E1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="💾 저장 및 적용" Click="OnSaveClick" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12.5" Height="34" Padding="14,0" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
