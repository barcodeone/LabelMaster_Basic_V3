<Window x:Class="BarcodePrint.WpfView.PrintSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="라벨 인쇄 설정 - LabelMaster"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Pretendard, 맑은 고딕, Malgun Gothic, Segoe UI, sans-serif"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Mini Stepper Button Style -->
        <Style x:Key="DialogStepBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Close Button -->
        <Style x:Key="DialogCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="DialogSecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Start Print Button (Hero Blue) -->
        <Style x:Key="DialogPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>
        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <!-- 0. 헤더 -->
                <RowDefinition Height="Auto"/>
                <!-- 1. 구분선 -->
                <RowDefinition Height="Auto"/>
                <!-- 2. 본문 컨텐츠 (스크롤 가능) -->
                <RowDefinition Height="*"/>
                <!-- 3. 하단 액션 버튼 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. 헤더 영역 (타이틀 & 닫기 ✕) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseClick" Style="{StaticResource DialogCloseBtnStyle}" Width="32" Height="32"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖨️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="라벨 인쇄 설정 (Print Setup)" FontWeight="Bold" FontSize="17" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- 1. 구분선 -->
            <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,14"/>

            <!-- 2. 본문 영역 -->
            <ScrollViewer Grid.Row="2" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <!-- ============================================================== -->
                    <!-- [A. 엑셀 연동 인쇄 범위 선택] (엑셀 파일 로드 시에만 표시)       -->
                    <!-- ============================================================== -->
                    <Border x:Name="BorderExcelPrintRange" Background="#F0FDFA" BorderBrush="#5EEAD4" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="📊 엑셀 데이터 인쇄 범위" FontWeight="Bold" FontSize="13.5" Foreground="#0F766E" VerticalAlignment="Center"/>
                                <Border Background="#CCFBF1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtExcelTotalInfo" Text="총 0건 연동됨" FontSize="11" FontWeight="Bold" Foreground="#0D9488"/>
                                </Border>
                            </DockPanel>

                            <!-- 라디오 버튼 그룹 -->
                            <StackPanel Margin="2,2,0,0">
                                <!-- 1. 전체 데이터 인쇄 -->
                                <RadioButton x:Name="RbExcelAll" GroupName="ExcelPrintRange" Content="전체 데이터 인쇄" FontSize="12.5" FontWeight="SemiBold" Foreground="#134E4A" IsChecked="True" Margin="0,3" Checked="OnExcelRangeOptionChanged"/>

                                <!-- 2. 현재 미리보기 페이지만 인쇄 -->
                                <RadioButton x:Name="RbExcelCurrent" GroupName="ExcelPrintRange" Content="현재 미리보기 페이지만 인쇄 (제 1행)" FontSize="12.5" FontWeight="SemiBold" Foreground="#134E4A" Margin="0,4" Checked="OnExcelRangeOptionChanged"/>

                                <!-- 3. 구간 지정 인쇄 -->
                                <RadioButton x:Name="RbExcelRange" GroupName="ExcelPrintRange" Content="구간 지정 인쇄 (시작 행 ~ 종료 행)" FontSize="12.5" FontWeight="SemiBold" Foreground="#134E4A" Margin="0,4" Checked="OnExcelRangeOptionChanged"/>

                                <!-- 구간 지정 입력 폼 (숨김/표시) -->
                                <Border x:Name="PanelExcelRangeInputs" Background="White" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="22,2,0,6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="시작 행:" FontSize="12" Foreground="#0F766E" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtRangeStart" Width="55" Height="28" Margin="6,0,12,0" Text="1" FontSize="12.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <TextBlock Text="종료 행:" FontSize="12" Foreground="#0F766E" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtRangeEnd" Width="55" Height="28" Margin="6,0,0,0" Text="1" FontSize="12.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 특정 페이지 직접 지정 -->
                                <RadioButton x:Name="RbExcelSpecific" GroupName="ExcelPrintRange" Content="특정 페이지 직접 지정" FontSize="12.5" FontWeight="SemiBold" Foreground="#134E4A" Margin="0,4" Checked="OnExcelRangeOptionChanged"/>

                                <!-- 특정 페이지 입력 폼 (숨김/표시) -->
                                <Border x:Name="PanelExcelSpecificInputs" Background="White" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="22,2,0,4" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBox x:Name="TxtSpecificPages" Height="30" Padding="8,4" FontSize="12" ToolTip="쉼표(,) 또는 하이픈(-)으로 페이지를 지정합니다. 예: 1, 3, 5-8"/>
                                        <TextBlock Text="💡 쉼표(,) 또는 하이픈(-)으로 번호 구분 (예: 1, 3, 5-8)" FontSize="10.5" Foreground="#0D9488" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================================================== -->
                    <!-- [B. 기본 설정: 인쇄 매수 및 방향]                              -->
                    <!-- ============================================================== -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📄 기본 인쇄 매수 및 방향" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 인쇄 매수 조절 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="인쇄 매수" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <DockPanel LastChildFill="True">
                                        <Button Content="-" Click="OnCopiesMinusClick" Style="{StaticResource DialogStepBtnStyle}" Width="32" Height="34"/>
                                        <Button DockPanel.Dock="Right" Content="+" Click="OnCopiesPlusClick" Style="{StaticResource DialogStepBtnStyle}" Width="32" Height="34"/>
                                        <TextBox x:Name="TxtCopies" Margin="3,0" Text="1" Height="34" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- 인쇄 방향 (회전) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="인쇄 방향" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CboRotation" Height="34" FontSize="12.5" VerticalContentAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem Content="0° (정방향 기본)"/>
                                        <ComboBoxItem Content="90° (시계방향 90°)"/>
                                        <ComboBoxItem Content="180° (상하 반전)"/>
                                        <ComboBoxItem Content="270° (반시계 90°)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ============================================================== -->
                    <!-- [C. 고급 설정 토글 버튼 (아코디언)]                             -->
                    <!-- ============================================================== -->
                    <Button x:Name="BtnToggleAdvanced" Click="OnToggleAdvancedClick" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="2,0,0,8" Padding="0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtToggleAdvancedArrow" Text="▶" FontSize="11" Foreground="#4F46E5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtToggleAdvancedLabel" Text="고급 인쇄 옵션 펼치기 (속도/농도/센서/오프셋)" FontSize="12.5" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- [C-2. 고급 설정 상세 패널 (기본 숨김)] -->
                    <Border x:Name="PanelAdvancedOptions" Background="#F8FAFC" BorderBrush="#E0E7FF" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <!-- 1. 인쇄 방식 -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="인쇄 방식" Width="80" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboPrintMethod" Height="30" FontSize="12" VerticalContentAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="감열식 (Direct Thermal - 감열지 필수)"/>
                                    <ComboBoxItem Content="열전사 (Thermal Transfer - 잉크 리본 장착)"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- 2. 인쇄 속도 & 농도 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 속도 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="인쇄 속도" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboSpeed" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <!-- 농도 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="인쇄 농도 (Darkness)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboDarkness" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 3. 용지 센서 및 간격 (Gap / Bline / Continuous) -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="센서 유형" Width="80" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboPaperSensor" Height="30" FontSize="12" VerticalContentAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="간격 용지 (GAP / 라벨 스티커)"/>
                                    <ComboBoxItem Content="블랙마크 (BLINE / 뒷면 검은선)"/>
                                    <ComboBoxItem Content="연속 용지 (CONTINUOUS / 영수증 등)"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- 4. 갭 높이 & 오프셋 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0">
                                    <TextBlock Text="간격(Gap): " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text=" mm" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtGapHeight" Text="2.0" Height="28" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock Text="피드(Feed): " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text=" mm" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtFeedOffset" Text="0.0" Height="28" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                </DockPanel>
                            </Grid>

                            <!-- 5. 빠른 급지 테스트 -->
                            <Button Click="OnQuickFeedClick" Style="{StaticResource DialogSecondaryBtnStyle}" Height="34" FontSize="12" ToolTip="라벨 용지 1장을 배출하여 센서 정렬을 점검합니다.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="라벨 1장 급지 (피드 점검)" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 현재 대상 프린터 안내 뱃지 -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="연결 프린터:" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTargetPrinterName" Text="Xprinter XP-D4604B" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. 하단 액션 버튼 바 -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="닫기" Click="OnCloseClick" Style="{StaticResource DialogSecondaryBtnStyle}" IsCancel="True"/>
                <Button x:Name="BtnStartPrint" Grid.Column="2" Click="OnStartPrintClick" Style="{StaticResource DialogPrimaryBtnStyle}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖨️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="라벨 인쇄 시작" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
