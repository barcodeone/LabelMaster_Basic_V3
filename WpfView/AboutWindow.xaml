<Window x:Class="BarcodePrint.WpfView.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ℹ️ LabelMaster Basic v2 - 프로그램 및 업체 정보" Height="600" Width="530"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Tabs or Scrollable Cards -->
            <RowDefinition Height="*"/>
            <!-- Bottom Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Bright Elegant Header Banner -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏷️ LabelMaster" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Basic v2.0" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Xprinter 바코드 &amp; 엑셀 라벨 인쇄 시스템" FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="한국Xprinter" FontWeight="Bold" FontSize="12.5" Foreground="#1D4ED8"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Information Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <!-- Card 1: 프로그램 및 개발/공급사 정보 -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🏢 업체 및 개발 정보" FontWeight="Bold" FontSize="13.5" Foreground="#1E3A8A" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="개발 / 공급사:" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="한국Xprinter (Xprinter Korea)" FontWeight="SemiBold" Foreground="#1E293B" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="공식 웹사이트:" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <Hyperlink NavigateUri="https://xprinter.co.kr" RequestNavigate="OnHyperlinkRequestNavigate">
                                    https://xprinter.co.kr
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="최신버전 다운로드 링크:" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <Hyperlink NavigateUri="https://xpix.co.kr/labelmaster/basic/download" RequestNavigate="OnHyperlinkRequestNavigate">
                                    https://xpix.co.kr/labelmaster/basic/download
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="프로그램 문의:" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <Hyperlink NavigateUri="mailto:help@endream.com" RequestNavigate="OnHyperlinkRequestNavigate">
                                    help@endream.com
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="지원 프린터:" FontWeight="Bold" Foreground="#64748B" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Xprinter 라벨 프린터 전기종 (XP-423B, D4601B, DT108B, T4501 등)" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="※ 일부 모델은 지원되지 않을 수 있습니다." Foreground="#DC2626" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: 라이선스 및 인증 정보 -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📜 라이선스 및 인증 정보" FontWeight="Bold" FontSize="13.5" Foreground="#0F766E" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="본 소프트웨어는 한국Xprinter 정품 하드웨어 고객을 위한 전용 상용 라이선스(Commercial License) 프로그램입니다." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="• 정품 Xprinter 장치 연결 시 자동으로 정품 인증 및 인쇄가 허가됩니다." FontSize="11.5" Foreground="#475569" Margin="0,2"/>
                        <TextBlock Text="• 서버 인증 기반의 시리얼 라이선스를 지원합니다." FontSize="11.5" Foreground="#475569" Margin="0,2"/>
                        <TextBlock Text="Copyright © 2026 한국Xprinter. All rights reserved." FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: 사용된 오픈소스 라이브러리 -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="📦 오픈소스 라이브러리 고지" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,8"/>
                        <TextBlock Text="• ClosedXML (MIT License) - 엑셀 파일 입출력 처리" FontSize="11" Foreground="#64748B" Margin="0,1"/>
                        <TextBlock Text="• DocumentFormat.OpenXml (MIT License) - OpenXML 포맷 지원" FontSize="11" Foreground="#64748B" Margin="0,1"/>
                        <TextBlock Text="• ZXing.Net (Apache 2.0 License) - 1D/2D 바코드 렌더링" FontSize="11" Foreground="#64748B" Margin="0,1"/>
                        <TextBlock Text="• Costura.Fody (MIT License) - 단일 실행 파일 번들링" FontSize="11" Foreground="#64748B" Margin="0,1"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Action Buttons -->
        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🌐 공식 웹사이트" Click="OnOpenWebsiteClick" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0" FontSize="12" Margin="0,0,6,0"/>
                <Button Content="⬇️ 최신버전 다운로드" Click="OnOpenDownloadClick" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0" FontSize="12"/>
            </StackPanel>
            <Button Content="닫기" Click="OnCloseClick" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Height="36" Width="80" FontSize="12.5"/>
        </DockPanel>
    </Grid>
</Window>
