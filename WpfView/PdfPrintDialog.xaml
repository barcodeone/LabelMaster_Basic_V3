<Window x:Class="BarcodePrint.WpfView.PdfPrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDF 송장 / 문서 인쇄 - LabelMaster"
        Width="880" Height="680" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic"
        Background="#F1F5F9"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>

        <!-- Mini Step Button Style -->
        <Style x:Key="MiniStepBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button -->
        <Style x:Key="ModernActionBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="64"/>
            <!-- 1. Content Body -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Status Bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PDF 송장 / 문서 빠른 인쇄" FontWeight="ExtraBold" FontSize="17" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="BadgePageCount" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTotalPagesBadge" Text="총 1페이지" FontSize="11.5" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtPdfFileName" Text="파일명: sample.pdf" FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁 다른 PDF 열기" Click="OnOpenOtherPdfClick" Style="{StaticResource MiniStepBtnStyle}" Height="32" Padding="12,0" FontSize="12.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Content Body (Left: Preview, Right: Settings) -->
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.ColumnDefinitions>
                <!-- Left: Interactive Page Preview -->
                <ColumnDefinition Width="5*" MinWidth="340"/>
                <!-- Splitter/Gap -->
                <ColumnDefinition Width="16"/>
                <!-- Right: Print Options & Actions -->
                <ColumnDefinition Width="4*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT: PDF Page Preview Card                    -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Toolbar: Rotation & Fit -->
                        <RowDefinition Height="Auto"/>
                        <!-- Center Preview Canvas -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Page Navigator -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Preview Tools -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 페이지 미리보기" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock x:Name="TxtPageResolution" Text="(203 DPI 최적화)" FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="6,2,0,0"/>
                        </StackPanel>

                        <!-- Rotation Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="회전:" FontSize="12" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="BtnRotate0" Content="0°" Click="OnRotateClick" Tag="0" Style="{StaticResource MiniStepBtnStyle}" Width="34" Height="26" Margin="0,0,3,0"/>
                            <Button x:Name="BtnRotate90" Content="90°" Click="OnRotateClick" Tag="90" Style="{StaticResource MiniStepBtnStyle}" Width="34" Height="26" Margin="0,0,3,0"/>
                            <Button x:Name="BtnRotate180" Content="180°" Click="OnRotateClick" Tag="180" Style="{StaticResource MiniStepBtnStyle}" Width="38" Height="26" Margin="0,0,3,0"/>
                            <Button x:Name="BtnRotate270" Content="270°" Click="OnRotateClick" Tag="270" Style="{StaticResource MiniStepBtnStyle}" Width="38" Height="26"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Center Preview Image Area -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="10">
                        <Grid>
                            <!-- Actual Image -->
                            <Image x:Name="ImgPdfPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <!-- Loading / Fallback Indicator -->
                            <StackPanel x:Name="PanelLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="⏳" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="페이지 렌더링 중..." FontSize="12.5" Foreground="{StaticResource TextSubBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Page Navigation Bar -->
                    <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnPrevPage" Grid.Column="0" Content="◀ 이전 페이지" Click="OnPrevPageClick" Style="{StaticResource MiniStepBtnStyle}" Width="100" Height="30" FontSize="12.5"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="14,4">
                                    <TextBlock x:Name="TxtPageIndicator" Text="1 / 1 페이지" FontWeight="Bold" FontSize="13" Foreground="#1E40AF"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="BtnNextPage" Grid.Column="2" Content="다음 페이지 ▶" Click="OnNextPageClick" Style="{StaticResource MiniStepBtnStyle}" Width="100" Height="30" FontSize="12.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- RIGHT: Print Settings & Action Panel           -->
            <!-- ============================================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Card 1: 라벨 용지 규격 (W x H) -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="🏷️ 라벨 용지 규격 (mm)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ 현재규격 등록" Click="OnAddCurrentPresetClick" Style="{StaticResource MiniStepBtnStyle}" Height="23" Padding="6,0" FontSize="11" Margin="0,0,4,0" ToolTip="현재 입력된 너비/높이를 자주 쓰는 규격에 즉시 추가합니다."/>
                                    <Button Content="⚙️ 규격 관리" Click="OnManagePresetsClick" Style="{StaticResource MiniStepBtnStyle}" Height="23" Padding="6,0" FontSize="11" ToolTip="자주 쓰는 규격 목록 수정 및 삭제"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 너비 (Width) -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="용지 너비 (W):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSubBrush}" Margin="0,0,0,3"/>
                                    <DockPanel>
                                        <Button Content="-" Click="OnDecreaseWidthClick" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="28"/>
                                        <TextBox x:Name="TxtPaperWidth" Text="100" TextChanged="OnPaperDimensionChanged" FontSize="13" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="3,0"/>
                                        <Button Content="+" Click="OnIncreaseWidthClick" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="28"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- 높이 (Height) -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="용지 높이 (H):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSubBrush}" Margin="0,0,0,3"/>
                                    <DockPanel>
                                        <Button Content="-" Click="OnDecreaseHeightClick" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="28"/>
                                        <TextBox x:Name="TxtPaperHeight" Text="100" TextChanged="OnPaperDimensionChanged" FontSize="13" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="3,0"/>
                                        <Button Content="+" Click="OnIncreaseHeightClick" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="28"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 동적 규격 프리셋 칩 목록 (코드비하인드에서 렌더링) -->
                            <WrapPanel x:Name="PanelPresetChips" Margin="0,4,0,0">
                                <!-- 기본 칩 템플릿 (초기 표시용) -->
                                <Button Content="100x100" Click="OnPresetSizeClick" Tag="100,100" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,4"/>
                                <Button Content="100x150" Click="OnPresetSizeClick" Tag="100,150" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,4"/>
                                <Button Content="80x50" Click="OnPresetSizeClick" Tag="80,50" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,4"/>
                                <Button Content="70x100" Click="OnPresetSizeClick" Tag="70,100" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,4"/>
                                <Button Content="70x30" Click="OnPresetSizeClick" Tag="70,30" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,4"/>
                                <Button Content="50x30" Click="OnPresetSizeClick" Tag="50,30" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: 인쇄 범위 및 매수 -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📑 인쇄 범위 및 매수" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,10"/>

                            <RadioButton x:Name="RbAllPages" Content="전체 페이지 모두 인쇄" IsChecked="True" GroupName="PdfRange" FontSize="12.5" Margin="0,0,0,6" Checked="OnPrintRangeRadioChanged"/>
                            <RadioButton x:Name="RbCurrentPage" Content="현재 페이지만 인쇄" GroupName="PdfRange" FontSize="12.5" Margin="0,0,0,6" Checked="OnPrintRangeRadioChanged"/>
                            <RadioButton x:Name="RbCustomPages" Content="페이지 구간 직접 지정" GroupName="PdfRange" FontSize="12.5" Margin="0,0,0,4" Checked="OnPrintRangeRadioChanged"/>

                            <!-- 구간 직접 지정 옵션 패널 -->
                            <Border x:Name="BorderCustomRange" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="20,2,0,8">
                                <StackPanel>
                                    <!-- 1) 시작 ~ 끝 페이지 스핀 컨트롤 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="시작:" FontSize="12" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="-" Click="OnDecreaseStartPageClick" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                        <TextBox x:Name="TxtStartPage" Text="1" Width="36" Height="26" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="2,0" TextChanged="OnStartEndPageChanged"/>
                                        <Button Content="+" Click="OnIncreaseStartPageClick" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                        
                                        <TextBlock Text="~" FontWeight="Bold" FontSize="14" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}"/>

                                        <TextBlock Text="종료:" FontSize="12" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="-" Click="OnDecreaseEndPageClick" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                        <TextBox x:Name="TxtEndPage" Text="1" Width="36" Height="26" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="2,0" TextChanged="OnStartEndPageChanged"/>
                                        <Button Content="+" Click="OnIncreaseEndPageClick" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>

                                        <TextBlock x:Name="TxtRangeSummary" Text="(총 1페이지)" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 2) 직접 다중 구간 입력란 (예: 1~3, 5) -->
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock Text="직접 입력:" FontSize="11" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtCustomRange" Text="1-1" Height="26" FontSize="12" VerticalContentAlignment="Center" Padding="4,0" ToolTip="예: 1-3, 5 또는 1~3, 5" TextChanged="OnCustomRangeTextChanged"/>
                                    </DockPanel>
                                    <TextBlock Text="※ 물결(~) 또는 하이픈(-)으로 구간 지정, 콤마(,)로 여러 페이지 구분" FontSize="10.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 인쇄 매수 -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="인쇄 매수:" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="-" Click="OnDecreaseCopiesClick" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="28"/>
                                    <TextBox x:Name="TxtCopies" Text="1" Width="44" Height="28" FontSize="13" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="4,0"/>
                                    <Button Content="+" Click="OnIncreaseCopiesClick" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="28"/>
                                    <TextBlock Text="매" VerticalAlignment="Center" FontSize="12.5" Margin="6,0,0,0" Foreground="{StaticResource TextSubBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: 프린터 대상 선택 -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🖨️ 출력 대상 프린터" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CboPrinters" Height="32" FontSize="12.5" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Action Buttons (안드로이드 스타일) -->
                    <StackPanel>
                        <!-- 1. 프린터로 바로 인쇄 (Direct Print) -->
                        <Button Content="🖨️ 프린터로 바로 인쇄" Click="OnDirectPrintClick" Style="{StaticResource ModernActionBtnStyle}" Background="#2563EB" Margin="0,0,0,8"/>

                        <!-- 2. 현재 페이지를 캔버스로 가져오기 -->
                        <Button Content="📋 현재 페이지를 라벨 캔버스에 추가" Click="OnImportToCanvasClick" Style="{StaticResource ModernActionBtnStyle}" Background="#0D9488" Margin="0,0,0,8"/>

                        <!-- 3. 닫기 -->
                        <Button Content="닫기" Click="OnCloseClick" Style="{StaticResource MiniStepBtnStyle}" Height="34" FontSize="13"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 2. Bottom Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtBottomStatus" Text="준비 완료: 인쇄할 범위를 선택하고 [프린터로 바로 인쇄] 또는 [캔버스에 추가]를 클릭하세요." FontSize="11.5" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Xprinter PDF High-Speed Engine" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
