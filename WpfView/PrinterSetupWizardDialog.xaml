<Window x:Class="BarcodePrint.WpfView.PrinterSetupWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="프린터 검색 및 연결 - LabelMaster"
        Width="640" Height="620" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic"
        Background="#F8FAFC"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="#64748B"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Body Content -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Nav -->
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- 0. Header (TSPL 전용 안내 배지 강조) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel LastChildFill="True">
                <!-- 우측 상단 TSPL 전용 강조 뱃지 -->
                <Border DockPanel.Dock="Right" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1.2" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="TSPL 지원 프린터 전용" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 좌측 타이틀 -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Background="#2563EB" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="🖨️ 연결" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                        </Border>
                        <TextBlock Text="프린터 검색 및 연결" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource TextMainBrush}"/>
                    </StackPanel>
                    <TextBlock Text="PC에 연결된 라벨 프린터를 검색하고 인쇄에 사용할 기기를 연결합니다." FontSize="11.5" Foreground="{StaticResource TextSubBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Content Area (ScrollViewer로 감싸 배율/해상도에 따른 텍스트 잘림 방지) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,16">

                <!-- 📢 최상단: TSPL 프린터 전용 필수 안내 배너 (강력 강조) -->
                <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <DockPanel LastChildFill="True">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="📢" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" LineHeight="17">
                            <Bold Foreground="#B45309">※ 필수 안내:</Bold> 본 프로그램은 <Bold Foreground="#DC2626">TSPL 명령어 지원 라벨 프린터(Xprinter 등)</Bold>에서만 인쇄 및 센서 제어가 정상 동작합니다.
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- 프린터 선택 카드 -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🖨️ 사용할 라벨 프린터 선택" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="🔄 새로고침" Click="OnRefreshPrintersClick" DockPanel.Dock="Right" Width="90" Height="36" Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" FontSize="12" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Margin="8,0,0,0"/>
                            <ComboBox x:Name="CboPrinters" Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" SelectionChanged="OnPrinterSelectionChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtPrinterNotice" Text="※ 실제 켜져 있고 연결된 온라인 라벨 프린터만 감지하여 표시합니다." FontSize="11.5" Foreground="#059669" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 선택된 프린터 세부 연결 상태 카드 -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="연결 세부 정보 및 하드웨어 진단" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSelectedPrinterPort" Text="포트: 확인 중..." FontSize="12" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtSelectedPrinterStatus" Text="상태: 🟢 정상 온라인 (Ready)" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="0,3,0,10"/>

                        <!-- 안드로이드 표준 TSPL 유지보수 제어 버튼 그룹 -->
                        <TextBlock Text="프린터 동작 테스트 &amp; 하드웨어 정보 (TSPL):" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSubBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 피드 -> 연결테스트 -->
                            <Button Grid.Column="0" Content="📄 연결테스트" Click="OnQuickTestFeedClick" Padding="0,6" Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" ToolTip="라벨 1장 급지(피드) 및 통신 연결 상태 테스트"/>
                            <!-- 센서측정 -> 용지센싱 -->
                            <Button Grid.Column="2" Content="🎯 용지센싱" Click="OnQuickCalibrateClick" Padding="0,6" Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" ToolTip="TSPL GAP/BLINE 용지 센서 자동 감지 측정"/>
                            <!-- 셀프 테스트 유지 -->
                            <Button Grid.Column="4" Content="🖨️ 셀프 테스트" Click="OnQuickSelfTestClick" Padding="0,6" Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" ToolTip="프린터 자체 하드웨어 상태 진단 인쇄"/>
                            <!-- 스펙조회 -> 정보조회 -->
                            <Button Grid.Column="6" Content="ℹ️ 정보조회" Click="OnQuickPrinterInfoClick" Padding="0,6" Background="#F8FAFC" Foreground="#334155" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" ToolTip="실시간 펌웨어, 해상도, 시리얼 등 상세 정보 조회"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 안내 배너 -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="💡 연결 팁:" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" Margin="0,0,0,4"/>
                        <TextBlock Text="• 프린터 전원이 켜져 있고 USB 또는 LAN 케이블이 연결되어 있어야 합니다." FontSize="11.5" Foreground="#1E3A8A" Margin="0,1"/>
                        <TextBlock Text="• 원하는 프린터를 선택한 후 아래 [🖨️ 프린터 연결] 버튼을 누르면 즉시 연결됩니다." FontSize="11.5" Foreground="#1E3A8A" Margin="0,1"/>
                        <TextBlock Text="• 용지 규격이 바뀌거나 위치가 맞지 않을 때는 [용지센싱]을 실행해 주세요." FontSize="11.5" Foreground="#1E3A8A" Margin="0,1"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Bottom Nav -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Click="OnCancelClick" Width="80" Height="38" Background="Transparent" Foreground="#64748B" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button x:Name="BtnConnect" Content="🖨️ 프린터 연결" Click="OnConnectClick" MinWidth="130" Width="Auto" Height="38" Padding="18,0" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13.5" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
