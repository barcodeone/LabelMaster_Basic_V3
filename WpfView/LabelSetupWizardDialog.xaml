<Window x:Class="BarcodePrint.WpfView.LabelSetupWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="새 라벨 만들기 마법사 - LabelMaster"
        Width="720" Height="680" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic"
        Background="#F8FAFC"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="#64748B"/>

        <!-- Preset Card Button Style -->
        <Style x:Key="WizardPresetCardBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection Card Radio Style -->
        <Style x:Key="WizardOptionCardStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Step Plus/Minus Button Style -->
        <Style x:Key="MiniStepBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Header (Step indicator + Progress bar) -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Content Area (Switchable Steps) -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Navigation Bar (Prev / Next / Finish) -->
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <!-- 0. Header with Progress Indicator -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid Margin="22,16,22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                            <Border x:Name="BadgeStep" Background="#2563EB" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtStepBadge" Text="1단계 / 4" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="TxtStepTitle" Text="라벨 규격(사이즈) 선택" FontWeight="ExtraBold" FontSize="17" Foreground="{StaticResource TextMainBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtStepDesc" Text="출력할 라벨의 가로 및 세로 크기(mm)를 입력하세요." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Step Dots & Percent -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStep1" Width="10" Height="10" Fill="#2563EB" Margin="0,0,6,0"/>
                        <Ellipse x:Name="DotStep2" Width="10" Height="10" Fill="#CBD5E1" Margin="0,0,6,0"/>
                        <Ellipse x:Name="DotStep3" Width="10" Height="10" Fill="#CBD5E1" Margin="0,0,6,0"/>
                        <Ellipse x:Name="DotStep4" Width="10" Height="10" Fill="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- 4-Step Animated Progress Gauge Bar -->
                <ProgressBar x:Name="ProgressStepBar" Height="3.5" Minimum="1" Maximum="4" Value="1" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 1. Dynamic Step Content Grid -->
        <Grid Grid.Row="1" Margin="22,16">

            <!-- ============================================== -->
            <!-- STEP 1: 라벨 규격 (Width / Height & Presets)    -->
            <!-- ============================================== -->
            <ScrollViewer x:Name="LayoutStep1" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Custom Input Form + Live Ratio Miniature Preview Box -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left Form Controls -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <!-- Right Live Miniature Preview -->
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Width / Height Controls -->
                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="📏 사용자 지정 규격 직접 입력" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <Button Content="💾 맞춤 규격 저장" Click="OnSaveCustomSizeClick" HorizontalAlignment="Right" Height="28" Padding="10,0" Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" ToolTip="현재 입력한 크기를 아래 맞춤 규격 보관함에 영구 저장합니다."/>
                                </DockPanel>

                                <!-- Width Row -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="가로 너비 (Width)" Width="110" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                                    <Button Content="-" Click="OnWidthMinusClick" Style="{StaticResource MiniStepBtnStyle}"/>
                                    <TextBox x:Name="TxtWidth" Text="80" TextChanged="OnDimensionsChanged" Width="76" Height="36" FontSize="15" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4,0" BorderBrush="#94A3B8" BorderThickness="1.2"/>
                                    <Button Content="+" Click="OnWidthPlusClick" Style="{StaticResource MiniStepBtnStyle}"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#64748B"/>
                                </DockPanel>

                                <!-- Height Row -->
                                <DockPanel>
                                    <TextBlock Text="세로 높이 (Height)" Width="110" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                                    <Button Content="-" Click="OnHeightMinusClick" Style="{StaticResource MiniStepBtnStyle}"/>
                                    <TextBox x:Name="TxtHeight" Text="60" TextChanged="OnDimensionsChanged" Width="76" Height="36" FontSize="15" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4,0" BorderBrush="#94A3B8" BorderThickness="1.2"/>
                                    <Button Content="+" Click="OnHeightPlusClick" Style="{StaticResource MiniStepBtnStyle}"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#64748B"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Right: Live Ratio Miniature Preview Container -->
                            <Border Grid.Column="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="실시간 라벨 비율 프리뷰" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                    <!-- Miniature Container (120x80 max) -->
                                    <Border Grid.Row="1" Width="130" Height="86" Background="#E2E8F0" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid>
                                            <Border x:Name="BorderMiniaturePreview" Width="70" Height="70" Background="White" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Grid Margin="2">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="TxtMiniatureDims" Text="80×60" FontSize="10" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="mm" FontSize="8.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="2" x:Name="TxtMiniatureRatioDesc" Text="1:1 정사각형 라벨" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- User Custom Saved Presets Section -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⭐" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="내가 저장한 맞춤 규격 보관함" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                </StackPanel>
                                <TextBlock Text="※ 규격 클릭시 즉시 적용 / [✕] 삭제" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <WrapPanel x:Name="PanelCustomPresets" Orientation="Horizontal" Margin="0,2,0,0">
                                <!-- 동적 칩 추가 -->
                            </WrapPanel>
                            <TextBlock x:Name="TxtNoCustomPresets" Text="등록된 맞춤 규격이 없습니다. 상단에서 크기를 입력하고 [💾 맞춤 규격 저장]을 누르면 여기에 보관됩니다." FontSize="11" Foreground="#94A3B8" Margin="4,3,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================== -->
            <!-- STEP 2: 용지 종류 (GAP / Black Mark / Continuous) -->
            <!-- ============================================== -->
            <StackPanel x:Name="LayoutStep2" Visibility="Collapsed">
                <!-- 1. 갭 (GAP) 라벨 - 기본값 -->
                <RadioButton x:Name="RbPaperGap" GroupName="PaperType" IsChecked="True" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- GAP 라벨 스티커 2장과 2~3mm 틈(간격)을 시각화한 벡터 아이콘 -->
                        <Border Background="#EFF6FF" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 베이스 롤지 라이너 (하늘색 백킹 테이프) -->
                                    <Border Canvas.Left="4" Canvas.Top="1" Width="24" Height="30" Background="#DBEAFE" CornerRadius="3" BorderBrush="#93C5FD" BorderThickness="0.8"/>
                                    <!-- 첫 번째 라벨 스티커 -->
                                    <Border Canvas.Left="6" Canvas.Top="3" Width="20" Height="10" Background="White" CornerRadius="2" BorderBrush="#2563EB" BorderThickness="1.2">
                                        <Rectangle Width="12" Height="1.5" Fill="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- GAP (2~3mm 간격 표시) -->
                                    <Line X1="3" Y1="14.5" X2="29" Y2="14.5" Stroke="#2563EB" StrokeThickness="0.9" StrokeDashArray="2 1.5"/>
                                    <Polygon Points="3.5,13.5 1.5,14.5 3.5,15.5" Fill="#2563EB"/>
                                    <Polygon Points="28.5,13.5 30.5,14.5 28.5,15.5" Fill="#2563EB"/>
                                    <!-- 두 번째 라벨 스티커 -->
                                    <Border Canvas.Left="6" Canvas.Top="16" Width="20" Height="10" Background="White" CornerRadius="2" BorderBrush="#2563EB" BorderThickness="1.2">
                                        <Rectangle Width="12" Height="1.5" Fill="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="라벨 갭(GAP) 용지" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="가장 널리 쓰이는 표준 용지" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="스티커 라벨 사이에 2~3mm의 투명한 간격(Gap)이 있는 표준 롤 라벨입니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="• 투과 센서(GAP Detect)로 라벨 시작점을 100% 오차 없이 자동 감지합니다." FontSize="11" Foreground="#2563EB" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>

                <!-- 2. 블랙마크 (Black Mark) -->
                <RadioButton x:Name="RbPaperBlackMark" GroupName="PaperType" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- 용지 뒷면 검은색 반사 센서 마크 띠를 시각화한 벡터 아이콘 -->
                        <Border Background="#F1F5F9" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 티켓/라벨지 카드 (흰색 바탕) -->
                                    <Border Canvas.Left="4" Canvas.Top="2" Width="24" Height="28" Background="#FFFFFF" CornerRadius="3" BorderBrush="#64748B" BorderThickness="1.2"/>
                                    <!-- 상단 가상 서식 라인 -->
                                    <Rectangle Canvas.Left="8" Canvas.Top="6" Width="16" Height="2" Fill="#CBD5E1"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="10" Width="10" Height="2" Fill="#E2E8F0"/>
                                    <!-- 뒷면 검은색 반사 마크 스트립 (Black Mark Bar) -->
                                    <Border Canvas.Left="4" Canvas.Top="18" Width="24" Height="7" Background="#0F172A">
                                        <TextBlock Text="MARK" FontSize="4" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- 반사 센서 감지 빔 포인트 -->
                                    <Polygon Points="16,28 14,31 18,31" Fill="#EF4444"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="블랙마크(Black Mark) 용지" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="검은색 반사 마크" FontSize="10.5" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="용지 뒷면에 검은색 인쇄 띠(블랙마크)가 있어 반사 센서로 위치를 감지하는 용지입니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="• 영화 티켓, 입장권, 특수 태그 등에 주로 사용됩니다." FontSize="11" Foreground="#475569" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>

                <!-- 3. 연속 용지 (Continuous) -->
                <RadioButton x:Name="RbPaperContinuous" GroupName="PaperType" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- 원통형 롤러에서 매끄럽게 연속으로 풀려 나오는 일체형 롤지 벡터 아이콘 -->
                        <Border Background="#FEF3C7" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#FDE68A" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 상단 원통형 롤러 코어 -->
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="10" Height="10" Fill="#F59E0B" Stroke="#B45309" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="5" Height="5" Fill="#FEF3C7"/>
                                    <!-- 연속으로 흘러나오는 롤지 띠 -->
                                    <Path Data="M 8,3 L 26,3 A 4,4 0 0 1 30,7 L 30,26 L 10,26 L 10,8 Z" Fill="#FFFFFF" Stroke="#D97706" StrokeThickness="1.2"/>
                                    <!-- 용지 내부 텍스트 라인들 -->
                                    <Rectangle Canvas.Left="13" Canvas.Top="8" Width="13" Height="1.8" Fill="#FDE68A"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="12" Width="11" Height="1.8" Fill="#FDE68A"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="16" Width="14" Height="1.8" Fill="#FDE68A"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="20" Width="8" Height="1.8" Fill="#FDE68A"/>
                                    <!-- 하단 절취선 / 커터 표시 -->
                                    <Line X1="8" Y1="27.5" X2="31" Y2="27.5" Stroke="#B45309" StrokeThickness="1" StrokeDashArray="2 1.5"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="연속(Continuous) 용지" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#FFFBEB" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="틈 없는 일체형 롤지" FontSize="10.5" FontWeight="Bold" Foreground="#D97706"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="간격이나 마크가 없는 일체형 롤지(영수증, 롤 테이프 등)로 소프트웨어에서 길이를 결정합니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="• 지정된 높이(mm)만큼 인쇄한 뒤 커터로 절단하거나 수동으로 절취합니다." FontSize="11" Foreground="#D97706" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>
            </StackPanel>

            <!-- ============================================== -->
            <!-- STEP 3: 인쇄 방향 (Portrait / Landscape)       -->
            <!-- ============================================== -->
            <StackPanel x:Name="LayoutStep3" Visibility="Collapsed">
                <!-- 1. 세로 방향 (Portrait) -->
                <RadioButton x:Name="RbOrientPortrait" GroupName="Orientation" IsChecked="True" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- 세로 직사각형 라벨 문서 + 하향 급지 방향 화살표 벡터 아이콘 -->
                        <Border Background="#EFF6FF" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 세로형 라벨지 -->
                                    <Border Canvas.Left="3" Canvas.Top="2" Width="18" Height="28" Background="#FFFFFF" CornerRadius="2.5" BorderBrush="#2563EB" BorderThickness="1.5">
                                        <Canvas Margin="2">
                                            <!-- 서식 모식도: 텍스트 및 바코드 -->
                                            <Rectangle Canvas.Left="1" Canvas.Top="2" Width="10" Height="2" Fill="#3B82F6"/>
                                            <Rectangle Canvas.Left="1" Canvas.Top="6" Width="12" Height="1.5" Fill="#93C5FD"/>
                                            <!-- 바코드 선 4가닥 -->
                                            <Rectangle Canvas.Left="1" Canvas.Top="10" Width="1.5" Height="6" Fill="#1E3A8A"/>
                                            <Rectangle Canvas.Left="4" Canvas.Top="10" Width="1" Height="6" Fill="#1E3A8A"/>
                                            <Rectangle Canvas.Left="6.5" Canvas.Top="10" Width="2" Height="6" Fill="#1E3A8A"/>
                                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="1.5" Height="6" Fill="#1E3A8A"/>
                                            <Rectangle Canvas.Left="1" Canvas.Top="18" Width="11" Height="1.5" Fill="#93C5FD"/>
                                        </Canvas>
                                    </Border>
                                    <!-- 우측 급지 진행 방향 화살표 (하향 Feed ↓) -->
                                    <Line X1="26" Y1="6" X2="26" Y2="24" Stroke="#2563EB" StrokeThickness="2.2" StrokeEndLineCap="Round"/>
                                    <Polygon Points="26,27 22,21 30,21" Fill="#2563EB"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="세로 방향 (Portrait, 0° 회전)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="기본 표준 방향" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="표준 라벨 방향입니다. 텍스트가 바르게 표시되며 위에서 아래 방향으로 급지됩니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="TxtOrientPortraitDimsDesc" Text="• 크기: 가로 100mm × 세로 100mm" FontSize="11" Foreground="#2563EB" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>

                <!-- 2. 가로 방향 (Landscape) -->
                <RadioButton x:Name="RbOrientLandscape" GroupName="Orientation" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- 가로 직사각형 라벨 문서 + 90도 회전 곡선 화살표 벡터 아이콘 -->
                        <Border Background="#F0FDF4" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#BBF7D0" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 가로형 라벨지 -->
                                    <Border Canvas.Left="2" Canvas.Top="7" Width="26" Height="18" Background="#FFFFFF" CornerRadius="2.5" BorderBrush="#059669" BorderThickness="1.5">
                                        <Canvas Margin="2">
                                            <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="2" Fill="#10B981"/>
                                            <Rectangle Canvas.Left="1" Canvas.Top="6" Width="18" Height="1.5" Fill="#A7F3D0"/>
                                            <!-- 바코드 선들 -->
                                            <Rectangle Canvas.Left="1" Canvas.Top="9" Width="1.5" Height="4" Fill="#065F46"/>
                                            <Rectangle Canvas.Left="4" Canvas.Top="9" Width="1" Height="4" Fill="#065F46"/>
                                            <Rectangle Canvas.Left="6.5" Canvas.Top="9" Width="2" Height="4" Fill="#065F46"/>
                                            <Rectangle Canvas.Left="10" Canvas.Top="9" Width="1.5" Height="4" Fill="#065F46"/>
                                            <Rectangle Canvas.Left="13" Canvas.Top="9" Width="2.5" Height="4" Fill="#065F46"/>
                                        </Canvas>
                                    </Border>
                                    <!-- 상단 90도 시계방향 회전 화살표 ↷ -->
                                    <Path Data="M 10,4 A 8,8 0 0 1 24,6" Stroke="#059669" StrokeThickness="2" Fill="Transparent"/>
                                    <Polygon Points="26,6 23,2 22,7" Fill="#059669"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="가로 방향 (Landscape, 90° 회전)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="90도 회전 급지" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="라벨이 90도 회전되어 인쇄됩니다. 폭이 좁은 프린터에서 넓은 폭의 서식을 인쇄할 때 사용합니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="TxtOrientLandscapeDimsDesc" Text="• 크기: 가로 100mm × 세로 100mm (회전 적용)" FontSize="11" Foreground="#059669" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>
            </StackPanel>

            <!-- ============================================== -->
            <!-- STEP 4: 인쇄 방식 (Direct Thermal vs Ribbon)   -->
            <!-- ============================================== -->
            <StackPanel x:Name="LayoutStep4" Visibility="Collapsed">
                <!-- 1. 감열식 (Direct Thermal) -->
                <RadioButton x:Name="RbMethodDirectThermal" GroupName="PrintMethod" IsChecked="True" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- 서멀 프린트 헤드에서 감열지에 직접 열을 가해 인쇄하는 원리 벡터 그래픽 -->
                        <Border Background="#FEF2F2" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#FECACA" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 프린터 열 헤드 블록 (다크 메탈) -->
                                    <Border Canvas.Left="4" Canvas.Top="3" Width="24" Height="8" Background="#334155" CornerRadius="2">
                                        <TextBlock Text="HEAD" FontSize="4.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- 헤드 발열선 (고열 히팅 엘리먼트 Red/Orange) -->
                                    <Rectangle Canvas.Left="6" Canvas.Top="11" Width="20" Height="2" Fill="#EF4444"/>
                                    <!-- 직접 열기 전도 표시 (열파선) -->
                                    <Path Data="M 8,14 Q 9,15.5 8,17 M 13,14 Q 14,15.5 13,17 M 18,14 Q 19,15.5 18,17 M 23,14 Q 24,15.5 23,17" Stroke="#F97316" StrokeThickness="1.2"/>
                                    <!-- 감열 용지 (헤드 아래를 통과하면서 열로 인해 즉시 검게 인쇄됨) -->
                                    <Border Canvas.Left="3" Canvas.Top="18" Width="26" Height="11" Background="#FFFFFF" CornerRadius="1.5" BorderBrush="#DC2626" BorderThickness="1">
                                        <Canvas Margin="1">
                                            <!-- 열로 검게 반응하여 나타난 텍스트/바코드 라인 -->
                                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="18" Height="2" Fill="#0F172A"/>
                                            <Rectangle Canvas.Left="2" Canvas.Top="5" Width="12" Height="1.5" Fill="#0F172A"/>
                                        </Canvas>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="감열식 (Direct Thermal - 리본 없음, 기본값)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="먹지 불필요" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="잉크 리본(먹지) 없이 열에 반응하는 감열지에 헤드가 직접 열을 가해 인쇄합니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="• 대표 사용처: 쇼핑몰 택배 송장, 배송 라벨, 식품 표기 라벨, 영수증" FontSize="11" Foreground="#059669" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>

                <!-- 2. 열전사 (Thermal Transfer) -->
                <RadioButton x:Name="RbMethodThermalTransfer" GroupName="PrintMethod" Style="{StaticResource WizardOptionCardStyle}">
                    <DockPanel>
                        <!-- 양쪽 롤러 사이에 잉크 리본(먹지)이 걸려 전사 인쇄되는 메커니즘 벡터 아이콘 -->
                        <Border Background="#FAF5FF" Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="#E9D5FF" BorderThickness="1">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="32" Height="32">
                                    <!-- 공급 롤러 (좌측 잉크 리본 스풀) -->
                                    <Ellipse Canvas.Left="2" Canvas.Top="4" Width="9" Height="9" Fill="#6B21A8" Stroke="#4C1D95" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="4.5" Canvas.Top="6.5" Width="4" Height="4" Fill="#FAF5FF"/>
                                    <!-- 권취 롤러 (우측 잉크 리본 스풀) -->
                                    <Ellipse Canvas.Left="21" Canvas.Top="4" Width="9" Height="9" Fill="#6B21A8" Stroke="#4C1D95" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="23.5" Canvas.Top="6.5" Width="4" Height="4" Fill="#FAF5FF"/>
                                    <!-- 두 롤러를 가로지르는 검정 잉크 리본 띠 (Ribbon Web) -->
                                    <Path Data="M 6.5,12 C 9,15 13,15 16,15 C 19,15 23,15 25.5,12" Stroke="#1E1B4B" StrokeThickness="3.2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                                    <TextBlock Canvas.Left="8" Canvas.Top="1" Text="RIBBON" FontSize="4" FontWeight="Bold" Foreground="#7C3AED"/>
                                    <!-- 하단 아트지/유포지 라벨 용지 (흰색) -->
                                    <Border Canvas.Left="3" Canvas.Top="18" Width="26" Height="11" Background="#FFFFFF" CornerRadius="1.5" BorderBrush="#7C3AED" BorderThickness="1">
                                        <Canvas Margin="1">
                                            <!-- 리본을 통해 전사된 선명한 영구 인쇄 라인 -->
                                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="18" Height="2" Fill="#1E1B4B"/>
                                            <Rectangle Canvas.Left="2" Canvas.Top="5.5" Width="13" Height="1.5" Fill="#1E1B4B"/>
                                        </Canvas>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="열전사 (Thermal Transfer - 잉크 리본 사용)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <Border Background="#FAF5FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="영구 보존 인쇄" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="검정 잉크 리본(먹지)을 장착하여 유포지, 은무데드롱지, 아트지에 열로 전사 인쇄합니다." FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="• 대표 사용처: 전자부품 스티커, 자산 관리 표, 화학/옥외 방수 라벨" FontSize="11" Foreground="#7C3AED" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- 2. Bottom Navigation Buttons -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <DockPanel>
                <Button x:Name="BtnPrev" Content="◀ 이전 단계" Click="OnPrevClick" Width="110" Height="40" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Click="OnCancelClick" Width="80" Height="40" Background="Transparent" Foreground="#64748B" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button x:Name="BtnQuickFinish" Content="완료 ✔" Click="OnFinishClick" Height="40" Padding="18,0" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="이후 단계는 기본값으로 즉시 새 문서를 생성합니다.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#15803D"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#166534"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnNext" Content="다음 단계 ▶" Click="OnNextClick" MinWidth="120" Width="Auto" Height="40" Padding="18,0" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13.5" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
