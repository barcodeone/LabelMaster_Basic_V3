<Window x:Class="BarcodePrint.WpfView.ExcelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📊 엑셀 컬럼 매핑 (라벨 항목 1~8)" Height="600" Width="680" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="📑 엑셀 데이터 가져오기 &amp; 컬럼 매핑" FontSize="14.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="라벨의 각 항목(항목 1~8)에 출력할 엑셀 컬럼을 콤보박스에서 선택해주세요." FontSize="11.5" Foreground="#3B82F6" Margin="0,3,0,0"/>

                <!-- 선택된 요소 전용 배너 (SingleElementMode 시 활성화) -->
                <Border x:Name="PnlTargetElementBanner" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock Text="🎯 대상 요소: " FontWeight="Bold" FontSize="11.5" Foreground="#92400E" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTargetElementInfo" Text="[텍스트] 상품명" FontWeight="Bold" FontSize="11.5" Foreground="#B45309" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 1. Sheet Selector -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="📑 워크시트(탭) 선택:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,10,0"/>
                <ComboBox x:Name="CboSheets" Height="30" FontSize="12.5" SelectionChanged="OnSheetSelectionChanged" VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 2. Column Mapping List -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                    <StackPanel x:Name="PnlBatchButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⭐ 마지막 매핑 적용" Click="OnApplyLastMappingClick" Style="{StaticResource SecondaryButtonStyle}" Background="#FEF3C7" Foreground="#B45309" FontWeight="Bold" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="이전에 가져왔던 엑셀 컬럼명/인덱스 매핑 정보를 그대로 다시 적용합니다."/>
                        <Button Content="🔄 순차 매핑" Click="OnAutoSequentialMapping" Style="{StaticResource SecondaryButtonStyle}" Background="#E0F2FE" Foreground="#0369A1" FontWeight="Bold" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="엑셀의 1~8번 열을 항목 1~8에 순서대로 자동 매핑합니다."/>
                        <Button Content="전체 미사용" Click="OnClearAllMappings" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" ToolTip="모든 항목을 [미사용]으로 초기화합니다."/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSlotsTitle" Text="📋 항목별 엑셀 컬럼 지정 (1~8)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LstMappingSlots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <DockPanel LastChildFill="True">
                                        <!-- 항목 번호 배지 -->
                                        <Border DockPanel.Dock="Left" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,4" Width="72" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TargetItemLabel}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 개별 클리어 버튼 -->
                                        <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding}" Click="OnClearSingleSlot" Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="28" Padding="0" Margin="6,0,0,0" ToolTip="해당 항목을 [미사용]으로 설정"/>

                                        <!-- 엑셀 컬럼 선택 콤보박스 -->
                                        <ComboBox ItemsSource="{Binding AvailableOptions}" SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayText" Height="30" FontSize="12.5" FontWeight="SemiBold" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" SelectionChanged="OnSlotSelectionChanged"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Bottom Action Buttons & Options -->
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock x:Name="TxtSelectedCount" Text="매핑된 컬럼: 0개 / 최대 8개" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                <CheckBox x:Name="ChkRememberMapping" Content="엑셀 불러올 때 마지막 매핑 정보 기억 및 자동 적용" IsChecked="True" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,0" ToolTip="체크 시 다음번에 엑셀 파일을 불러올 때 마지막으로 사용했던 컬럼 매핑을 자동으로 찾아 지정합니다."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="❌ 취소" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}" Height="34" Width="80" Margin="0,0,8,0"/>
                <Button x:Name="BtnConfirm" Content="✔️ 데이터 가져오기" Click="OnConfirmClick" Style="{StaticResource ModernButtonStyle}" Height="34" Width="140"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
