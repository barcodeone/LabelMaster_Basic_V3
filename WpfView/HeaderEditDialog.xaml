<Window x:Class="BarcodePrint.WpfView.HeaderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✏️ 컬럼 헤더명 변경" Height="210" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtPrompt" Text="컬럼의 새 헤더명을 입력해주세요:" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="TxtInput" Height="34" FontSize="13.5" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#94A3B8" BorderThickness="1.2" Margin="0,0,0,14" KeyDown="TxtInput_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Click="Cancel_Click" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="12.5" Height="32" Width="70" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="확인" Click="Ok_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12.5" Height="32" Width="80" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
