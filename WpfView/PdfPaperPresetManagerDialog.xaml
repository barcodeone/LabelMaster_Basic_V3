<Window x:Class="BarcodePrint.WpfView.PdfPaperPresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="라벨 용지 규격 관리" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="DialogBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Input Area -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="자주 사용하는 라벨 용지 규격 관리" FontWeight="Bold" FontSize="14.5" Foreground="#1E293B"/>
                    <TextBlock Text="PDF 인쇄 시 빠르게 선택할 수 있는 용지 규격 프리셋을 관리합니다." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List & Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- Preset List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4">
                <ListBox x:Name="LstPresets" BorderThickness="0" Background="Transparent" SelectionChanged="OnPresetSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,3">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Width="100"/>
                                <TextBlock Text="{Binding DisplayDim}" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Side Action Buttons -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button Content="➕ 추가" Click="OnAddClick" Style="{StaticResource DialogBtnStyle}" Background="#EFF6FF" BorderBrush="#93C5FD" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                <Button Content="✏️ 수정" Click="OnEditClick" Style="{StaticResource DialogBtnStyle}" Margin="0,0,0,6"/>
                <Button Content="🗑️ 삭제" Click="OnDeleteClick" Style="{StaticResource DialogBtnStyle}" Margin="0,0,0,6"/>
                <Separator Background="#E2E8F0" Margin="0,4,0,8"/>
                <Button Content="🔄 기본값 복원" Click="OnResetDefaultsClick" Style="{StaticResource DialogBtnStyle}" FontSize="11" Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- Edit / Input Box -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="규격 이름:" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtInputName" Height="26" FontSize="12" VerticalContentAlignment="Center" Padding="4,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="3,0">
                    <TextBlock Text="너비(W mm):" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtInputWidth" Height="26" FontSize="12" VerticalContentAlignment="Center" TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                    <TextBlock Text="높이(H mm):" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtInputHeight" Height="26" FontSize="12" VerticalContentAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="※ 변경 사항은 [저장 및 적용] 시 즉시 반영됩니다." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="저장 및 적용" Click="OnSaveClick" Style="{StaticResource DialogBtnStyle}" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,6,0" Width="90"/>
                <Button Content="취소" Click="OnCancelClick" Style="{StaticResource DialogBtnStyle}" Width="60"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
