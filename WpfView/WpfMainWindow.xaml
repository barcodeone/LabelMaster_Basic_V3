                                                <TextBlock Text=" (₩)" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" Visibility="{Binding IsColumn7PriceFormat, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text=" [바코드]" Foreground="#EA580C" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" Visibility="{Binding IsColumn7Barcode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
