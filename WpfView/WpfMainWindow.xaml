<Window x:Class="BarcodePrint.WpfView.WpfMainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BarcodePrint.ViewModel"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="820" Width="1260"
        MinHeight="760" MinWidth="1120"
        WindowStartupLocation="Manual"
        Background="#F1F5F9"
        FontFamily="Pretendard, 맑은 고딕, Malgun Gothic, Segoe UI, sans-serif"
        FontSize="13"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="HeaderSecondaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="ExcelButtonBrush" Color="#059669"/>
        <SolidColorBrush x:Key="ExcelButtonHoverBrush" Color="#047857"/>

        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                                <Setter Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Utility Button Style (Slate Grey) -->
        <Style x:Key="ActionUtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Excel Button Style -->
        <Style x:Key="ExcelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ExcelButtonBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ExcelButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Alignment Toolbar Button Style (미니멀 그레이) -->
        <Style x:Key="ModernAlignBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid Picker Item Button Style (도형/선 팝업 표 선택용) -->
        <Style x:Key="GridPickerItemBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Margin" Value="2.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tone-on-tone Tool Element Button Style -->
        <Style x:Key="ModernElementChipBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac & Android Style Studio Tool Palette Card Button -->
        <Style x:Key="ModernPaletteCardBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Header Bar Action Button Style (다크 헤더 전용) -->
        <Style x:Key="ModernHeaderBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Center Segmented Item Button Style -->
        <Style x:Key="HeaderToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Step & Navigation Button Style (큼직하고 터치하기 좋은 둥근 버튼) -->
        <Style x:Key="MiniStepBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Connection Type Filter RadioButton Style (세그먼트 칩 형태) -->
        <Style x:Key="ConnectionFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ToggleButton Style (for Bold, Italic) -->
        <Style x:Key="ModernToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mobile-Style CheckBox -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="chkBorder" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="4">
                                    <Path x:Name="chkCheckMark" Data="M 3 8 L 7 12 L 13 4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="chkCheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Splitter Style -->
        <Style x:Key="ModernSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="Grip" Background="#CBD5E1" CornerRadius="2" Margin="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <ControlTemplate x:Key="ModernComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="true">
                <Border x:Name="splitBorder" Width="20" HorizontalAlignment="Right" SnapsToDevicePixels="true">
                    <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#64748B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="7,3,20,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="6" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" Padding="2" Margin="0,3,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Direction="270" Opacity="0.18" RenderingBias="Performance" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ModernComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="CenterAlignTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CenterAlignEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style x:Key="CustomDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="더블클릭: 헤더명 변경 | 우클릭: 메뉴 열기"/>
        </Style>

        <!-- Modern Card Expander Style -->
        <Style x:Key="ModernCardExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBorder" Background="#F1F5F9" CornerRadius="7,7,0,0" Padding="12,9">
                                                <DockPanel>
                                                    <Path x:Name="Arrow"
                                                          DockPanel.Dock="Right"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#475569"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <Border x:Name="ContentSite"
                                        DockPanel.Dock="Bottom"
                                        Visibility="Collapsed"
                                        Padding="12,10"
                                        Background="White"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="HeaderSite" Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBorder" Background="#F1F5F9" CornerRadius="7" Padding="12,9">
                                                <DockPanel>
                                                    <Path x:Name="Arrow"
                                                          DockPanel.Dock="Right"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#475569"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 0. Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Smart 3-Mode Work Tabs -->
            <RowDefinition Height="*"/>
            <!-- 2. Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar (Mac Catalyst Studio 1:1 완벽 정렬 화이트 모던 툴바) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 좌측: < 대시보드 + 🏷️ 규격 뱃지 버튼 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 중앙: 빠른 액션 도구 (실행취소, 재실행, 복사, 회전, 전체선택, 삭제) + 줌 도구 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 우측: 저장, 열기, 프린터 모니터링, 설정, 인쇄 CTA -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1) 좌측: [< 대시보드] -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnGoHomeClick" Style="{StaticResource ModernHeaderBtnStyle}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" Height="34" Padding="12,0" Margin="0" Cursor="Hand" ToolTip="초기 메인 화면(대시보드)으로 돌아갑니다">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="‹" FontSize="16" FontWeight="Bold" Margin="0,-2,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="대시보드" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 2) 중앙: 회전, 위치 초기화, 현재 상태 (세련된 세그먼트 카드 툴바) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="8" Padding="4,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 90도 회전 -->
                        <Button Command="{Binding Rotate90Command}" Style="{StaticResource HeaderToolbarBtnStyle}" ToolTip="라벨 전체 90도 회전 (0°/90°/180°/270°)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LabelRotationText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 위치 초기화 -->
                        <Button Command="{Binding ResetLayoutCommand}" Style="{StaticResource HeaderToolbarBtnStyle}" ToolTip="기본 위치로 정렬 초기화">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↺" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="위치 초기화" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#CBD5E1" Width="1" Height="16" Margin="4,0,8,0" VerticalAlignment="Center"/>

                        <!-- 1:1 실시간 프린터 상태 안내 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                            <TextBlock Text="상태" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrinterStatusBadge}" Foreground="{Binding PrinterStatusColor}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3) 우측: 저장, 열기, 프린터 모니터링, 설정, 인쇄 CTA -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 서식 저장 -->
                    <Button Command="{Binding ExportTemplateCommand}" Style="{StaticResource ModernHeaderBtnStyle}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" Height="34" ToolTip="현재 라벨 디자인을 템플릿(*.lbm)으로 저장">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💾" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="저장" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 서식 열기 -->
                    <Button Command="{Binding ImportTemplateCommand}" Style="{StaticResource ModernHeaderBtnStyle}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" Height="34" ToolTip="저장된 서식(*.lbm) 불러오기">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="열기" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 📊 엑셀 연동 -->
                    <Button Command="{Binding ImportFromExcelCommand}" Style="{StaticResource ModernHeaderBtnStyle}" Background="#ECFDF5" BorderBrush="#A7F3D0" Foreground="#047857" Height="34" ToolTip="엑셀 파일(*.xlsx)을 불러와 라벨 요소들과 연결합니다">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="엑셀 연동" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 프린터 선택 콤보박스 및 상태 -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="2,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖨️ " FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Width="145" Height="26" ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinterName}" VerticalContentAlignment="Center" FontSize="12" BorderThickness="0" Background="Transparent"/>
                            <Button Content="🔄" Command="{Binding RefreshPrintersCommand}" Margin="4,0,0,0" Padding="6,0" Height="24" Background="#E2E8F0" BorderThickness="0" ToolTip="프린터 새로고침" Style="{StaticResource ModernButtonStyle}" Foreground="#475569" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- 프린터 설정 -->
                    <Button Command="{Binding OpenPrinterSettingsCommand}" Style="{StaticResource ModernHeaderBtnStyle}" Background="#F8FAFC" BorderBrush="#BFDBFE" Foreground="#1D4ED8" Height="34" ToolTip="프린터 하드웨어 설정창 열기 (농도, 속도, 용지 규격, 센서)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="설정" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 🖨️ 라벨 인쇄 (Mac Studio 일치 Primary 대형 버튼) -->
                    <Button Command="{Binding PrintCommand}" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" Height="36" Width="110" Padding="0" Margin="4,0,0,0" ToolTip="라벨 인쇄 시작">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="라벨 인쇄" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Workspace Grid (Left: Tool Palette, Center: WYSIWYG Canvas, Right: Inspector & Tabs) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 0. 좌측 요소 도구 팔레트 (Mac & Android Studio 스타일 92px) -->
                <ColumnDefinition Width="92" MinWidth="70" MaxWidth="140"/>
                <!-- 1. 중앙 광활한 위즈윅 캔버스 워크스페이스 -->
                <ColumnDefinition Width="*" MinWidth="150"/>
                <!-- 2. 스플리터 -->
                <ColumnDefinition Width="6"/>
                <!-- 3. 우측 모던 속성 인스펙터 & 작업 패널 (자유로운 비율 조절 지원) -->
                <ColumnDefinition Width="380" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- [COLUMN 0] 좌측 요소 도구 팔레트 (Left Sidebar Palette)     -->
            <!-- ========================================================== -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="7,10" Margin="0,0,8,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="도구 팔레트" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <!-- 1. 텍스트 -->
                        <Button Command="{Binding AddTextElementCommand}" ToolTip="새 텍스트 항목 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="가나다" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="텍스트" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. 바코드 -->
                        <Button Command="{Binding AddBarcodeElementCommand}" ToolTip="새 1D 바코드 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="22" Height="22">
                                        <!-- 1D 세로 줄무늬 바코드 스트라이프 -->
                                        <Line X1="2" Y1="3" X2="2" Y2="19" Stroke="#1E293B" StrokeThickness="1.8"/>
                                        <Line X1="5.5" Y1="3" X2="5.5" Y2="19" Stroke="#1E293B" StrokeThickness="1.2"/>
                                        <Line X1="8.5" Y1="3" X2="8.5" Y2="19" Stroke="#1E293B" StrokeThickness="2.5"/>
                                        <Line X1="12" Y1="3" X2="12" Y2="19" Stroke="#1E293B" StrokeThickness="1.2"/>
                                        <Line X1="14.5" Y1="3" X2="14.5" Y2="19" Stroke="#1E293B" StrokeThickness="2.2"/>
                                        <Line X1="17.5" Y1="3" X2="17.5" Y2="19" Stroke="#1E293B" StrokeThickness="1"/>
                                        <Line X1="20" Y1="3" X2="20" Y2="19" Stroke="#1E293B" StrokeThickness="1.8"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="바코드" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. QR코드 -->
                        <Button Command="{Binding AddQrElementCommand}" ToolTip="새 2D QR코드 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="22" Height="22">
                                        <!-- 2D 정방형 QR코드 매트릭스 패턴 -->
                                        <!-- 좌상단 파인더 패턴 -->
                                        <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="7" Height="7" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Rectangle Canvas.Left="3.5" Canvas.Top="3.5" Width="3" Height="3" Fill="#1E293B"/>
                                        <!-- 우상단 파인더 패턴 -->
                                        <Rectangle Canvas.Left="13.5" Canvas.Top="1.5" Width="7" Height="7" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Rectangle Canvas.Left="15.5" Canvas.Top="3.5" Width="3" Height="3" Fill="#1E293B"/>
                                        <!-- 좌하단 파인더 패턴 -->
                                        <Rectangle Canvas.Left="1.5" Canvas.Top="13.5" Width="7" Height="7" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Rectangle Canvas.Left="3.5" Canvas.Top="15.5" Width="3" Height="3" Fill="#1E293B"/>
                                        <!-- 데이터 모듈 도트들 -->
                                        <Rectangle Canvas.Left="10.5" Canvas.Top="2" Width="1.5" Height="6" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="2" Canvas.Top="10.5" Width="6" Height="1.5" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="13.5" Canvas.Top="10.5" Width="2" Height="2" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="17.5" Canvas.Top="10.5" Width="3" Height="2" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="10.5" Canvas.Top="13.5" Width="2" Height="2" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="14" Canvas.Top="14" Width="2.5" Height="2.5" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="14" Width="2.5" Height="6.5" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="10.5" Canvas.Top="17.5" Width="6" Height="3" Fill="#1E293B"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="QR코드" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. 표 -->
                        <Button Command="{Binding AddTableElementCommand}" ToolTip="표(Table) 서식 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="22" Height="22">
                                        <!-- 표(Table) 격자 그리드 -->
                                        <!-- 외곽 테두리 -->
                                        <Border Canvas.Left="2" Canvas.Top="2.5" Width="18" Height="17" BorderBrush="#1E293B" BorderThickness="1.6" CornerRadius="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="5.5"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 헤더 행 하이라이트 배경 -->
                                                <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#DBEAFE"/>
                                                <!-- 가로 구분선들 -->
                                                <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Height="1" Fill="#1E293B" VerticalAlignment="Bottom"/>
                                                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" Fill="#94A3B8" VerticalAlignment="Bottom"/>
                                                <!-- 세로 구분선들 -->
                                                <Rectangle Grid.RowSpan="3" Grid.Column="0" Width="1" Fill="#94A3B8" HorizontalAlignment="Right"/>
                                                <Rectangle Grid.RowSpan="3" Grid.Column="1" Width="1" Fill="#94A3B8" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="표" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. 도형 (17종 다채로운 모양 선택 지원 - 5열 표/그리드 팝업) -->
                        <Grid>
                            <Button x:Name="BtnAddShape" Click="OnAddShapeClick" ToolTip="원하는 모양의 도형 선택 및 추가 (17종)" Style="{StaticResource ModernPaletteCardBtnStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="22" Height="22">
                                        <Canvas Width="22" Height="22">
                                            <!-- 라운드 사각형 도형 및 원형 겹침 -->
                                            <Border Canvas.Left="2.5" Canvas.Top="2.5" Width="17" Height="17" BorderBrush="#1E293B" BorderThickness="1.8" CornerRadius="3" Background="#F8FAFC"/>
                                            <Rectangle Canvas.Left="6" Canvas.Top="6" Width="10" Height="10" Stroke="#2563EB" StrokeThickness="1.2" StrokeDashArray="2 1.5"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="도형" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="▾" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- 도형 선택 팝업창 (5열 표/배열 형태) -->
                            <Popup x:Name="PopupAddShape" 
                                   PlacementTarget="{Binding ElementName=BtnAddShape}" 
                                   Placement="Bottom" 
                                   StaysOpen="False" 
                                   AllowsTransparency="True" 
                                   PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="10" Padding="12" Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
                                    </Border.Effect>
                                    <StackPanel Width="360">
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📐 도형 선택 (17종)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button Content="✕" Click="OnCloseShapePopupClick" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="20" HorizontalAlignment="Right" Padding="0" FontSize="11" ToolTip="닫기"/>
                                        </DockPanel>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
                                            <ItemsControl ItemsSource="{Binding AvailableShapeTypes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="5"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddShapeElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Code}"
                                                                Click="OnShapePickBtnClick"
                                                                Style="{StaticResource GridPickerItemBtnStyle}"
                                                                Height="54"
                                                                ToolTip="{Binding DisplayText}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="58"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- 7. 구분선 (7종 다채로운 스타일 선택 지원 - 4열 표/그리드 팝업) -->
                        <Grid>
                            <Button x:Name="BtnAddLine" Click="OnAddLineClick" ToolTip="원하는 스타일의 구분선 선택 및 추가 (7종)" Style="{StaticResource ModernPaletteCardBtnStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="22" Height="22">
                                        <Canvas Width="22" Height="22">
                                            <!-- 수평 구분 실선 및 양 끝 가이드 노드 -->
                                            <Line X1="2" Y1="11" X2="20" Y2="11" Stroke="#1E293B" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse Canvas.Left="1.5" Canvas.Top="9" Width="4" Height="4" Fill="#2563EB"/>
                                            <Ellipse Canvas.Left="16.5" Canvas.Top="9" Width="4" Height="4" Fill="#2563EB"/>
                                            <!-- 위아래 가상 단락 가이드 라인 -->
                                            <Line X1="4" Y1="5" X2="18" Y2="5" Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="2 2"/>
                                            <Line X1="4" Y1="17" X2="18" Y2="17" Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="2 2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="구분선" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="▾" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- 구분선 선택 팝업창 (4열 표/배열 형태) -->
                            <Popup x:Name="PopupAddLine" 
                                   PlacementTarget="{Binding ElementName=BtnAddLine}" 
                                   Placement="Bottom" 
                                   StaysOpen="False" 
                                   AllowsTransparency="True" 
                                   PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="10" Padding="12" Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
                                    </Border.Effect>
                                    <StackPanel Width="340">
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📏 구분선 선택 (7종)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button Content="✕" Click="OnCloseLinePopupClick" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="20" HorizontalAlignment="Right" Padding="0" FontSize="11" ToolTip="닫기"/>
                                        </DockPanel>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
                                            <ItemsControl ItemsSource="{Binding AvailableLineStyles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddLineElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Code}"
                                                                Click="OnLinePickBtnClick"
                                                                Style="{StaticResource GridPickerItemBtnStyle}"
                                                                Height="54"
                                                                ToolTip="{Binding DisplayText}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="70"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- 8. 이미지 -->
                        <Button Command="{Binding AddImageElementCommand}" ToolTip="로고 및 그래픽 이미지 파일 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="22" Height="22">
                                        <!-- 이미지 액자 프레임 + 풍경(해와 산) -->
                                        <Border Canvas.Left="2" Canvas.Top="3" Width="18" Height="16" BorderBrush="#1E293B" BorderThickness="1.6" CornerRadius="2.5" Background="#F8FAFC">
                                            <Canvas Margin="1">
                                                <!-- 해(태양) -->
                                                <Ellipse Canvas.Left="10.5" Canvas.Top="2" Width="3.5" Height="3.5" Fill="#F59E0B"/>
                                                <!-- 산봉우리 2개 -->
                                                <Polygon Points="1,12 5,6 9,12" Fill="#059669"/>
                                                <Polygon Points="6,12 11,4 15,12" Fill="#10B981"/>
                                            </Canvas>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="이미지" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 9. PDF 불러오기 -->
                        <Button Command="{Binding ImportPdfCommand}" ToolTip="PDF 송장 문서 규격에 맞춰 불러오기" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="22" Height="22">
                                        <!-- 접힌 모서리가 있는 문서 + PDF 라벨 배지 -->
                                        <Path Data="M 4,2 L 13,2 L 18,7 L 18,20 L 4,20 Z" Fill="#FFFFFF" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Path Data="M 13,2 L 13,7 L 18,7" Fill="#E2E8F0" Stroke="#1E293B" StrokeThickness="1.2"/>
                                        <!-- PDF 붉은색 뱃지 -->
                                        <Border Canvas.Left="3" Canvas.Top="11" Width="14" Height="7" Background="#DC2626" CornerRadius="1.5">
                                            <TextBlock Text="PDF" FontSize="5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="PDF" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 9. 일시 (날짜/시간) -->
                        <Button Command="{Binding AddDateTimeElementCommand}" ToolTip="현재 날짜/시간 스탬프 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="22" Height="22">
                                        <!-- 아날로그 시계 외곽 링 및 바늘 -->
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="18" Height="18" Stroke="#1E293B" StrokeThickness="1.8"/>
                                        <Line X1="11" Y1="11" X2="11" Y2="6" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="11" Y1="11" X2="15.5" Y2="11" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="9.8" Canvas.Top="9.8" Width="2.4" Height="2.4" Fill="#1E293B"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="일시" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================== -->
            <!-- [COLUMN 1] 중앙 광활한 위즈윅 캔버스 워크스페이스          -->
            <!-- ========================================================== -->
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0. 상단 정렬 및 용지 수치 툴바 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1. 캔버스 및 줌 컨트롤러 -->
                        <RowDefinition Height="*"/>
                        <!-- 2. 하단 내비게이터 및 안내문구 -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0. Top Alignment & Canvas Quick Controls Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="8,6" Margin="0,0,0,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <!-- 정렬 도구 버튼 세트 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="정렬:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                
                                <Button Command="{Binding ResetLayoutCommand}" ToolTip="기본 위치로 초기화" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="↺ 초기화" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding AlignLeftCommand}" ToolTip="선택 항목 좌측 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="◀ 좌측" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding AlignCenterCommand}" ToolTip="가로 중앙 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="■ 가로중앙" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding AlignRightCommand}" ToolTip="우측 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="▶ 우측" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding AlignTopCommand}" ToolTip="상단 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="▲ 상단" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding AlignMiddleCommand}" ToolTip="세로 중앙 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="▬ 세로중앙" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding AlignBottomCommand}" ToolTip="하단 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="▼ 하단" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding DistributeVerticalCommand}" ToolTip="세로 등간격 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="세로균등" FontSize="11.5"/>
                                </Button>
                                <Button Command="{Binding DistributeHorizontalCommand}" ToolTip="가로 등간격 정렬" Style="{StaticResource ModernAlignBtnStyle}">
                                    <TextBlock Text="가로균등" FontSize="11.5"/>
                                </Button>
                            </StackPanel>

                            <!-- 우측: 용지 규격 미세 조정 및 회전 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="규격: " VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button Content="-" Command="{Binding DecreasePaperWidthCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="12" FontWeight="Bold"/>
                                <TextBox Text="{Binding PaperWidthStr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="38" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <Button Content="+" Command="{Binding IncreasePaperWidthCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="×" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="2,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button Content="-" Command="{Binding DecreasePaperHeightCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="12" FontWeight="Bold"/>
                                <TextBox Text="{Binding PaperHeightStr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="38" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <Button Content="+" Command="{Binding IncreasePaperHeightCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="mm" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 1. 광활한 캔버스 워크스페이스 + 세로형 줌 컨트롤러 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Canvas Workspace with Top & Left Rulers (안드로이드 스타일 가로/세로 눈금자) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- [0,0] 좌상단 단위 표시 코너 박스 (mm) -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                                <TextBlock Text="mm" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- [0,1] 상단 가로 고정 눈금자 (Top Horizontal Ruler) -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" ClipToBounds="True">
                                <Canvas x:Name="TopRulerCanvas" Height="22"/>
                            </Border>

                            <!-- [1,0] 좌측 세로 고정 눈금자 (Left Vertical Ruler) -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" ClipToBounds="True">
                                <Canvas x:Name="LeftRulerCanvas" Width="22"/>
                            </Border>

                            <!-- [1,1] Canvas ScrollViewer -->
                            <ScrollViewer x:Name="CanvasScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F1F5F9"
                                          ScrollChanged="OnCanvasScrollViewerScrollChanged" SizeChanged="OnCanvasScrollViewerSizeChanged">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                                    <Border BorderBrush="#94A3B8" BorderThickness="1" Background="White" CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.12"/>
                                        </Border.Effect>
                                        <Canvas x:Name="GlobalPreviewCanvas" Width="380" Height="200" Background="White" ClipToBounds="False"
                                                Focusable="True"
                                                MouseLeftButtonDown="OnGlobalCanvasMouseLeftButtonDown"
                                                MouseMove="OnGlobalCanvasMouseMove"
                                                MouseLeftButtonUp="OnGlobalCanvasMouseLeftButtonUp"
                                                MouseWheel="OnGlobalCanvasMouseWheel">
                                        </Canvas>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- 세로형 줌 컨트롤 바 -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,8" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Button Content="➕" Command="{Binding ZoomInCommand}" ToolTip="확대" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="24" Margin="0,0,0,6" Padding="0"/>
                                <Slider Orientation="Vertical" Height="140" Minimum="0.5" Maximum="3.0" Value="{Binding ZoomRatio}" HorizontalAlignment="Center" Margin="0,4"/>
                                <Button Content="➖" Command="{Binding ZoomOutCommand}" ToolTip="축소" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="24" Margin="0,6,0,6" Padding="0"/>
                                <Button Content="1:1" Command="{Binding ResetZoomCommand}" ToolTip="100% 원본 배율" Style="{StaticResource MiniStepBtnStyle}" Width="28" Height="22" Margin="0,0,0,4" Padding="0" FontSize="10.5"/>
                                <TextBlock Text="{Binding ZoomPercentageText}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. Bottom Page Navigator & Drag Notice -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="◀ 이전" Command="{Binding PreviewPreviousPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="56" Height="26" FontSize="11.5" FontWeight="Bold" ToolTip="이전 라벨 (이전 행)"/>
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,2" Margin="8,0">
                                    <TextBlock Text="{Binding PreviewPageText}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                </Border>
                                <Button Content="다음 ▶" Command="{Binding PreviewNextPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="56" Height="26" FontSize="11.5" FontWeight="Bold" ToolTip="다음 라벨 (다음 행)"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtGlobalDragInfo" Text="💡 마우스로 라벨 요소를 클릭하여 선택하거나, 드래그하여 원하는 위치에 자유롭게 배치하세요." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column Splitter -->
            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Style="{StaticResource ModernSplitterStyle}"/>

            <!-- ========================================================== -->
            <!-- [COLUMN 3] 우측 모던 속성 인스펙터 & 작업 모드 탭 (380px)     -->
            <!-- ========================================================== -->
            <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0. 인스펙터 / 탭 타이틀 헤더 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1. 본문 (속성 인스펙터 OR 탭 컨트롤) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 0. 인스펙터 상단 헤더 -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="10,10,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedElementTypeText}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="✕ 선택 해제" Command="{Binding DeselectElementCommand}" Visibility="{Binding HasSelectedElement, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F1F5F9" Foreground="#64748B" FontSize="11" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,3" Cursor="Hand" ToolTip="선택 해제"/>
                        </DockPanel>
                    </Border>

                    <!-- 1. 본문 (HasSelectedElement에 따라 인스펙터 vs 탭 전환) -->
                    <Grid Grid.Row="1">
                        <!-- 1-A. 모던 속성 인스펙터 (요소 선택 시 활성화) -->
                        <ScrollViewer Visibility="{Binding HasSelectedElement, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12">
                                <!-- 1. 내용 (Content) - 텍스트, 바코드, QR코드, 일시 요소일 때만 표시 -->
                                <Border Visibility="{Binding IsSelectedElementContentEditable, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.8" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#2563EB"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✏️ 내용 및 데이터 소스" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                                                <!-- 직접 수정 가능 상태 -->
                                                <Border Background="#DBEAFE" CornerRadius="4" Padding="5,1.5" Margin="6,0,0,0" Visibility="{Binding IsSelectedElementExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="직접 수정" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                                </Border>
                                                <!-- 엑셀 컬럼 연동 상태 (직접 수정 제한) -->
                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1.5" Margin="6,0,0,0" Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🔒 엑셀 연동 (수정 잠금)" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Enter: 줄바꿈" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsSelectedElementExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </DockPanel>

                                        <!-- 엑셀 데이터 컬럼 매핑 드롭다운 & 엑셀 파일 열기 버튼 -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="데이터 소스" Width="68" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="📁 엑셀 열기" Command="{Binding ImportFromExcelForElementCommand}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Foreground="White" Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" ToolTip="엑셀 파일(*.xlsx)을 불러와 선택된 요소에 컬럼을 매핑합니다."/>
                                            <Button DockPanel.Dock="Right" Content="✕ 연동 해제" Command="{Binding UnlinkSelectedElementExcelCommand}" Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White" Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" ToolTip="현재 요소의 엑셀 연동을 즉시 해제하고 직접 입력 모드로 전환합니다."/>
                                            <ComboBox ItemsSource="{Binding AvailableExcelColumnOptions}"
                                                      SelectedValue="{Binding SelectedElementExcelColumn}"
                                                      SelectedValuePath="Code"
                                                      DisplayMemberPath="Name"
                                                      Height="28" FontSize="11.5" VerticalContentAlignment="Center"
                                                      ToolTip="엑셀 파일의 열과 매칭하거나 직접 고정 텍스트를 입력할 수 있습니다."/>
                                        </DockPanel>

                                        <!-- 엑셀 파일 로드 상태 뱃지 (로드된 파일명 표시) -->
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding LoadedExcelFileName, StringFormat='📄 {0}'}" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Records.Count, StringFormat='총 {0}행'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#166534" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- 1. 엑셀 파일이 실제로 로드되어 완벽히 연동되었을 때 (초록색 뱃지) -->
                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,8" Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔗 " FontSize="11"/>
                                                    <TextBlock Text="엑셀 데이터 연동됨 (행 탐색 시 실시간 반영)" FontSize="10.5" Foreground="#047857" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedElementEffectivePreviewText, StringFormat='현재 행 미리보기: {0}'}" FontSize="11" Foreground="#065F46" FontWeight="SemiBold" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. 컬럼을 지정했으나 아직 엑셀 파일을 불러오지 않았을 때 (대기 안내 뱃지) -->
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,8" Visibility="{Binding IsSelectedElementExcelPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <TextBlock Text="💡 " FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedElementExcelColumn, StringFormat='{}{0}열로 매핑 대기 중입니다. [📁 엑셀 열기]로 파일을 불러오세요.'}" FontSize="10.5" Foreground="#1D4ED8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- A. 엑셀 미연동: 자유롭게 직접 편집 가능한 텍스트 상자 -->
                                        <TextBox x:Name="TxtInspectorContent" 
                                                 Visibility="{Binding IsSelectedElementExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Text="{Binding SelectedElementContent, UpdateSourceTrigger=PropertyChanged}" 
                                                 MinHeight="48" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 Padding="10,8" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Background="#FFFFFF" 
                                                 BorderBrush="#2563EB" BorderThickness="2" Style="{StaticResource ModernTextBoxStyle}"
                                                 ToolTip="라벨에 인쇄될 텍스트나 데이터를 직접 입력하세요 (Enter: 줄바꿈)"/>

                                        <!-- B. 엑셀 연동: 텍스트 내용 수정 차단 & 실시간 엑셀 행 미리보기 잠금 표시 -->
                                        <Border Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="10,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="엑셀 연동 중 (직접 수정 불가)" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="데이터 소스를 '(직접 입력)'으로 변경 시 수정 가능" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBox Text="{Binding SelectedElementEffectivePreviewText, Mode=OneWay}" 
                                                         IsReadOnly="True" IsEnabled="False"
                                                         Background="#EDF2F7" Foreground="#334155"
                                                         MinHeight="38" MaxHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                         Padding="8,6" FontSize="13" FontWeight="Bold" BorderThickness="0"
                                                         ToolTip="엑셀 행의 데이터가 라벨에 실시간 반영되고 있습니다."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- C. 인쇄 후 내용 유지(Keep) / 자동 초기화 옵션 -->
                                        <Border Margin="0,8,0,0" Padding="8,6" Background="#F1F5F9" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <CheckBox IsChecked="{Binding SelectedElementIsKeep, Mode=TwoWay}"
                                                      FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"
                                                      ToolTip="체크 시 라벨 인쇄 후에도 이 요소의 텍스트가 지워지지 않고 유지됩니다. 체크 해제 시 인쇄 후 자동으로 초기화되어 다음 입력을 준비합니다.">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📌 인쇄 후 내용 유지 (Keep)" VerticalAlignment="Center"/>
                                                    <TextBlock Text="(해제 시 인쇄 후 자동 초기화)" FontSize="10.5" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 1-1. 일시(DATE_TIME) 전용 서식 및 자동 업데이트 옵션 -->
                                <Border Visibility="{Binding IsSelectedElementDateTime, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#16A34A"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🕒 일시 표시 양식 &amp; 자동 업데이트" FontWeight="Bold" FontSize="13" Foreground="#166534"/>
                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1.5" Margin="6,0,0,0">
                                                    <TextBlock Text="실시간 반영" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 날짜/시간 서식 드롭다운 -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="일시 양식" Width="68" FontSize="11.5" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding DateTimeFormatOptions}"
                                                      SelectedValue="{Binding SelectedElementDateTimeFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Format"
                                                      DisplayMemberPath="DisplayText"
                                                      Height="28" FontSize="11.5" VerticalContentAlignment="Center"
                                                      ToolTip="출력할 날짜/시간의 표시 양식을 선택합니다."/>
                                        </DockPanel>

                                        <!-- 인쇄 시 자동 업데이트 체크박스 -->
                                        <CheckBox IsChecked="{Binding SelectedElementAutoUpdateDate, Mode=TwoWay}" 
                                                  FontSize="12" FontWeight="SemiBold" Foreground="#14532D" Margin="2,4,0,2"
                                                  ToolTip="체크 시 라벨을 인쇄하거나 미리보기 할 때 현재 시각으로 자동 갱신됩니다.">
                                            <TextBlock Text="인쇄 시 현재 날짜/시간으로 자동 업데이트" VerticalAlignment="Center"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- 2. 서식 및 글꼴 (텍스트 및 일시 요소일 때) -->
                                <Border Visibility="{Binding IsSelectedElementText, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🔤 글꼴 및 스타일" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- 글꼴 드롭다운 -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="글꼴" Width="40" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedElementFontName}" Height="28" FontSize="12" VerticalContentAlignment="Center"/>
                                        </DockPanel>

                                        <!-- 글꼴 크기 & 스타일 버튼 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 글꼴 크기 Numeric Up/Down Stepper -->
                                            <DockPanel Grid.Column="0">
                                                <TextBlock Text="크기" Width="36" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepFontSizeCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="28" Margin="0,0,2,0"/>
                                                <Button Content="+" Command="{Binding StepFontSizeCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="28" Margin="2,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="pt" Margin="4,0,4,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding SelectedElementFontSize, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                            </DockPanel>

                                            <!-- 굵게 / 기울임 / 밑줄 토글 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ToggleButton IsChecked="{Binding SelectedElementIsBold}" Width="30" Height="28" Margin="0,0,4,0" Style="{StaticResource ModernToggleBtnStyle}" ToolTip="굵게 (Bold)">
                                                    <TextBlock Text="B" FontWeight="Bold" FontSize="13"/>
                                                </ToggleButton>
                                                <ToggleButton IsChecked="{Binding SelectedElementIsItalic}" Width="30" Height="28" Margin="0,0,4,0" Style="{StaticResource ModernToggleBtnStyle}" ToolTip="기울임 (Italic)">
                                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="13"/>
                                                </ToggleButton>
                                                <ToggleButton IsChecked="{Binding SelectedElementIsUnderline}" Width="30" Height="28" Style="{StaticResource ModernToggleBtnStyle}" ToolTip="밑줄 (Underline)">
                                                    <TextBlock Text="U" TextDecorations="Underline" FontWeight="Bold" FontSize="13"/>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 텍스트 정렬 -->
                                        <DockPanel>
                                            <TextBlock Text="정렬" Width="40" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <UniformGrid Columns="3">
                                                <Button Content="◀ 좌측" Click="OnSelectedAlignLeftClick" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11"/>
                                                <Button Content="■ 중앙" Click="OnSelectedAlignCenterClick" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11"/>
                                                <Button Content="▶ 우측" Click="OnSelectedAlignRightClick" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11"/>
                                            </UniformGrid>
                                        </DockPanel>

                                        <!-- 구분선 -->
                                        <Separator Background="#E2E8F0" Margin="0,10,0,8"/>

                                        <!-- 자간 / 장평 / 줄간격 (글자간격) 정밀 조절 -->
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="📐 글자 간격 및 형태 (고급)" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Command="{Binding ResetTextSpacingCommand}" Content="↺ 초기화" HorizontalAlignment="Right" Padding="6,1" FontSize="10" Foreground="#64748B" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="자간 0.0, 장평 100%, 줄간격 1.0 기본값으로 리셋"/>
                                            </DockPanel>

                                            <!-- 행 1: 자간(글자간격) & 장평 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 자간(글자간격) Stepper -->
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock Text="자간" Width="26" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="-" Command="{Binding StepLetterSpacingCommand}" CommandParameter="-0.05" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="자간 0.05 em 감소"/>
                                                    <Button Content="+" Command="{Binding StepLetterSpacingCommand}" CommandParameter="0.05" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="자간 0.05 em 증가"/>
                                                    <TextBox Text="{Binding SelectedElementLetterSpacing, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="자간 / 글자간격 (em 단위, 기본 0.00)"/>
                                                </DockPanel>
                                                <!-- 장평 Stepper -->
                                                <DockPanel Grid.Column="2">
                                                    <TextBlock Text="장평" Width="26" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="-" Command="{Binding StepFontScaleXCommand}" CommandParameter="-5" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="장평 5% 감소"/>
                                                    <Button Content="+" Command="{Binding StepFontScaleXCommand}" CommandParameter="5" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="장평 5% 증가"/>
                                                    <TextBox Text="{Binding SelectedElementFontScaleX, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="장평 (글자 가로 비율 %, 기본 100%)"/>
                                                </DockPanel>
                                            </Grid>

                                            <!-- 행 2: 줄간격 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 줄간격 Stepper -->
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock Text="줄간격" Width="36" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="-" Command="{Binding StepLineSpacingCommand}" CommandParameter="-0.1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="줄간격 0.1배 감소"/>
                                                    <Button Content="+" Command="{Binding StepLineSpacingCommand}" CommandParameter="0.1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="줄간격 0.1배 증가"/>
                                                    <TextBox Text="{Binding SelectedElementLineSpacing, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.0}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="줄간격 (행간 배수, 기본 1.0배)"/>
                                                </DockPanel>
                                                <!-- 우측 보조 안내 -->
                                                <TextBlock Grid.Column="2" Text="(기본 1.0배 / 장평 100%)" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3. 바코드 규격 설정 (바코드 / QR일 때) -->
                                <Border Visibility="{Binding IsSelectedElementBarcode, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🏷️ 바코드 규격 설정" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="타입" Width="55" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableBarcodeFormats}" SelectedItem="{Binding SelectedElementBarcodeType}" Height="28" FontSize="12" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="값 표시" Width="55" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableBarcodeTextPositions}" 
                                                      SelectedValue="{Binding SelectedElementBarcodeTextPosition}" 
                                                      SelectedValuePath="Code" 
                                                      DisplayMemberPath="Name" 
                                                      Height="28" FontSize="12" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 도형 및 선 설정 (도형 / 선일 때) -->
                                <Border Visibility="{Binding IsSelectedElementShapeOrLine, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📐 도형 / 선 서식" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- 도형일 때: 5열 그리드 배열 형태로 17종 도형 표시 -->
                                        <StackPanel Visibility="{Binding IsSelectedElementShape, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="도형 종류 선택" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <CheckBox Content="도형 내부 채우기 (Fill)" 
                                                              IsChecked="{Binding SelectedElementIsFilled}" 
                                                              Style="{StaticResource ModernCheckBoxStyle}" 
                                                              FontSize="12" 
                                                              Foreground="{StaticResource TextPrimaryBrush}" 
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0"
                                                              ToolTip="도형 내부를 채웁니다."/>
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                                        <TextBlock Text="{Binding SelectedElementShapeName}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3">
                                                <ListBox ItemsSource="{Binding AvailableShapeTypes}" 
                                                         SelectedValue="{Binding SelectedElementShapeType}" 
                                                         SelectedValuePath="Code" 
                                                         Background="Transparent" 
                                                         BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="5"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Margin" Value="2"/>
                                                            <Setter Property="BorderThickness" Value="1.2"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" 
                                                                                Background="{TemplateBinding Background}" 
                                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                                CornerRadius="6" 
                                                                                Padding="2,4"
                                                                                SnapsToDevicePixels="True">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.8"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding DisplayText}">
                                                                <TextBlock Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="54"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- 선일 때: 그리드 배열 형태로 7종 선 스타일 표시 -->
                                        <StackPanel Visibility="{Binding IsSelectedElementLine, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="선 종류 선택" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SelectedElementLineName}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                </Border>
                                            </DockPanel>

                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3">
                                                <ListBox ItemsSource="{Binding AvailableLineStyles}" 
                                                         SelectedValue="{Binding SelectedElementLineStyle}" 
                                                         SelectedValuePath="Code" 
                                                         Background="Transparent" 
                                                         BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="4"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Margin" Value="2"/>
                                                            <Setter Property="BorderThickness" Value="1.2"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" 
                                                                                Background="{TemplateBinding Background}" 
                                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                                CornerRadius="6" 
                                                                                Padding="4,6"
                                                                                SnapsToDevicePixels="True">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.8"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding DisplayText}">
                                                                <TextBlock Text="{Binding Icon}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="68"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- 선 두께 Numeric Up/Down Stepper -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="선 두께" Width="60" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Button Content="-" Command="{Binding StepLineWidthCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26" Margin="0,0,2,0" ToolTip="선 두께 1px 감소"/>
                                            <Button Content="+" Command="{Binding StepLineWidthCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26" Margin="2,0,0,0" ToolTip="선 두께 1px 증가"/>
                                            <TextBlock DockPanel.Dock="Right" Text="px" Margin="4,0,4,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding SelectedElementLineWidth, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 5. 표(Table) 전용 설정 및 셀 텍스트 편집기 -->
                                <Border Visibility="{Binding IsSelectedElementTable, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📊 표 규격 및 격자선" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                        <!-- 행 수 / 열 수 Stepper -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 행 수 Stepper -->
                                            <DockPanel Grid.Column="0">
                                                <TextBlock Text="행" Width="22" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepTableRowsCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="행 1개 감소"/>
                                                <Button Content="+" Command="{Binding StepTableRowsCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="행 1개 추가"/>
                                                <TextBox Text="{Binding SelectedElementTableRows, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                            </DockPanel>
                                            <!-- 열 수 Stepper -->
                                            <DockPanel Grid.Column="2">
                                                <TextBlock Text="열" Width="22" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepTableColumnsCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="열 1개 감소"/>
                                                <Button Content="+" Command="{Binding StepTableColumnsCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="열 1개 추가"/>
                                                <TextBox Text="{Binding SelectedElementTableColumns, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                            </DockPanel>
                                        </Grid>

                                        <!-- 선 두께 Stepper & 헤더 강조 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 선 두께 Stepper -->
                                            <DockPanel Grid.Column="0">
                                                <TextBlock Text="두께" Width="26" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepTableLineWidthCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="0,0,2,0" ToolTip="선 두께 1px 감소"/>
                                                <Button Content="+" Command="{Binding StepTableLineWidthCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="2,0,0,0" ToolTip="선 두께 1px 증가"/>
                                                <TextBox Text="{Binding SelectedElementTableLineWidth, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                            </DockPanel>
                                            <!-- 헤더 행 음영 강조 체크박스 -->
                                            <CheckBox Grid.Column="2" Content="첫 행 음영" IsChecked="{Binding SelectedElementTableIsFilled}" VerticalAlignment="Center" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11.5" ToolTip="표의 첫 번째 행(헤더)에 배경 음영을 채웁니다."/>
                                        </Grid>

                                        <!-- 균등 분할 버튼 -->
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="↔ 열 너비 균등" Command="{Binding EvenTableColumnsCommand}" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11" Margin="0,0,3,0" ToolTip="모든 열의 폭을 균등하게 재조정합니다."/>
                                            <Button Content="↕ 행 높이 균등" Command="{Binding EvenTableRowsCommand}" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11" Margin="3,0,0,0" ToolTip="모든 행의 높이를 균등하게 재조정합니다."/>
                                        </UniformGrid>

                                        <Separator Background="#E2E8F0" Margin="0,4,0,8"/>

                                        <!-- 행/열별 글꼴 및 서식 일괄 설정 -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="🔤 행/열별 글꼴 및 서식 설정" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="서식 초기화" Command="{Binding ResetTableFontsCommand}"
                                                    Style="{StaticResource ModernButtonStyle}" Background="#64748B" Foreground="White"
                                                    Height="20" Padding="6,0" FontSize="9.5" ToolTip="표의 모든 행/열/셀 개별 서식을 초기화하고 기본 폰트로 복원합니다."/>
                                        </DockPanel>

                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                            <StackPanel>
                                                <!-- 서식 옵션: 글자 크기, 굵게, 정렬 -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 크기 Stepper -->
                                                    <DockPanel Grid.Column="0">
                                                        <TextBlock Text="크기" Width="24" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="-" Command="{Binding StepTableTargetFontSizeCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="24" Margin="0,0,2,0" ToolTip="글자 크기 1pt 감소"/>
                                                        <Button Content="+" Command="{Binding StepTableTargetFontSizeCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="24" Margin="2,0,0,0" ToolTip="글자 크기 1pt 증가"/>
                                                        <TextBox Text="{Binding TableTargetFontSize, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Height="24" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                                    </DockPanel>

                                                    <!-- 굵게 체크박스 -->
                                                    <CheckBox Grid.Column="2" Content="굵게(B)" IsChecked="{Binding TableTargetIsBold}" VerticalAlignment="Center" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11" FontWeight="Bold"/>

                                                    <!-- 정렬 콤보 -->
                                                    <ComboBox Grid.Column="4" SelectedValue="{Binding TableTargetAlignment}" SelectedValuePath="Tag" Height="24" FontSize="10.5" Width="55" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="가운데" Tag="CENTER"/>
                                                        <ComboBoxItem Content="왼쪽" Tag="LEFT"/>
                                                        <ComboBoxItem Content="오른쪽" Tag="RIGHT"/>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- 적용 버튼 영역: 특정 행 적용 / 특정 열 적용 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 특정 행 일괄 적용 -->
                                                    <DockPanel Grid.Column="0">
                                                        <ComboBox ItemsSource="{Binding AvailableTableRows}"
                                                                  SelectedValue="{Binding SelectedTableRowIndex}"
                                                                  SelectedValuePath="Code"
                                                                  DisplayMemberPath="Name"
                                                                  Height="24" FontSize="10.5" Width="52" Margin="0,0,4,0"/>
                                                        <Button Content="행 적용" Command="{Binding ApplyTableRowFontCommand}"
                                                                Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="24" FontSize="10.5" FontWeight="SemiBold"
                                                                ToolTip="선택한 행의 모든 셀에 위 서식을 적용합니다."/>
                                                    </DockPanel>

                                                    <!-- 특정 열 일괄 적용 -->
                                                    <DockPanel Grid.Column="2">
                                                        <ComboBox ItemsSource="{Binding AvailableTableColumns}"
                                                                  SelectedValue="{Binding SelectedTableColumnIndex}"
                                                                  SelectedValuePath="Code"
                                                                  DisplayMemberPath="Name"
                                                                  Height="24" FontSize="10.5" Width="52" Margin="0,0,4,0"/>
                                                        <Button Content="열 적용" Command="{Binding ApplyTableColumnFontCommand}"
                                                                Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="24" FontSize="10.5" FontWeight="SemiBold"
                                                                ToolTip="선택한 열의 모든 셀에 위 서식을 적용합니다."/>
                                                    </DockPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 셀 텍스트 및 엑셀 컬럼 매핑 편집기 (행/열 표 형태) -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="✏️ 표 각 셀 데이터 및 엑셀 연동" FontWeight="Bold" FontSize="12" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                            <TextBlock Text="(셀별 엑셀 열 매핑 가능)" FontSize="10.5" Foreground="#047857" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="300">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SelectedElementTableCells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="{Binding DataContext.SelectedElementTableColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="3" Padding="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="5">
                                                                <StackPanel>
                                                                    <!-- 셀 라벨, 크기/굵기 조절 및 해제 버튼 -->
                                                                    <DockPanel Margin="0,0,0,2">
                                                                        <TextBlock Text="{Binding CellLabel}" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                                        
                                                                        <Button DockPanel.Dock="Right" Content="✕" 
                                                                                Command="{Binding DataContext.UnlinkTableCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding IsExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White"
                                                                                Height="18" Width="18" Padding="0" FontSize="9" FontWeight="Bold" Margin="3,0,0,0" ToolTip="해당 셀의 엑셀 연동을 해제합니다."/>

                                                                        <!-- 셀 개별 서식 빠른 조절 버튼들 -->
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Button Content="-" Command="{Binding DecreaseFontSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="15" Height="17" Margin="0,0,1,0" FontSize="8.5" ToolTip="이 셀 글자크기 1pt 감소"/>
                                                                            <TextBlock Text="{Binding CellFontSize, StringFormat='{}{0:0}'}" FontSize="9" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="1,0"/>
                                                                            <Button Content="+" Command="{Binding IncreaseFontSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="15" Height="17" Margin="1,0,2,0" FontSize="8.5" ToolTip="이 셀 글자크기 1pt 증가"/>
                                                                            <ToggleButton Content="B" IsChecked="{Binding CellIsBold}" Width="16" Height="17" FontSize="8.5" FontWeight="Bold" Margin="0,0,1,0" ToolTip="이 셀 굵게 토글"/>
                                                                        </StackPanel>
                                                                    </DockPanel>

                                                                    <!-- 엑셀 컬럼 선택 콤보박스 -->
                                                                    <ComboBox ItemsSource="{Binding AvailableExcelOptions}"
                                                                              SelectedValue="{Binding SelectedExcelColumn, UpdateSourceTrigger=PropertyChanged}"
                                                                              SelectedValuePath="Code"
                                                                              DisplayMemberPath="Name"
                                                                              Height="23" FontSize="10.5" Margin="0,0,0,3"
                                                                              ToolTip="엑셀 열과 연동하거나 직접 입력을 선택하세요."/>

                                                                    <!-- 1. 미연동 시: 직접 텍스트 입력창 (줄바꿈 허용) -->
                                                                    <TextBox Visibility="{Binding IsExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                             FontSize="11.5" 
                                                                             MinHeight="34"
                                                                             MaxHeight="80"
                                                                             AcceptsReturn="True"
                                                                             TextWrapping="Wrap"
                                                                             VerticalScrollBarVisibility="Auto"
                                                                             VerticalContentAlignment="Top" 
                                                                             Padding="4,2" 
                                                                             BorderBrush="#CBD5E1"
                                                                             BorderThickness="1"
                                                                             Background="#FFFFFF"
                                                                             ToolTip="셀에 인쇄될 고정 텍스트를 입력하세요. Enter로 줄바꿈이 가능합니다."/>

                                                                    <!-- 2. 엑셀 연동 시: 연동 뱃지 및 실시간 미리보기 값 -->
                                                                    <Border Visibility="{Binding IsExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                                        <TextBlock Text="{Binding EffectivePreviewText, StringFormat='🔗 {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#047857" TextTrimming="CharacterEllipsis" ToolTip="엑셀 파일에서 읽어온 실시간 데이터입니다."/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 5. 위치 및 크기 정밀 조정 (X, Y, W, H mm) + Numeric Up/Down Stepper -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📏 위치 및 크기 (mm)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- X Stepper -->
                                            <DockPanel Grid.Column="0">
                                                <TextBlock Text="X" Width="14" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
