<Window x:Class="BarcodePrint.WpfView.WpfMainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BarcodePrint.ViewModel"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="1000" Width="1800"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="Manual"
        Background="#F1F5F9"
        FontFamily="Pretendard, 맑은 고딕, Malgun Gothic, Segoe UI, sans-serif"
        FontSize="13"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ExportTemplateCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsTemplateCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding SinglePrintCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Ctrl+Shift" Command="{Binding BringToFrontCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Ctrl+Shift" Command="{Binding SendToBackCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Ctrl" Command="{Binding BringForwardCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Ctrl" Command="{Binding SendBackwardCommand}"/>
        <KeyBinding Key="Oem6" Modifiers="Ctrl+Shift" Command="{Binding BringToFrontCommand}"/>
        <KeyBinding Key="Oem4" Modifiers="Ctrl+Shift" Command="{Binding SendToBackCommand}"/>
        <KeyBinding Key="Oem6" Modifiers="Ctrl" Command="{Binding BringForwardCommand}"/>
        <KeyBinding Key="Oem4" Modifiers="Ctrl" Command="{Binding SendBackwardCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="HeaderSecondaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="ExcelButtonBrush" Color="#059669"/>
        <SolidColorBrush x:Key="ExcelButtonHoverBrush" Color="#047857"/>

        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                                <Setter Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Utility Button Style (Slate Grey) -->
        <Style x:Key="ActionUtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Excel Button Style -->
        <Style x:Key="ExcelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ExcelButtonBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ExcelButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Alignment Toolbar Button Style (미니멀 그레이) -->
        <Style x:Key="ModernAlignBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Alignment Icon Button Style (정사각형 그래픽 아이콘 버튼) -->
        <Style x:Key="ModernAlignIconBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1.5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid Picker Item Button Style (도형/선 팝업 표 선택용) -->
        <Style x:Key="GridPickerItemBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Margin" Value="2.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tone-on-tone Tool Element Button Style -->
        <Style x:Key="ModernElementChipBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac & Android Style Studio Tool Palette Flat Button (슬림 모노톤 레일) -->
        <Style x:Key="ModernPaletteCardBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 구글 워크스페이스 알약형 툴바용 보더리스 토글 스타일 -->
        <Style x:Key="PillToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D3E3FD"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Header Bar Action Button Style (다크 헤더 전용) -->
        <Style x:Key="ModernHeaderBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Center Segmented Item Button Style -->
        <Style x:Key="HeaderToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Step & Navigation Button Style (큼직하고 터치하기 좋은 둥근 버튼) -->
        <Style x:Key="MiniStepBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Connection Type Filter RadioButton Style (세그먼트 칩 형태) -->
        <Style x:Key="ConnectionFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ToggleButton Style (for Bold, Italic) -->
        <Style x:Key="ModernToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mobile-Style CheckBox -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="chkBorder" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="4">
                                    <Path x:Name="chkCheckMark" Data="M 3 8 L 7 12 L 13 4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="chkCheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Splitter Style -->
        <Style x:Key="ModernSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="Grip" Background="#CBD5E1" CornerRadius="2" Margin="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <ControlTemplate x:Key="ModernComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="true">
                <Border x:Name="splitBorder" Width="20" HorizontalAlignment="Right" SnapsToDevicePixels="true">
                    <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#64748B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="7,3,20,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="6" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" Padding="2" Margin="0,3,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Direction="270" Opacity="0.18" RenderingBias="Performance" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ModernComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="CenterAlignTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CenterAlignEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style x:Key="CustomDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="더블클릭: 헤더명 변경 | 우클릭: 메뉴 열기"/>
        </Style>

        <!-- Modern Card Expander Style -->
        <Style x:Key="ModernCardExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBorder" Background="#F1F5F9" CornerRadius="7,7,0,0" Padding="12,9">
                                                <DockPanel>
                                                    <Path x:Name="Arrow"
                                                          DockPanel.Dock="Right"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#475569"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <Border x:Name="ContentSite"
                                        DockPanel.Dock="Bottom"
                                        Visibility="Collapsed"
                                        Padding="12,10"
                                        Background="White"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="HeaderSite" Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBorder" Background="#F1F5F9" CornerRadius="7" Padding="12,9">
                                                <DockPanel>
                                                    <Path x:Name="Arrow"
                                                          DockPanel.Dock="Right"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#475569"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 0. Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Smart 3-Mode Work Tabs -->
            <RowDefinition Height="*"/>
            <!-- 2. Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar (구글 스프레드시트 스타일 2단: 1행 메뉴바+용지사이즈 / 2행 1줄 알약형 도구모음) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6,10,8" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.04"/>
            </Border.Effect>
            <StackPanel>
                <!-- 1행: 좌측 브랜드 뱃지 + 텍스트 메뉴바 + 우측 용지 사이즈 직접 편집 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,5">
                    <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="6" Margin="2,0,8,0" VerticalAlignment="Center" ToolTip="LabelMaster Studio">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="LM" FontSize="10.5" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Button DockPanel.Dock="Right" Content="🖨️ 라벨 인쇄" Command="{Binding SinglePrintCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" Height="28" Padding="14,0" Margin="8,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" ToolTip="현재 보이는 라벨을 인쇄합니다. (Ctrl+P)"/>

                    <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="라벨 용지 크기 (mm) 직접 수정">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏷️" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Button Content="-" Command="{Binding DecreasePaperWidthCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="22" FontSize="12" FontWeight="Bold" Padding="0"/>
                            <TextBox Text="{Binding PaperWidthStr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="40" Height="22" Margin="2,0" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Background="White" BorderBrush="#BFDBFE" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button Content="+" Command="{Binding IncreasePaperWidthCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="22" FontSize="12" FontWeight="Bold" Padding="0"/>
                            <TextBlock Text="×" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="4,0" VerticalAlignment="Center"/>
                            <Button Content="-" Command="{Binding DecreasePaperHeightCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="22" FontSize="12" FontWeight="Bold" Padding="0"/>
                            <TextBox Text="{Binding PaperHeightStr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="40" Height="22" Margin="2,0" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Background="White" BorderBrush="#BFDBFE" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button Content="+" Command="{Binding IncreasePaperHeightCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="22" FontSize="12" FontWeight="Bold" Padding="0"/>
                            <TextBlock Text="mm" FontSize="11.5" FontWeight="SemiBold" Foreground="#3B82F6" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Menu Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" FontSize="12.5" Foreground="#334155">
                    <MenuItem Header="파일" Padding="8,3">
                        <MenuItem Header="새 문서 탭" Command="{Binding NewTabCommand}"/>
                        <MenuItem Header="템플릿 열기..." Command="{Binding ImportTemplateCommand}"/>
                        <Separator/>
                        <MenuItem Header="저장" InputGestureText="Ctrl+S" Command="{Binding ExportTemplateCommand}"/>
                        <MenuItem Header="다른 이름으로 저장..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsTemplateCommand}"/>
                        <Separator/>
                        <MenuItem Header="대시보드로 돌아가기" Click="OnGoHomeClick"/>
                    </MenuItem>
                    <MenuItem Header="수정" Padding="8,3">
                        <MenuItem Header="실행 취소" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                        <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                        <Separator/>
                        <MenuItem Header="선택 요소 복제" InputGestureText="Ctrl+D" Command="{Binding CopySelectedCommand}"/>
                        <MenuItem Header="선택 요소 삭제" InputGestureText="Del" Command="{Binding DeleteSelectedElementCommand}"/>
                    </MenuItem>
                    <MenuItem Header="보기" Padding="8,3">
                        <MenuItem Header="격자 눈금 표시" IsCheckable="True" IsChecked="{Binding ShowCanvasGrid}"/>
                        <MenuItem Header="격자 자동 맞춤 (스냅)" IsCheckable="True" IsChecked="{Binding SnapToGrid}"/>
                        <Separator/>
                        <MenuItem Header="확대" Command="{Binding ZoomInCommand}"/>
                        <MenuItem Header="축소" Command="{Binding ZoomOutCommand}"/>
                        <MenuItem Header="100% 원본 배율" Command="{Binding ResetZoomCommand}"/>
                        <MenuItem Header="편집 영역 중앙 맞춤" Click="OnCenterCanvasViewClick"/>
                    </MenuItem>
                    <MenuItem Header="삽입" Padding="8,3">
                        <MenuItem Header="텍스트" Command="{Binding AddTextElementCommand}"/>
                        <MenuItem Header="1D 바코드" Command="{Binding AddBarcodeElementCommand}"/>
                        <MenuItem Header="2D QR코드" Command="{Binding AddQrElementCommand}"/>
                        <MenuItem Header="표 (Table)" Command="{Binding AddTableElementCommand}"/>
                        <MenuItem Header="이미지" Command="{Binding AddImageElementCommand}"/>
                        <MenuItem Header="PDF" Command="{Binding ImportPdfCommand}"/>
                        <MenuItem Header="일시 (날짜/시간)" Command="{Binding AddDateTimeElementCommand}"/>
                        <MenuItem Header="연속 순번 (일련번호)" Command="{Binding AddSerialElementCommand}"/>
                    </MenuItem>
                    <MenuItem Header="서식" Padding="8,3">
                        <MenuItem Header="위치 초기화" Command="{Binding ResetLayoutCommand}"/>
                        <MenuItem Header="90° 회전" Command="{Binding Rotate90Command}"/>
                        <Separator/>
                        <MenuItem Header="맨 앞으로 가져오기" InputGestureText="Ctrl+Shift+]" Command="{Binding BringToFrontCommand}"/>
                        <MenuItem Header="한 단계 앞으로" InputGestureText="Ctrl+]" Command="{Binding BringForwardCommand}"/>
                        <MenuItem Header="한 단계 뒤로" InputGestureText="Ctrl+[" Command="{Binding SendBackwardCommand}"/>
                        <MenuItem Header="맨 뒤로 보내기" InputGestureText="Ctrl+Shift+[" Command="{Binding SendToBackCommand}"/>
                    </MenuItem>
                    <MenuItem Header="데이터" Padding="8,3">
                        <MenuItem Header="엑셀 파일 불러오기..." Command="{Binding ImportFromExcelCommand}"/>
                        <MenuItem Header="엑셀 연동 해제" Command="{Binding UnlinkExcelCommand}"/>
                    </MenuItem>
                    <MenuItem Header="도구" Padding="8,3">
                        <MenuItem Header="프린터 설정..." Command="{Binding OpenPrinterSettingsCommand}"/>
                        <MenuItem Header="라벨 인쇄..." InputGestureText="Ctrl+P" Command="{Binding PrintCommand}"/>
                    </MenuItem>
                </Menu>
                </DockPanel>

                <!-- 3행: 구글 스프레드시트 스타일 1줄 알약형(Pill) 도구모음 -->
                <Border Background="#EDF2FA" CornerRadius="19" Padding="10,4" Height="38">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 새 문서 / 저장 / 다른 이름으로 저장 -->
                            <Button Command="{Binding NewTabCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="26" Height="26" ToolTip="새 문서 탭" Margin="0,0,2,0" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="📄" FontSize="12.5"/>
                            </Button>
                            <Button Command="{Binding ExportTemplateCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="26" Height="26" ToolTip="저장 (Ctrl+S)" Margin="0,0,2,0" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="💾" FontSize="12.5"/>
                            </Button>
                            <Button Command="{Binding SaveAsTemplateCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="26" Height="26" ToolTip="다른 이름으로 저장 (Ctrl+Shift+S)" Margin="0,0,4,0" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="📝" FontSize="12.5"/>
                            </Button>

                            <Rectangle Width="1" Height="18" Fill="#CBD5E1" Margin="4,0"/>

                            <!-- 실행취소 / 다시실행 / 인쇄 -->
                            <Button Command="{Binding UndoCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="26" Height="26" ToolTip="실행 취소 (Ctrl+Z)" Margin="0,0,2,0" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="↶" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                            </Button>
                            <Button Command="{Binding RedoCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="26" Height="26" ToolTip="다시 실행 (Ctrl+Y)" Margin="0,0,2,0" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="↷" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                            </Button>
                            <Button Command="{Binding SinglePrintCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="26" Height="26" ToolTip="빠른 인쇄 (Ctrl+P)" Margin="0,0,4,0" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="🖨️" FontSize="12.5"/>
                            </Button>

                            <Rectangle Width="1" Height="18" Fill="#CBD5E1" Margin="4,0"/>

                            <!-- 격자 / 스냅 -->
                            <ToggleButton IsChecked="{Binding ShowCanvasGrid}" Style="{StaticResource PillToggleBtnStyle}" Height="26" Padding="7,0" Margin="0,0,2,0" ToolTip="캔버스 격자 눈금 표시">
                                <TextBlock Text="격자" FontSize="11.5" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding SnapToGrid}" Style="{StaticResource PillToggleBtnStyle}" Height="26" Padding="7,0" Margin="0,0,4,0" ToolTip="1mm 격자 자동 맞춤">
                                <TextBlock Text="스냅" FontSize="11.5" FontWeight="SemiBold"/>
                            </ToggleButton>

                            <Rectangle Width="1" Height="18" Fill="#CBD5E1" Margin="4,0"/>

                            <!-- 글꼴 & 크기 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsSelectedElementTextOrTable}">
                                <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedElementFontName}" Width="118" Height="27" Padding="6,2" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,0,4,0" ToolTip="글꼴 변경"/>
                                <Button Content="-" Command="{Binding StepFontSizeCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" FontSize="12" Margin="0,0,1,0"/>
                                <TextBox Text="{Binding SelectedElementFontSize, UpdateSourceTrigger=PropertyChanged}" Width="34" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                <Button Content="+" Command="{Binding StepFontSizeCommand}" CommandParameter="1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" FontSize="12" Margin="1,0,4,0"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="18" Fill="#CBD5E1" Margin="4,0"/>

                            <!-- B / I / U & 세 / 미 / 반 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsSelectedElementTextOrTable}">
                                <ToggleButton IsChecked="{Binding SelectedElementIsBold}" Width="26" Height="26" Margin="0,0,2,0" Style="{StaticResource PillToggleBtnStyle}" ToolTip="굵게 (Bold)">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="12.5"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding SelectedElementIsItalic}" Width="26" Height="26" Margin="0,0,2,0" Style="{StaticResource PillToggleBtnStyle}" ToolTip="기울임 (Italic)">
                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="12.5"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding SelectedElementIsUnderline}" Width="26" Height="26" Margin="0,0,2,0" Style="{StaticResource PillToggleBtnStyle}" ToolTip="밑줄 (Underline)">
                                    <TextBlock Text="U" TextDecorations="Underline" FontWeight="Bold" FontSize="12.5"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding SelectedElementIsVertical}" IsEnabled="{Binding IsSelectedElementText}" Width="26" Height="26" Margin="0,0,2,0" Style="{StaticResource PillToggleBtnStyle}" ToolTip="세로쓰기">
                                    <TextBlock Text="세" FontWeight="Bold" FontSize="11"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding SelectedElementIsMirrored}" IsEnabled="{Binding IsSelectedElementText}" Width="26" Height="26" Margin="0,0,2,0" Style="{StaticResource PillToggleBtnStyle}" ToolTip="미러 (좌우 반전)">
                                    <TextBlock Text="미" FontWeight="Bold" FontSize="11"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding SelectedElementIsInverse}" IsEnabled="{Binding IsSelectedElementText}" Width="26" Height="26" Margin="0,0,4,0" Style="{StaticResource PillToggleBtnStyle}" ToolTip="음영 반전">
                                    <Border Background="#334155" CornerRadius="3" Width="16" Height="16">
                                        <TextBlock Text="반" FontWeight="Bold" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ToggleButton>
                            </StackPanel>

                            <Rectangle Width="1" Height="18" Fill="#CBD5E1" Margin="4,0"/>

                            <!-- 드롭다운 1: 정렬 ▾ -->
                            <Grid Margin="0,0,3,0">
                                <ToggleButton x:Name="BtnAlignPopup" Style="{StaticResource PillToggleBtnStyle}" Height="26" Padding="7,0" ToolTip="요소 및 텍스트 정렬">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="15" Height="15">
                                            <Canvas Width="16" Height="16">
                                                <Line X1="2" Y1="1.5" X2="2" Y2="14.5" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Rectangle Canvas.Left="4.5" Canvas.Top="3.5" Width="9.5" Height="3.5" RadiusX="1" RadiusY="1" Fill="#334155"/>
                                                <Rectangle Canvas.Left="4.5" Canvas.Top="9" Width="6" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="▾" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=BtnAlignPopup}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=BtnAlignPopup, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="요소 정렬" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Command="{Binding AlignLeftCommand}" ToolTip="선택 항목 좌측 맞춤" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="2" Y1="1.5" X2="2" Y2="14.5" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="4" Canvas.Top="3.5" Width="10" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="4" Canvas.Top="9" Width="6" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Command="{Binding AlignCenterCommand}" ToolTip="선택 항목 가로 중앙 맞춤" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="8" Y1="1.5" X2="8" Y2="14.5" Stroke="#2563EB" StrokeThickness="1.5" StrokeDashArray="2,1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="2.5" Canvas.Top="3.5" Width="11" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="5" Canvas.Top="9" Width="6" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Command="{Binding AlignRightCommand}" ToolTip="선택 항목 우측 맞춤" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="14" Y1="1.5" X2="14" Y2="14.5" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="2" Canvas.Top="3.5" Width="10" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="6" Canvas.Top="9" Width="6" Height="3.5" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Rectangle Width="1" Height="16" Fill="#E2E8F0" Margin="4,0"/>
                                                <Button Command="{Binding AlignTopCommand}" ToolTip="선택 항목 상단 맞춤" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="1.5" Y1="2" X2="14.5" Y2="2" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="3.5" Canvas.Top="4" Width="3.5" Height="10" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="9" Canvas.Top="4" Width="3.5" Height="6" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Command="{Binding AlignMiddleCommand}" ToolTip="선택 항목 세로 중앙 맞춤" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="1.5" Y1="8" X2="14.5" Y2="8" Stroke="#2563EB" StrokeThickness="1.5" StrokeDashArray="2,1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="3.5" Canvas.Top="2.5" Width="3.5" Height="11" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="9" Canvas.Top="5" Width="3.5" Height="6" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Command="{Binding AlignBottomCommand}" ToolTip="선택 항목 하단 맞춤" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="1.5" Y1="14" X2="14.5" Y2="14" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="3.5" Canvas.Top="2" Width="3.5" Height="10" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="9" Canvas.Top="6" Width="3.5" Height="6" RadiusX="1" RadiusY="1" Fill="#64748B"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Rectangle Width="1" Height="16" Fill="#E2E8F0" Margin="4,0"/>
                                                <Button Command="{Binding DistributeHorizontalCommand}" ToolTip="가로 간격 균등 분배" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="1.8" Y1="2" X2="1.8" Y2="14" Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="4.5" Canvas.Top="3" Width="2.5" Height="10" RadiusX="0.8" RadiusY="0.8" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="9" Canvas.Top="3" Width="2.5" Height="10" RadiusX="0.8" RadiusY="0.8" Fill="#64748B"/>
                                                            <Line X1="14.2" Y1="2" X2="14.2" Y2="14" Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Command="{Binding DistributeVerticalCommand}" ToolTip="세로 간격 균등 분배" Style="{StaticResource ModernAlignIconBtnStyle}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="2" Y1="1.8" X2="14" Y2="1.8" Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Rectangle Canvas.Left="3" Canvas.Top="4.5" Width="10" Height="2.5" RadiusX="0.8" RadiusY="0.8" Fill="#64748B"/>
                                                            <Rectangle Canvas.Left="3" Canvas.Top="9" Width="10" Height="2.5" RadiusX="0.8" RadiusY="0.8" Fill="#64748B"/>
                                                            <Line X1="2" Y1="14.2" X2="14" Y2="14.2" Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="텍스트 정렬" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsSelectedElementTextOrTable}">
                                                <Button Click="OnSelectedAlignLeftClick" ToolTip="텍스트 좌측 정렬" Style="{StaticResource ModernAlignIconBtnStyle}" Width="28" Height="28" Margin="0,0,3,0">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="2" Y1="3.5" X2="14" Y2="3.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Line X1="2" Y1="8" X2="9.5" Y2="8" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Line X1="2" Y1="12.5" X2="13" Y2="12.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Click="OnSelectedAlignCenterClick" ToolTip="텍스트 가운데 정렬" Style="{StaticResource ModernAlignIconBtnStyle}" Width="28" Height="28" Margin="0,0,3,0">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="2" Y1="3.5" X2="14" Y2="3.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Line X1="4.5" Y1="8" X2="11.5" Y2="8" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Line X1="2.5" Y1="12.5" X2="13.5" Y2="12.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Click="OnSelectedAlignRightClick" ToolTip="텍스트 우측 정렬" Style="{StaticResource ModernAlignIconBtnStyle}" Width="28" Height="28">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="16" Height="16">
                                                            <Line X1="2" Y1="3.5" X2="14" Y2="3.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Line X1="6.5" Y1="8" X2="14" Y2="8" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            <Line X1="3" Y1="12.5" X2="14" Y2="12.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- 드롭다운 2: 순서 ▾ -->
                            <Grid Margin="0,0,3,0">
                                <ToggleButton x:Name="BtnOrderPopup" Style="{StaticResource PillToggleBtnStyle}" Height="26" Padding="7,0" ToolTip="레이어 순서 (Z-Index)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="15" Height="15">
                                            <Canvas Width="16" Height="16">
                                                <Polygon Points="8,1.5 14.5,5.2 8,8.8 1.5,5.2" Fill="#DBEAFE" Stroke="#2563EB" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                                <Polyline Points="1.5,8.5 8,12.2 14.5,8.5" Stroke="#475569" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Polyline Points="1.5,11.6 8,15.1 14.5,11.6" Stroke="#94A3B8" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="▾" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=BtnOrderPopup}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=BtnOrderPopup, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Command="{Binding BringToFrontCommand}" Content="⮵ 맨 앞으로 가져오기" Style="{StaticResource MiniStepBtnStyle}" HorizontalContentAlignment="Left" Padding="8,4" Height="28" Margin="0,0,0,2"/>
                                            <Button Command="{Binding BringForwardCommand}" Content="⬆ 한 단계 앞으로" Style="{StaticResource MiniStepBtnStyle}" HorizontalContentAlignment="Left" Padding="8,4" Height="28" Margin="0,0,0,2"/>
                                            <Button Command="{Binding SendBackwardCommand}" Content="⬇ 한 단계 뒤로" Style="{StaticResource MiniStepBtnStyle}" HorizontalContentAlignment="Left" Padding="8,4" Height="28" Margin="0,0,0,2"/>
                                            <Button Command="{Binding SendToBackCommand}" Content="⮶ 맨 뒤로 보내기" Style="{StaticResource MiniStepBtnStyle}" HorizontalContentAlignment="Left" Padding="8,4" Height="28"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- 드롭다운 3: 위치·크기·용지 ▾ -->
                            <Grid>
                                <ToggleButton x:Name="BtnGeometryPopup" Style="{StaticResource PillToggleBtnStyle}" Height="26" Padding="7,0" ToolTip="선택 요소 위치·크기 및 용지 규격 미세 조정">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="15" Height="15">
                                            <Canvas Width="16" Height="16">
                                                <Rectangle Canvas.Left="2.5" Canvas.Top="2.5" Width="11" Height="11" RadiusX="1.2" RadiusY="1.2" Stroke="#334155" StrokeThickness="1.4" StrokeDashArray="2 1.2"/>
                                                <Line X1="8" Y1="4.5" X2="8" Y2="11.5" Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="4.5" Y1="8" X2="11.5" Y2="8" Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="▾" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=BtnGeometryPopup}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=BtnGeometryPopup, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="선택 요소 좌표 / 크기 (mm)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSelectedElement}" Margin="0,0,0,6">
                                                <TextBlock Text="X" Width="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepXCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBox Text="{Binding SelectedElementX, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Width="44" Height="26" Margin="2,0" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                <Button Content="+" Command="{Binding StepXCommand}" CommandParameter="0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26" Margin="0,0,8,0"/>

                                                <TextBlock Text="Y" Width="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepYCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBox Text="{Binding SelectedElementY, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Width="44" Height="26" Margin="2,0" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                <Button Content="+" Command="{Binding StepYCommand}" CommandParameter="0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSelectedElement}" Margin="0,0,0,8">
                                                <TextBlock Text="폭" Width="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepWidthCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBox Text="{Binding SelectedElementWidth, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Width="44" Height="26" Margin="2,0" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                <Button Content="+" Command="{Binding StepWidthCommand}" CommandParameter="0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26" Margin="0,0,8,0"/>

                                                <TextBlock Text="고" Width="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepHeightCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBox Text="{Binding SelectedElementHeight, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Width="44" Height="26" Margin="2,0" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                <Button Content="+" Command="{Binding StepHeightCommand}" CommandParameter="0.5" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                            </StackPanel>
                                            <Separator Background="#E2E8F0" Margin="0,0,0,8"/>
                                            <TextBlock Text="용지 규격 미세 조정 (mm)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="-" Command="{Binding DecreasePaperWidthCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBox Text="{Binding PaperWidthStr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="44" Height="26" Margin="2,0" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                <Button Content="+" Command="{Binding IncreasePaperWidthCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBlock Text="×" VerticalAlignment="Center" FontWeight="Bold" Margin="6,0"/>
                                                <Button Content="-" Command="{Binding DecreasePaperHeightCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                                <TextBox Text="{Binding PaperHeightStr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="44" Height="26" Margin="2,0" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                <Button Content="+" Command="{Binding IncreasePaperHeightCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26"/>
                                            </StackPanel>
                                            <Button Command="{Binding ResetLayoutCommand}" Content="↺ 위치 초기화" Style="{StaticResource MiniStepBtnStyle}" Height="28" Padding="10,0"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- 1. Main Workspace Grid (Left: Tool Palette, Center: WYSIWYG Canvas, Right: Inspector & Tabs) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 0. 좌측 요소 도구 팔레트 (슬림 폭 유지로 낮은 해상도 편집영역 확보) -->
                <ColumnDefinition Width="102" MinWidth="88" MaxWidth="124"/>
                <!-- 1. 중앙 광활한 위즈윅 캔버스 워크스페이스 -->
                <ColumnDefinition Width="*" MinWidth="180"/>
                <!-- 2. 스플리터 -->
                <ColumnDefinition Width="6"/>
                <!-- 3. 우측 모던 속성 인스펙터 & 작업 패널 (1800x1000 기준 400px) -->
                <ColumnDefinition Width="400" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- [COLUMN 0] 좌측 요소 도구 팔레트 (Left Sidebar Palette)     -->
            <!-- ========================================================== -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="6,8" Margin="0,0,8,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="도구" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        
                        <!-- 1. 텍스트 -->
                        <Button Command="{Binding AddTextElementCommand}" ToolTip="새 텍스트 항목 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock Text="T" FontSize="13.5" FontWeight="ExtraBold" Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="텍스트" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. 바코드 -->
                        <Button Command="{Binding AddBarcodeElementCommand}" ToolTip="새 1D 바코드 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="22" Height="22">
                                        <Line X1="2" Y1="3" X2="2" Y2="19" Stroke="#1E293B" StrokeThickness="1.8"/>
                                        <Line X1="5.5" Y1="3" X2="5.5" Y2="19" Stroke="#1E293B" StrokeThickness="1.2"/>
                                        <Line X1="8.5" Y1="3" X2="8.5" Y2="19" Stroke="#1E293B" StrokeThickness="2.5"/>
                                        <Line X1="12" Y1="3" X2="12" Y2="19" Stroke="#1E293B" StrokeThickness="1.2"/>
                                        <Line X1="14.5" Y1="3" X2="14.5" Y2="19" Stroke="#1E293B" StrokeThickness="2.2"/>
                                        <Line X1="17.5" Y1="3" X2="17.5" Y2="19" Stroke="#1E293B" StrokeThickness="1"/>
                                        <Line X1="20" Y1="3" X2="20" Y2="19" Stroke="#1E293B" StrokeThickness="1.8"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="바코드" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. QR코드 -->
                        <Button Command="{Binding AddQrElementCommand}" ToolTip="새 2D QR코드 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="22" Height="22">
                                        <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="7" Height="7" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Rectangle Canvas.Left="3.5" Canvas.Top="3.5" Width="3" Height="3" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="13.5" Canvas.Top="1.5" Width="7" Height="7" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Rectangle Canvas.Left="15.5" Canvas.Top="3.5" Width="3" Height="3" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="1.5" Canvas.Top="13.5" Width="7" Height="7" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Rectangle Canvas.Left="3.5" Canvas.Top="15.5" Width="3" Height="3" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="10.5" Canvas.Top="2" Width="1.5" Height="6" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="2" Canvas.Top="10.5" Width="6" Height="1.5" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="13.5" Canvas.Top="10.5" Width="2" Height="2" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="17.5" Canvas.Top="10.5" Width="3" Height="2" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="10.5" Canvas.Top="13.5" Width="2" Height="2" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="14" Canvas.Top="14" Width="2.5" Height="2.5" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="14" Width="2.5" Height="6.5" Fill="#1E293B"/>
                                        <Rectangle Canvas.Left="10.5" Canvas.Top="17.5" Width="6" Height="3" Fill="#1E293B"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="QR코드" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. 표 -->
                        <Button Command="{Binding AddTableElementCommand}" ToolTip="표(Table) 서식 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="22" Height="22">
                                        <Border Canvas.Left="2" Canvas.Top="2.5" Width="18" Height="17" BorderBrush="#1E293B" BorderThickness="1.6" CornerRadius="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="5.5"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#DBEAFE"/>
                                                <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Height="1" Fill="#1E293B" VerticalAlignment="Bottom"/>
                                                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" Fill="#94A3B8" VerticalAlignment="Bottom"/>
                                                <Rectangle Grid.RowSpan="3" Grid.Column="0" Width="1" Fill="#94A3B8" HorizontalAlignment="Right"/>
                                                <Rectangle Grid.RowSpan="3" Grid.Column="1" Width="1" Fill="#94A3B8" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="표" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. 도형 -->
                        <Grid>
                            <Button x:Name="BtnAddShape" Click="OnAddShapeClick" ToolTip="원하는 모양의 도형 선택 및 추가 (17종)" Style="{StaticResource ModernPaletteCardBtnStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0">
                                    <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                        <Canvas Width="22" Height="22">
                                            <Border Canvas.Left="2.5" Canvas.Top="2.5" Width="17" Height="17" BorderBrush="#1E293B" BorderThickness="1.8" CornerRadius="3" Background="#F8FAFC"/>
                                            <Rectangle Canvas.Left="6" Canvas.Top="6" Width="10" Height="10" Stroke="#2563EB" StrokeThickness="1.2" StrokeDashArray="2 1.5"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="도형" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 도형 선택 팝업창 (5열 표/배열 형태) -->
                            <Popup x:Name="PopupAddShape" 
                                   PlacementTarget="{Binding ElementName=BtnAddShape}" 
                                   Placement="Bottom" 
                                   StaysOpen="False" 
                                   AllowsTransparency="True" 
                                   PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="10" Padding="12" Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
                                    </Border.Effect>
                                    <StackPanel Width="360">
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📐 도형 선택 (17종)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button Content="✕" Click="OnCloseShapePopupClick" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="20" HorizontalAlignment="Right" Padding="0" FontSize="11" ToolTip="닫기"/>
                                        </DockPanel>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
                                            <ItemsControl ItemsSource="{Binding AvailableShapeTypes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="5"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddShapeElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Code}"
                                                                Click="OnShapePickBtnClick"
                                                                Style="{StaticResource GridPickerItemBtnStyle}"
                                                                Height="54"
                                                                ToolTip="{Binding DisplayText}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="58"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- 6. 구분선 -->
                        <Grid>
                            <Button x:Name="BtnAddLine" Click="OnAddLineClick" ToolTip="원하는 스타일의 구분선 선택 및 추가 (7종)" Style="{StaticResource ModernPaletteCardBtnStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0">
                                    <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                        <Canvas Width="22" Height="22">
                                            <Line X1="2" Y1="11" X2="20" Y2="11" Stroke="#1E293B" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse Canvas.Left="1.5" Canvas.Top="9" Width="4" Height="4" Fill="#2563EB"/>
                                            <Ellipse Canvas.Left="16.5" Canvas.Top="9" Width="4" Height="4" Fill="#2563EB"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="구분선" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 구분선 선택 팝업창 (4열 표/배열 형태) -->
                            <Popup x:Name="PopupAddLine" 
                                   PlacementTarget="{Binding ElementName=BtnAddLine}" 
                                   Placement="Bottom" 
                                   StaysOpen="False" 
                                   AllowsTransparency="True" 
                                   PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="10" Padding="12" Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
                                    </Border.Effect>
                                    <StackPanel Width="340">
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📏 구분선 선택 (7종)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button Content="✕" Click="OnCloseLinePopupClick" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="20" HorizontalAlignment="Right" Padding="0" FontSize="11" ToolTip="닫기"/>
                                        </DockPanel>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
                                            <ItemsControl ItemsSource="{Binding AvailableLineStyles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddLineElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Code}"
                                                                Click="OnLinePickBtnClick"
                                                                Style="{StaticResource GridPickerItemBtnStyle}"
                                                                Height="54"
                                                                ToolTip="{Binding DisplayText}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="70"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- 7. 이미지 -->
                        <Button Command="{Binding AddImageElementCommand}" ToolTip="로고 및 그래픽 이미지 파일 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="22" Height="22">
                                        <Border Canvas.Left="2" Canvas.Top="3" Width="18" Height="16" BorderBrush="#1E293B" BorderThickness="1.6" CornerRadius="2.5" Background="#F8FAFC">
                                            <Canvas Margin="1">
                                                <Ellipse Canvas.Left="10.5" Canvas.Top="2" Width="3.5" Height="3.5" Fill="#F59E0B"/>
                                                <Polygon Points="1,12 5,6 9,12" Fill="#059669"/>
                                                <Polygon Points="6,12 11,4 15,12" Fill="#10B981"/>
                                            </Canvas>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="이미지" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 8. PDF 불러오기 -->
                        <Button Command="{Binding ImportPdfCommand}" ToolTip="PDF 송장 문서 규격에 맞춰 불러오기" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="22" Height="22">
                                        <Path Data="M 4,2 L 13,2 L 18,7 L 18,20 L 4,20 Z" Fill="#FFFFFF" Stroke="#1E293B" StrokeThickness="1.5"/>
                                        <Path Data="M 13,2 L 13,7 L 18,7" Fill="#E2E8F0" Stroke="#1E293B" StrokeThickness="1.2"/>
                                        <Border Canvas.Left="3" Canvas.Top="11" Width="14" Height="7" Background="#DC2626" CornerRadius="1.5">
                                            <TextBlock Text="PDF" FontSize="5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="PDF" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 9. 일시 (날짜/시간) -->
                        <Button Command="{Binding AddDateTimeElementCommand}" ToolTip="현재 날짜/시간 스탬프 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="22" Height="22">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="18" Height="18" Stroke="#1E293B" StrokeThickness="1.8"/>
                                        <Line X1="11" Y1="11" X2="11" Y2="6" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="11" Y1="11" X2="15.5" Y2="11" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="9.8" Canvas.Top="9.8" Width="2.4" Height="2.4" Fill="#1E293B"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="일시" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 10. 연속 순번 -->
                        <Button Command="{Binding AddSerialElementCommand}" ToolTip="인쇄 매수마다 자동 증가하는 연속 순번(일련번호) 추가" Style="{StaticResource ModernPaletteCardBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0" IsHitTestVisible="False">
                                <Border Width="18" Height="18" Margin="0,0,7,0" Background="#EFF6FF" BorderBrush="#2563EB" BorderThickness="1.2" CornerRadius="4">
                                    <TextBlock Text="123" FontSize="7.5" FontWeight="ExtraBold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="순번" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================== -->
            <!-- [COLUMN 1] 중앙 광활한 위즈윅 캔버스 워크스페이스          -->
            <!-- ========================================================== -->
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0. 상단 정렬 및 용지 수치 툴바 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1. 다중 문서 탭 바 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2. 캔버스 및 줌 컨트롤러 -->
                        <RowDefinition Height="*"/>
                        <!-- 3. 하단 내비게이터 및 안내문구 -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- (서식/정렬 도구모음은 상단 구글 스프레드시트 스타일 알약형 툴바로 통합됨) -->

                    <!-- 1. 다중 문서 탭 바 -->
                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding NewTabCommand}" ToolTip="새 문서 탭 추가" Width="26" Height="24" Margin="4,0,0,0"
                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="14" Foreground="#2563EB" Content="+"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding OpenTabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Margin="0,0,4,0" Padding="9,4" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="1,2,1,0"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📄" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                    <Setter Property="Foreground" Value="#475569"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding SizeBadge, StringFormat=' ({0})'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                        <Button Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Content="✕" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Background="Transparent" BorderThickness="0"
                                                                Width="16" Height="16" Padding="0" Cursor="Hand" ToolTip="탭 닫기"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- 2. 광활한 캔버스 워크스페이스 + 세로형 줌 컨트롤러 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Canvas Workspace with Top & Left Rulers (안드로이드 스타일 가로/세로 눈금자) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- [0,0] 좌상단 단위 표시 코너 박스 (mm) -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                                <TextBlock Text="mm" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- [0,1] 상단 가로 고정 눈금자 (Top Horizontal Ruler) -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" ClipToBounds="True">
                                <Canvas x:Name="TopRulerCanvas" Height="22"/>
                            </Border>

                            <!-- [1,0] 좌측 세로 고정 눈금자 (Left Vertical Ruler) -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" ClipToBounds="True">
                                <Canvas x:Name="LeftRulerCanvas" Width="22"/>
                            </Border>

                            <!-- [1,1] Canvas ScrollViewer (쿨그레이 작업대 배경으로 흰색 라벨 용지 대비 강조) -->
                            <ScrollViewer x:Name="CanvasScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#DDE3EC"
                                          PreviewMouseDown="OnCanvasScrollViewerPreviewMouseDown"
                                          PreviewMouseMove="OnCanvasScrollViewerPreviewMouseMove"
                                          PreviewMouseUp="OnCanvasScrollViewerPreviewMouseUp"
                                          PreviewMouseWheel="OnCanvasScrollViewerPreviewMouseWheel"
                                          ScrollChanged="OnCanvasScrollViewerScrollChanged" SizeChanged="OnCanvasScrollViewerSizeChanged">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36">
                                    <Border BorderBrush="#94A3B8" BorderThickness="1" Background="White" CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.12"/>
                                        </Border.Effect>
                                        <Canvas x:Name="GlobalPreviewCanvas" Width="380" Height="200" Background="White" ClipToBounds="False"
                                                Focusable="True"
                                                MouseLeftButtonDown="OnGlobalCanvasMouseLeftButtonDown"
                                                MouseMove="OnGlobalCanvasMouseMove"
                                                MouseLeftButtonUp="OnGlobalCanvasMouseLeftButtonUp"
                                                MouseLeave="OnCanvasMouseLeave"
                                                MouseWheel="OnGlobalCanvasMouseWheel">
                                            <Canvas.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="⮵ 맨 앞으로 가져오기" InputGestureText="Ctrl+Shift+]" Command="{Binding BringToFrontCommand}"/>
                                                    <MenuItem Header="⬆ 한 단계 앞으로" InputGestureText="Ctrl+]" Command="{Binding BringForwardCommand}"/>
                                                    <MenuItem Header="⬇ 한 단계 뒤로" InputGestureText="Ctrl+[" Command="{Binding SendBackwardCommand}"/>
                                                    <MenuItem Header="⮶ 맨 뒤로 보내기" InputGestureText="Ctrl+Shift+[" Command="{Binding SendToBackCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="📋 요소 복제" InputGestureText="Ctrl+D" Command="{Binding CopySelectedCommand}"/>
                                                    <MenuItem Header="🗑️ 요소 삭제" InputGestureText="Del" Command="{Binding DeleteSelectedElementCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="🖨️ 라벨 인쇄" InputGestureText="Ctrl+P" Command="{Binding SinglePrintCommand}"/>
                                                </ContextMenu>
                                            </Canvas.ContextMenu>
                                        </Canvas>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- 세로형 줌 컨트롤 바 -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,10" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Button Content="➕" Command="{Binding ZoomInCommand}" ToolTip="확대" Style="{StaticResource MiniStepBtnStyle}" Width="28" Height="28" Margin="0,0,0,8" Padding="0" FontSize="13"/>
                                <Slider Orientation="Vertical" Height="150" Minimum="0.15" Maximum="8.0" Value="{Binding ZoomRatio}" HorizontalAlignment="Center" Margin="0,4"/>
                                <Button Content="➖" Command="{Binding ZoomOutCommand}" ToolTip="축소" Style="{StaticResource MiniStepBtnStyle}" Width="28" Height="28" Margin="0,8,0,8" Padding="0" FontSize="13"/>
                                <Button Content="1:1" Command="{Binding ResetZoomCommand}" ToolTip="100% 원본 배율" Style="{StaticResource MiniStepBtnStyle}" Width="32" Height="26" Margin="0,0,0,4" Padding="0" FontSize="11" FontWeight="Bold"/>
                                <Button Content="중앙" Click="OnCenterCanvasViewClick" ToolTip="편집 영역(용지)을 화면 중앙으로 이동 (Space+드래그 / 휠버튼 드래그로도 이동 가능)" Style="{StaticResource MiniStepBtnStyle}" Width="32" Height="24" Margin="0,0,0,6" Padding="0" FontSize="10" FontWeight="Bold" Foreground="#2563EB"/>
                                <TextBlock Text="{Binding ZoomPercentageText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3. Bottom Excel Navigator (하단 페이지 미리보기 제거 -> 하단 상태바 작은 탭으로 이동) -->
                    <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀ 이전" Command="{Binding PreviewPreviousPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="56" Height="26" FontSize="11.5" FontWeight="Bold" ToolTip="이전 라벨 (이전 행)"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,2" Margin="8,0">
                                <TextBlock Text="{Binding PreviewPageText}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="다음 ▶" Command="{Binding PreviewNextPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="56" Height="26" FontSize="11.5" FontWeight="Bold" ToolTip="다음 라벨 (다음 행)"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column Splitter -->
            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Style="{StaticResource ModernSplitterStyle}"/>

            <!-- ========================================================== -->
            <!-- [COLUMN 3] 우측 모던 속성 인스펙터 & 작업 모드 탭 (380px)     -->
            <!-- ========================================================== -->
            <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0. 인스펙터 / 탭 타이틀 헤더 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1. 본문 (속성 인스펙터 OR 탭 컨트롤) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 0. 인스펙터 상단 헤더 (은은한 블루 틴트 헤더) -->
                    <Border Grid.Row="0" BorderBrush="#DBEAFE" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="10,10,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F8FAFC" Offset="0"/>
                                <GradientStop Color="#EFF6FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedElementTypeText}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="✕ 선택 해제" Command="{Binding DeselectElementCommand}" Visibility="{Binding HasSelectedElement, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F1F5F9" Foreground="#64748B" FontSize="11" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,3" Cursor="Hand" ToolTip="선택 해제"/>
                        </DockPanel>
                    </Border>

                    <!-- 1. 본문 (HasSelectedElement에 따라 인스펙터 vs 탭 전환) -->
                    <Grid Grid.Row="1">
                        <!-- 1-A. 모던 속성 인스펙터 (요소 선택 시 활성화) -->
                        <ScrollViewer Visibility="{Binding HasSelectedElement, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8">
                                <!-- 1. 내용 (Content) - 텍스트, 바코드, QR코드, 일시 요소일 때만 표시 -->
                                <Border Visibility="{Binding IsSelectedElementContentEditable, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✏️ 내용 및 데이터 소스" FontWeight="Bold" FontSize="12.5" Foreground="#1D4ED8"/>
                                                <!-- 직접 수정 가능 상태 -->
                                                <Border Background="#DBEAFE" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="{Binding IsSelectedElementExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="직접 수정" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                                </Border>
                                                <!-- 엑셀 컬럼 연동 상태 (직접 수정 제한) -->
                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🔒 엑셀 연동" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 엑셀 데이터 컬럼 매핑 드롭다운 & 엑셀 파일 열기 버튼 -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="데이터 소스" Width="68" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="📁 엑셀 열기" Command="{Binding ImportFromExcelForElementCommand}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Foreground="White" Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" ToolTip="엑셀 파일(*.xlsx)을 불러와 선택된 요소에 컬럼을 매핑합니다."/>
                                            <Button DockPanel.Dock="Right" Content="✕ 연동 해제" Command="{Binding UnlinkSelectedElementExcelCommand}" Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White" Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" ToolTip="현재 요소의 엑셀 연동을 즉시 해제하고 직접 입력 모드로 전환합니다."/>
                                            <ComboBox ItemsSource="{Binding AvailableExcelColumnOptions}"
                                                      SelectedValue="{Binding SelectedElementExcelColumn}"
                                                      SelectedValuePath="Code"
                                                      DisplayMemberPath="Name"
                                                      Height="28" FontSize="11.5" VerticalContentAlignment="Center"
                                                      ToolTip="엑셀 파일의 열과 매칭하거나 직접 고정 텍스트를 입력할 수 있습니다."/>
                                        </DockPanel>

                                        <!-- 엑셀 파일 로드 상태 뱃지 (로드된 파일명 표시) -->
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding LoadedExcelFileName, StringFormat='📄 {0}'}" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Records.Count, StringFormat='총 {0}행'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#166534" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- 1. 엑셀 파일이 실제로 로드되어 완벽히 연동되었을 때 (초록색 뱃지) -->
                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,8" Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔗 " FontSize="11"/>
                                                    <TextBlock Text="엑셀 데이터 연동됨 (행 탐색 시 실시간 반영)" FontSize="10.5" Foreground="#047857" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedElementEffectivePreviewText, StringFormat='현재 행 미리보기: {0}'}" FontSize="11" Foreground="#065F46" FontWeight="SemiBold" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. 컬럼을 지정했으나 아직 엑셀 파일을 불러오지 않았을 때 (대기 안내 뱃지) -->
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,8" Visibility="{Binding IsSelectedElementExcelPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <TextBlock Text="💡 " FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedElementExcelColumn, StringFormat='{}{0}열로 매핑 대기 중입니다. [📁 엑셀 열기]로 파일을 불러오세요.'}" FontSize="10.5" Foreground="#1D4ED8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- A. 엑셀 미연동: 자유롭게 직접 편집 가능한 텍스트 상자 -->
                                        <TextBox x:Name="TxtInspectorContent" 
                                                 Visibility="{Binding IsSelectedElementExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Text="{Binding SelectedElementContent, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="NaN" MinHeight="50" MaxHeight="110" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 Padding="8,5" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Background="#FFFFFF" 
                                                 BorderBrush="#2563EB" BorderThickness="1.5" Style="{StaticResource ModernTextBoxStyle}"
                                                 ToolTip="라벨에 인쇄될 텍스트나 데이터를 직접 입력하세요 (Enter: 줄바꿈)"/>

                                        <!-- B. 엑셀 연동: 텍스트 내용 수정 차단 & 실시간 엑셀 행 미리보기 잠금 표시 -->
                                        <Border Visibility="{Binding IsSelectedElementExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="10,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="엑셀 연동 중 (직접 수정 불가)" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="데이터 소스를 '(직접 입력)'으로 변경 시 수정 가능" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBox Text="{Binding SelectedElementEffectivePreviewText, Mode=OneWay}" 
                                                         IsReadOnly="True" IsEnabled="False"
                                                         Background="#EDF2F7" Foreground="#334155"
                                                         Height="NaN" MinHeight="88" MaxHeight="180" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                         Padding="8,6" FontSize="13" FontWeight="Bold" BorderThickness="0"
                                                         ToolTip="엑셀 행의 데이터가 라벨에 실시간 반영되고 있습니다."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- C. 인쇄 후 내용 유지(Keep) / 자동 초기화 옵션 (1줄 컴팩트) -->
                                        <CheckBox IsChecked="{Binding SelectedElementIsResetAfterPrint, Mode=TwoWay}"
                                                  Margin="2,6,0,0" VerticalAlignment="Center" Cursor="Hand"
                                                  ToolTip="미체크 시 인쇄 후에도 라벨 내용이 계속 유지되며, 체크 시 1회 인쇄 후 입력창이 자동으로 비워져 다음 새 내용을 빠르게 입력할 수 있습니다.">
                                            <TextBlock Text="인쇄 후 내용 자동 초기화 (지움)" FontSize="11.5" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- 1-1. 일시(DATE_TIME) 전용 서식 및 자동 업데이트 옵션 -->
                                <Border Visibility="{Binding IsSelectedElementDateTime, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#16A34A"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🕒 일시 표시 양식 &amp; 자동 업데이트" FontWeight="Bold" FontSize="13" Foreground="#166534"/>
                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="5,1.5" Margin="6,0,0,0">
                                                    <TextBlock Text="실시간 반영" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 날짜/시간 서식 드롭다운 -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="일시 양식" Width="68" FontSize="12" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding DateTimeFormatOptions}"
                                                      SelectedValue="{Binding SelectedElementDateTimeFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Format"
                                                      DisplayMemberPath="DisplayText"
                                                      Height="32" FontSize="12" VerticalContentAlignment="Center"
                                                      ToolTip="출력할 날짜/시간의 표시 양식을 선택합니다."/>
                                        </DockPanel>

                                        <!-- 인쇄 시 자동 업데이트 체크박스 -->
                                        <CheckBox IsChecked="{Binding SelectedElementAutoUpdateDate, Mode=TwoWay}" 
                                                  FontSize="12" FontWeight="SemiBold" Foreground="#14532D" Margin="2,4,0,2"
                                                  ToolTip="체크 시 라벨을 인쇄하거나 미리보기 할 때 현재 시각으로 자동 갱신됩니다.">
                                            <TextBlock Text="인쇄 시 현재 날짜/시간으로 자동 업데이트" VerticalAlignment="Center"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- 1-2. 연속 순번(일련번호) 설정 카드 (텍스트/바코드/QR코드 공통) -->
                                <Border Visibility="{Binding IsSelectedElementSerialCapable, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.2" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding SelectedElementIsSerial, Mode=TwoWay}" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Cursor="Hand" ToolTip="체크 시 인쇄 매수마다 번호가 자동으로 증가합니다.">
                                                <TextBlock Text="🔢 연속 순번 (일련번호) 사용" VerticalAlignment="Center"/>
                                            </CheckBox>
                                            <TextBlock Text="{Binding SelectedElementSerialPreview}" Visibility="{Binding SelectedElementIsSerial, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <StackPanel Visibility="{Binding SelectedElementIsSerial, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock Text="접두" Width="30" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SelectedElementSerialPrefix, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11.5" Padding="5,2" VerticalContentAlignment="Center" BorderBrush="#93C5FD" ToolTip="번호 앞 문자 (예: SN-)"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="2">
                                                    <TextBlock Text="접미" Width="30" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SelectedElementSerialSuffix, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11.5" Padding="5,2" VerticalContentAlignment="Center" BorderBrush="#93C5FD" ToolTip="번호 뒤 문자 (예: 호)"/>
                                                </DockPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock Text="시작" Width="28" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SelectedElementSerialStartNumber, UpdateSourceTrigger=LostFocus}" Height="26" FontSize="11.5" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#93C5FD" ToolTip="시작 번호"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="2">
                                                    <TextBlock Text="증가" Width="28" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SelectedElementSerialStep, UpdateSourceTrigger=LostFocus}" Height="26" FontSize="11.5" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#93C5FD" ToolTip="매수당 증가값"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="4">
                                                    <TextBlock Text="자릿수" Width="36" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SelectedElementSerialDigits, UpdateSourceTrigger=LostFocus}" Height="26" FontSize="11.5" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#93C5FD" ToolTip="0으로 채울 자릿수 (예: 4 -> 0001)"/>
                                                </DockPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. 글자 간격 및 형태 (텍스트 및 일시 요소일 때) -->
                                <Border Visibility="{Binding IsSelectedElementText, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- 자간 / 장평 / 줄간격 (글자간격) 정밀 조절 -->
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="📐 글자 간격 및 형태 (고급)" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Command="{Binding ResetTextSpacingCommand}" Content="↺ 초기화" HorizontalAlignment="Right" Padding="6,1" FontSize="10" Foreground="#64748B" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="자간 0.0, 장평 100%, 줄간격 1.0 기본값으로 리셋"/>
                                            </DockPanel>

                                            <!-- 행 1: 자간(글자간격) & 장평 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 자간(글자간격) Stepper -->
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock Text="자간" Width="26" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="-" Command="{Binding StepLetterSpacingCommand}" CommandParameter="-0.05" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="자간 0.05 em 감소"/>
                                                    <Button Content="+" Command="{Binding StepLetterSpacingCommand}" CommandParameter="0.05" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="자간 0.05 em 증가"/>
                                                    <TextBox Text="{Binding SelectedElementLetterSpacing, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.00}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="자간 / 글자간격 (em 단위, 기본 0.00)"/>
                                                </DockPanel>
                                                <!-- 장평 Stepper -->
                                                <DockPanel Grid.Column="2">
                                                    <TextBlock Text="장평" Width="26" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="-" Command="{Binding StepFontScaleXCommand}" CommandParameter="-5" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="장평 5% 감소"/>
                                                    <Button Content="+" Command="{Binding StepFontScaleXCommand}" CommandParameter="5" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="장평 5% 증가"/>
                                                    <TextBox Text="{Binding SelectedElementFontScaleX, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="장평 (글자 가로 비율 %, 기본 100%)"/>
                                                </DockPanel>
                                            </Grid>

                                            <!-- 행 2: 줄간격 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 줄간격 Stepper -->
                                                <DockPanel Grid.Column="0">
                                                    <TextBlock Text="줄간격" Width="36" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="-" Command="{Binding StepLineSpacingCommand}" CommandParameter="-0.1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="줄간격 0.1배 감소"/>
                                                    <Button Content="+" Command="{Binding StepLineSpacingCommand}" CommandParameter="0.1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="줄간격 0.1배 증가"/>
                                                    <TextBox Text="{Binding SelectedElementLineSpacing, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.0}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="줄간격 (행간 배수, 기본 1.0배)"/>
                                                </DockPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3. 바코드 규격 설정 (바코드 / QR일 때) -->
                                <Border Visibility="{Binding IsSelectedElementBarcode, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🏷️ 바코드 규격 설정" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="타입" Width="55" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableBarcodeFormats}" SelectedItem="{Binding SelectedElementBarcodeType}" Height="28" FontSize="12" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="값 표시" Width="55" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableBarcodeTextPositions}" 
                                                      SelectedValue="{Binding SelectedElementBarcodeTextPosition}" 
                                                      SelectedValuePath="Code" 
                                                      DisplayMemberPath="Name" 
                                                      Height="28" FontSize="12" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 도형 및 선 설정 (도형 / 선일 때) -->
                                <Border Visibility="{Binding IsSelectedElementShapeOrLine, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📐 도형 / 선 서식" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- 도형일 때: 5열 그리드 배열 형태로 17종 도형 표시 -->
                                        <StackPanel Visibility="{Binding IsSelectedElementShape, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="도형 종류 선택" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <CheckBox Content="도형 내부 채우기 (Fill)" 
                                                              IsChecked="{Binding SelectedElementIsFilled}" 
                                                              Style="{StaticResource ModernCheckBoxStyle}" 
                                                              FontSize="12" 
                                                              Foreground="{StaticResource TextPrimaryBrush}" 
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,8,0"
                                                              ToolTip="도형 내부를 채웁니다."/>
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                                        <TextBlock Text="{Binding SelectedElementShapeName}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3">
                                                <ListBox ItemsSource="{Binding AvailableShapeTypes}" 
                                                         SelectedValue="{Binding SelectedElementShapeType}" 
                                                         SelectedValuePath="Code" 
                                                         Background="Transparent" 
                                                         BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="5"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Margin" Value="2"/>
                                                            <Setter Property="BorderThickness" Value="1.2"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" 
                                                                                Background="{TemplateBinding Background}" 
                                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                                CornerRadius="6" 
                                                                                Padding="2,4"
                                                                                SnapsToDevicePixels="True">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.8"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding DisplayText}">
                                                                <TextBlock Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="54"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- 선일 때: 그리드 배열 형태로 7종 선 스타일 표시 -->
                                        <StackPanel Visibility="{Binding IsSelectedElementLine, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="선 종류 선택" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SelectedElementLineName}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                </Border>
                                            </DockPanel>

                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3">
                                                <ListBox ItemsSource="{Binding AvailableLineStyles}" 
                                                         SelectedValue="{Binding SelectedElementLineStyle}" 
                                                         SelectedValuePath="Code" 
                                                         Background="Transparent" 
                                                         BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="4"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Margin" Value="2"/>
                                                            <Setter Property="BorderThickness" Value="1.2"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" 
                                                                                Background="{TemplateBinding Background}" 
                                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                                CornerRadius="6" 
                                                                                Padding="4,6"
                                                                                SnapsToDevicePixels="True">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.8"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding DisplayText}">
                                                                <TextBlock Text="{Binding Icon}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="68"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- 선 두께 Numeric Up/Down Stepper -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="선 두께" Width="60" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Button Content="-" Command="{Binding StepLineWidthCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26" Margin="0,0,2,0" ToolTip="선 두께 1px 감소"/>
                                            <Button Content="+" Command="{Binding StepLineWidthCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="26" Margin="2,0,0,0" ToolTip="선 두께 1px 증가"/>
                                            <TextBlock DockPanel.Dock="Right" Text="px" Margin="4,0,4,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding SelectedElementLineWidth, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 5. 표(Table) 전용 설정 및 셀 텍스트 편집기 -->
                                <Border Visibility="{Binding IsSelectedElementTable, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📊 표 규격 및 격자선" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                        <!-- 행 수 / 열 수 Stepper -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 행 수 Stepper -->
                                            <DockPanel Grid.Column="0">
                                                <TextBlock Text="행" Width="22" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepTableRowsCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="행 1개 감소"/>
                                                <Button Content="+" Command="{Binding StepTableRowsCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="행 1개 추가"/>
                                                <TextBox Text="{Binding SelectedElementTableRows, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                            </DockPanel>
                                            <!-- 열 수 Stepper -->
                                            <DockPanel Grid.Column="2">
                                                <TextBlock Text="열" Width="22" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepTableColumnsCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,2,0" ToolTip="열 1개 감소"/>
                                                <Button Content="+" Command="{Binding StepTableColumnsCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="2,0,0,0" ToolTip="열 1개 추가"/>
                                                <TextBox Text="{Binding SelectedElementTableColumns, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                            </DockPanel>
                                        </Grid>

                                        <!-- 외곽선 두께/타입 & 내부선 두께/타입 설정 -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="95"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="외곽선" Width="44" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <DockPanel Grid.Column="1">
                                                <Button Content="-" Command="{Binding StepTableLineWidthCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="0,0,2,0" ToolTip="외곽선 두께 0.5px 감소"/>
                                                <Button Content="+" Command="{Binding StepTableLineWidthCommand}" CommandParameter="0.5" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="2,0,0,0" ToolTip="외곽선 두께 0.5px 증가"/>
                                                <TextBox Text="{Binding SelectedElementTableLineWidth, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="표 외곽 테두리 두께 (px)"/>
                                            </DockPanel>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableTableLineStyles}"
                                                      SelectedValue="{Binding SelectedElementTableOuterLineStyle}"
                                                      SelectedValuePath="Code"
                                                      DisplayMemberPath="Name"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center"
                                                      ToolTip="표 외곽 테두리 선 스타일 선택"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="95"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="내부선" Width="44" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <DockPanel Grid.Column="1">
                                                <Button Content="-" Command="{Binding StepTableInnerLineWidthCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="0,0,2,0" ToolTip="내부선 두께 0.5px 감소"/>
                                                <Button Content="+" Command="{Binding StepTableInnerLineWidthCommand}" CommandParameter="0.5" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="2,0,0,0" ToolTip="내부선 두께 0.5px 증가"/>
                                                <TextBox Text="{Binding SelectedElementTableInnerLineWidth, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="표 내부 가로/세로선 두께 (px)"/>
                                            </DockPanel>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableTableLineStyles}"
                                                      SelectedValue="{Binding SelectedElementTableInnerLineStyle}"
                                                      SelectedValuePath="Code"
                                                      DisplayMemberPath="Name"
                                                      Height="26" FontSize="11" VerticalContentAlignment="Center"
                                                      ToolTip="표 내부 가로/세로선 스타일 선택"/>
                                        </Grid>

                                        <!-- 셀 내부 여백 Stepper & 헤더 강조 -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 셀 내부 여백(간격) Stepper -->
                                            <DockPanel Grid.Column="0">
                                                <TextBlock Text="여백(mm)" Width="54" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Content="-" Command="{Binding StepTableCellPaddingCommand}" CommandParameter="-0.5" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="0,0,2,0" ToolTip="셀 내부 여백 0.5mm 감소"/>
                                                <Button Content="+" Command="{Binding StepTableCellPaddingCommand}" CommandParameter="0.5" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26" Margin="2,0,0,0" ToolTip="셀 내부 여백 0.5mm 증가"/>
                                                <TextBox Text="{Binding SelectedElementTableCellPadding, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Height="26" FontSize="11.5" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" ToolTip="셀 테두리와 텍스트 사이의 내부 여백 (mm)"/>
                                            </DockPanel>
                                            <!-- 헤더 행 음영 강조 체크박스 -->
                                            <CheckBox Grid.Column="2" Content="첫 행 음영" IsChecked="{Binding SelectedElementTableIsFilled}" VerticalAlignment="Center" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11.5" ToolTip="표의 첫 번째 행(헤더)에 배경 음영을 채웁니다."/>
                                        </Grid>

                                        <!-- 균등 분할 버튼 -->
                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                            <Button Content="↔ 열 너비 균등" Command="{Binding EvenTableColumnsCommand}" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11" Margin="0,0,3,0" ToolTip="모든 열의 폭을 균등하게 재조정합니다. (캔버스에서 표 내부 세로선을 드래그하여 개별 조절 가능)"/>
                                            <Button Content="↕ 행 높이 균등" Command="{Binding EvenTableRowsCommand}" Style="{StaticResource ModernAlignBtnStyle}" Height="26" FontSize="11" Margin="3,0,0,0" ToolTip="모든 행의 높이를 균등하게 재조정합니다. (캔버스에서 표 내부 가로선을 드래그하여 개별 조절 가능)"/>
                                        </UniformGrid>

                                        <!-- 표 전체 텍스트 정렬 버튼 (좌측 / 중앙 / 우측) -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="텍스트 정렬" Width="64" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <UniformGrid Columns="3">
                                                <Button Click="OnSelectedAlignLeftClick" Style="{StaticResource ModernAlignBtnStyle}" Height="28" ToolTip="표 내부 텍스트 좌측 정렬">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Viewbox Width="11" Height="11" Margin="0,0,4,0">
                                                            <Canvas Width="16" Height="16">
                                                                <Line X1="2" Y1="3.5" X2="14" Y2="3.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="2" Y1="8" X2="9.5" Y2="8" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="2" Y1="12.5" X2="13" Y2="12.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="좌측" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="OnSelectedAlignCenterClick" Style="{StaticResource ModernAlignBtnStyle}" Height="28" ToolTip="표 내부 텍스트 가운데 정렬">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Viewbox Width="11" Height="11" Margin="0,0,4,0">
                                                            <Canvas Width="16" Height="16">
                                                                <Line X1="2" Y1="3.5" X2="14" Y2="3.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="4.5" Y1="8" X2="11.5" Y2="8" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="2.5" Y1="12.5" X2="13.5" Y2="12.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="중앙" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="OnSelectedAlignRightClick" Style="{StaticResource ModernAlignBtnStyle}" Height="28" ToolTip="표 내부 텍스트 우측 정렬">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Viewbox Width="11" Height="11" Margin="0,0,4,0">
                                                            <Canvas Width="16" Height="16">
                                                                <Line X1="2" Y1="3.5" X2="14" Y2="3.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="6.5" Y1="8" X2="14" Y2="8" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="3" Y1="12.5" X2="14" Y2="12.5" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="우측" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                        </DockPanel>

                                        <Separator Background="#E2E8F0" Margin="0,4,0,8"/>

                                        <!-- 행/열별 글꼴 및 서식 일괄 설정 -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="🔤 행/열별 글꼴 및 서식 설정" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="서식 초기화" Command="{Binding ResetTableFontsCommand}"
                                                    Style="{StaticResource ModernButtonStyle}" Background="#64748B" Foreground="White"
                                                    Height="20" Padding="6,0" FontSize="9.5" ToolTip="표의 모든 행/열/셀 개별 서식을 초기화하고 기본 폰트로 복원합니다."/>
                                        </DockPanel>

                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                            <StackPanel>
                                                <!-- 서식 옵션: 글자 크기, 굵게, 정렬 -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 크기 Stepper -->
                                                    <DockPanel Grid.Column="0">
                                                        <TextBlock Text="크기" Width="24" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="-" Command="{Binding StepTableTargetFontSizeCommand}" CommandParameter="-1" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="24" Margin="0,0,2,0" ToolTip="글자 크기 1pt 감소"/>
                                                        <Button Content="+" Command="{Binding StepTableTargetFontSizeCommand}" CommandParameter="1" DockPanel.Dock="Right" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="24" Margin="2,0,0,0" ToolTip="글자 크기 1pt 증가"/>
                                                        <TextBox Text="{Binding TableTargetFontSize, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Height="24" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                                    </DockPanel>

                                                    <!-- 굵게 체크박스 -->
                                                    <CheckBox Grid.Column="2" Content="굵게(B)" IsChecked="{Binding TableTargetIsBold}" VerticalAlignment="Center" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11" FontWeight="Bold"/>

                                                    <!-- 정렬 콤보 -->
                                                    <ComboBox Grid.Column="4" SelectedValue="{Binding TableTargetAlignment}" SelectedValuePath="Tag" Height="24" FontSize="10.5" Width="55" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="가운데" Tag="CENTER"/>
                                                        <ComboBoxItem Content="왼쪽" Tag="LEFT"/>
                                                        <ComboBoxItem Content="오른쪽" Tag="RIGHT"/>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- 적용 버튼 영역: 특정 행 적용 / 특정 열 적용 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 특정 행 일괄 적용 -->
                                                    <DockPanel Grid.Column="0">
                                                        <ComboBox ItemsSource="{Binding AvailableTableRows}"
                                                                  SelectedIndex="{Binding SelectedTableRowIndex, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name"
                                                                  Height="24" FontSize="10.5" Width="52" Margin="0,0,4,0"/>
                                                        <Button Content="행 적용" Command="{Binding ApplyTableRowFontCommand}"
                                                                Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="24" FontSize="10.5" FontWeight="SemiBold"
                                                                ToolTip="선택한 행의 모든 셀에 위 서식을 적용합니다."/>
                                                    </DockPanel>

                                                    <!-- 특정 열 일괄 적용 -->
                                                    <DockPanel Grid.Column="2">
                                                        <ComboBox ItemsSource="{Binding AvailableTableColumns}"
                                                                  SelectedIndex="{Binding SelectedTableColumnIndex, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name"
                                                                  Height="24" FontSize="10.5" Width="52" Margin="0,0,4,0"/>
                                                        <Button Content="열 적용" Command="{Binding ApplyTableColumnFontCommand}"
                                                                Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="24" FontSize="10.5" FontWeight="SemiBold"
                                                                ToolTip="선택한 열의 모든 셀에 위 서식을 적용합니다."/>
                                                    </DockPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 셀 텍스트 및 엑셀 컬럼 매핑 편집기 (행/열 표 형태) -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="✏️ 표 각 셀 데이터 및 엑셀 연동" FontWeight="Bold" FontSize="12" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                            <TextBlock Text="(셀별 엑셀 열 매핑 가능)" FontSize="10.5" Foreground="#047857" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="300">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SelectedElementTableCells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="{Binding DataContext.SelectedElementTableColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="3" Padding="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="5">
                                                                <StackPanel>
                                                                    <!-- 셀 라벨, 크기/굵기 조절 및 해제 버튼 -->
                                                                    <DockPanel Margin="0,0,0,2">
                                                                        <TextBlock Text="{Binding CellLabel}" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                                        
                                                                        <Button DockPanel.Dock="Right" Content="✕" 
                                                                                Command="{Binding DataContext.UnlinkTableCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding IsExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White"
                                                                                Height="18" Width="18" Padding="0" FontSize="9" FontWeight="Bold" Margin="3,0,0,0" ToolTip="해당 셀의 엑셀 연동을 해제합니다."/>

                                                                        <!-- 셀 개별 서식 빠른 조절 버튼들 -->
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Button Content="-" Command="{Binding DecreaseFontSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="14" Height="17" Margin="0,0,1,0" FontSize="8.5" ToolTip="이 셀 글자크기 1pt 감소"/>
                                                                            <TextBlock Text="{Binding CellFontSize, StringFormat='{}{0:0}'}" FontSize="9" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="1,0"/>
                                                                            <Button Content="+" Command="{Binding IncreaseFontSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="14" Height="17" Margin="1,0,2,0" FontSize="8.5" ToolTip="이 셀 글자크기 1pt 증가"/>
                                                                            <ToggleButton Content="B" IsChecked="{Binding CellIsBold}" Style="{StaticResource ModernToggleBtnStyle}" Width="16" Height="17" FontSize="8.5" FontWeight="Bold" Margin="0,0,2,0" ToolTip="이 셀 굵게 토글"/>
                                                                            <ToggleButton Content="좌" IsChecked="{Binding IsAlignLeft, Mode=OneWay}" Command="{Binding SetCellAlignCommand}" CommandParameter="LEFT" Style="{StaticResource ModernToggleBtnStyle}" Width="16" Height="17" FontSize="8" Margin="0,0,1,0" ToolTip="이 셀 텍스트 좌측 정렬"/>
                                                                            <ToggleButton Content="중" IsChecked="{Binding IsAlignCenter, Mode=OneWay}" Command="{Binding SetCellAlignCommand}" CommandParameter="CENTER" Style="{StaticResource ModernToggleBtnStyle}" Width="16" Height="17" FontSize="8" Margin="0,0,1,0" ToolTip="이 셀 텍스트 가운데 정렬"/>
                                                                            <ToggleButton Content="우" IsChecked="{Binding IsAlignRight, Mode=OneWay}" Command="{Binding SetCellAlignCommand}" CommandParameter="RIGHT" Style="{StaticResource ModernToggleBtnStyle}" Width="16" Height="17" FontSize="8" Margin="0,0,1,0" ToolTip="이 셀 텍스트 우측 정렬"/>
                                                                        </StackPanel>
                                                                    </DockPanel>

                                                                    <!-- 엑셀 컬럼 선택 콤보박스 -->
                                                                    <ComboBox ItemsSource="{Binding AvailableExcelOptions}"
                                                                              SelectedValue="{Binding SelectedExcelColumn, UpdateSourceTrigger=PropertyChanged}"
                                                                              SelectedValuePath="Code"
                                                                              DisplayMemberPath="Name"
                                                                              Height="23" FontSize="10.5" Margin="0,0,0,3"
                                                                              ToolTip="엑셀 열과 연동하거나 직접 입력을 선택하세요."/>

                                                                    <!-- 1. 미연동 시: 직접 텍스트 입력창 (줄바꿈 허용) -->
                                                                    <TextBox Visibility="{Binding IsExcelNotLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                             FontSize="11.5" 
                                                                             Height="NaN" MinHeight="56"
                                                                             MaxHeight="120"
                                                                             AcceptsReturn="True"
                                                                             TextWrapping="Wrap"
                                                                             VerticalScrollBarVisibility="Auto"
                                                                             VerticalContentAlignment="Top" 
                                                                             Padding="4,2" 
                                                                             BorderBrush="#CBD5E1"
                                                                             BorderThickness="1"
                                                                             Background="#FFFFFF"
                                                                             ToolTip="셀에 인쇄될 고정 텍스트를 입력하세요. Enter로 줄바꿈이 가능합니다."/>

                                                                    <!-- 2. 엑셀 연동 시: 연동 뱃지 및 실시간 미리보기 값 -->
                                                                    <Border Visibility="{Binding IsExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                                        <TextBlock Text="{Binding EffectivePreviewText, StringFormat='🔗 {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#047857" TextTrimming="CharacterEllipsis" ToolTip="엑셀 파일에서 읽어온 실시간 데이터입니다."/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 5. 빠른 액션 (복제 / 삭제) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding CopySelectedCommand}" Focusable="False" Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" Height="38" Cursor="Hand" ToolTip="선택한 요소 복제 (Ctrl+D)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#E2E8F0"/>
                                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#94A3B8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#CBD5E1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📋" FontSize="13.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="요소 복제" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding DeleteSelectedElementCommand}" Focusable="False" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Height="38" Cursor="Hand" ToolTip="선택한 요소 삭제 (Del)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#FEE2E2"/>
                                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#F87171"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#FECACA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🗑️" FontSize="13.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="요소 삭제" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 1-B. [라벨 정보 & 엑셀 연동 및 인쇄 통합 패널] (요소 미선택 시 활성화) -->
                        <ScrollViewer Visibility="{Binding HasNoSelectedElement, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,10">

                                <!-- 1. 라벨 규격 및 회전 콤팩트 액션 바 -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏷️ 용지 설정" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding LabelRotationText}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="🔄 90° 회전" Command="{Binding Rotate90Command}" Style="{StaticResource MiniStepBtnStyle}" Height="24" Padding="8,0" FontSize="11" Margin="0,0,5,0" ToolTip="라벨 용지 방향 90도 회전"/>
                                            <Button Content="규격 변경" Click="OnNewTemplateWizardClick" Style="{StaticResource MiniStepBtnStyle}" Height="24" Padding="8,0" FontSize="11" FontWeight="SemiBold" ToolTip="라벨 용지 규격 변경"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 2. 직접 입력 항목 관리 (1~8열) Expander -->
                                <Expander Header="📝 직접 입력 항목 관리 (1~8열)" IsExpanded="True" Style="{StaticResource ModernCardExpanderStyle}" Margin="0,0,0,10">
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="💡 캔버스 클릭 수정 또는 아래 입력 (Enter: 다음 열 / 마지막 열: 인쇄)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                        <!-- 1열 -->
                                        <Border Margin="0,0,0,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Visibility="{Binding IsCol1Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="1열" Width="28" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="2,0,0,0" Visibility="{Binding IsCol1ExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="🔗 엑셀 연동" FontSize="9.5" FontWeight="Bold" Foreground="#047857"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ComboBox ItemsSource="{Binding AvailableExcelColumnOptions}"
                                                                  SelectedValue="{Binding Col1ExcelColumn}"
                                                                  SelectedValuePath="Code"
                                                                  DisplayMemberPath="Name"
                                                                  Height="22" FontSize="10.5" Width="105" VerticalContentAlignment="Center"
                                                                  ToolTip="1열에 매핑할 엑셀 컬럼을 변경합니다."/>
                                                        <Button Content="✕ 해제" Command="{Binding UnlinkColumnExcelCommand}" CommandParameter="1"
                                                                Visibility="{Binding IsCol1ExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="4,0" FontSize="10" Foreground="#DC2626" Margin="4,0,0,0"
                                                                ToolTip="1열의 엑셀 연동을 해제하고 직접 입력 모드로 전환합니다."/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBox x:Name="TxtCol1" Tag="0" PreviewKeyDown="OnInputPreviewKeyDown"
                                                         IsEnabled="{Binding IsCol1DirectInputEnabled}"
                                                         Text="{Binding Col1EffectiveText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Height="NaN" MinHeight="44" MaxHeight="160" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12.5" Padding="8,6" BorderBrush="#CBD5E1"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 2열 -->
                                        <Border Margin="0,0,0,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Visibility="{Binding IsCol2Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="2열" Width="28" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="2,0,0,0" Visibility="{Binding IsCol2ExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="🔗 엑셀 연동" FontSize="9.5" FontWeight="Bold" Foreground="#047857"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ComboBox ItemsSource="{Binding AvailableExcelColumnOptions}"
                                                                  SelectedValue="{Binding Col2ExcelColumn}"
                                                                  SelectedValuePath="Code"
                                                                  DisplayMemberPath="Name"
                                                                  Height="22" FontSize="10.5" Width="105" VerticalContentAlignment="Center"
                                                                  ToolTip="2열에 매핑할 엑셀 컬럼을 변경합니다."/>
                                                        <Button Content="✕ 해제" Command="{Binding UnlinkColumnExcelCommand}" CommandParameter="2"
                                                                Visibility="{Binding IsCol2ExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="4,0" FontSize="10" Foreground="#DC2626" Margin="4,0,0,0"
                                                                ToolTip="2열의 엑셀 연동을 해제하고 직접 입력 모드로 전환합니다."/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBox x:Name="TxtCol2" Tag="1" PreviewKeyDown="OnInputPreviewKeyDown"
                                                         IsEnabled="{Binding IsCol2DirectInputEnabled}"
                                                         Text="{Binding Col2EffectiveText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Height="NaN" MinHeight="68" MaxHeight="160" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12.5" Padding="8,6" BorderBrush="#CBD5E1"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 3열 -->
                                        <Border Margin="0,0,0,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Visibility="{Binding IsCol3Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
