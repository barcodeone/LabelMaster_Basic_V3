                        </ScrollViewer>

                        <!-- Bottom Action Bar (단건 인쇄 매수 컨트롤 및 출력 버튼) -->
                        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,8,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.2">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="인쇄 매수:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                            <Button Content="-" Command="{Binding DecreaseSinglePrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="28" FontSize="14" FontWeight="Bold"/>
                                            <TextBox Text="{Binding SinglePrintCopies, UpdateSourceTrigger=PropertyChanged}" Width="44" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13.5" FontWeight="Bold" BorderThickness="0" Background="Transparent" Margin="2,0"/>
                                            <Button Content="+" Command="{Binding IncreaseSinglePrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="28" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <TextBlock Text="매" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="🖨️ 단건 인쇄 (Enter)" Command="{Binding SinglePrintCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="Bold" FontSize="14.5" Height="40" Padding="24,0" Style="{StaticResource ModernButtonStyle}" ToolTip="현재 입력된 데이터를 인쇄합니다 (미인증 프린터인 경우 인쇄가 제한됩니다)."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
