                </TabItem>

                <!-- ========================================================== -->
                <!-- TAB 2: 📊 2. 엑셀 데이터 관리 & 인쇄                       -->
                <!-- ========================================================== -->
                <TabItem Header=" 📊 2. 엑셀 데이터 관리 &amp; 인쇄 " FontSize="13" FontWeight="SemiBold" Padding="14,6">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. 깔끔한 상단 툴바: 엑셀 열기/저장 + 선택 삭제 + 컬럼 추가/삭제 -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.2">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📁 엑셀 열기" Command="{Binding ImportFromExcelCommand}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Height="30" Padding="10,0" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" ToolTip="엑셀 파일(*.xlsx)을 열거나, 파일 탐색기에서 마우스로 끌어다 놓아도(드래그&amp;드롭) 바로 열립니다."/>
                                    <Button Content="💾 엑셀 저장" Command="{Binding ExportToExcelCommand}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Height="30" Padding="10,0" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" ToolTip="현재 목록 데이터를 엑셀 파일(*.xlsx)로 저장합니다."/>
                                    
                                    <Border Background="#CBD5E1" Width="1" Height="18" Margin="0,0,6,0"/>

                                    <Button Content="🗑️ 선택 삭제" Command="{Binding DeleteSelectedRecordCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}" Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Height="30" Padding="10,0" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" ToolTip="선택한 행 또는 체크된 항목을 삭제합니다."/>
                                    <Button Content="🧹 전체 비우기" Command="{Binding ClearRecordsCommand}" Style="{StaticResource MiniStepBtnStyle}" Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0" ToolTip="목록의 모든 데이터를 깨끗하게 비웁니다."/>

                                    <Border Background="#CBD5E1" Width="1" Height="18" Margin="0,0,6,0"/>
                                    
                                    <TextBlock Text="컬럼: " FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveColumnCount, StringFormat='{}{0}개'}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Content="➕" Command="{Binding AddColumnCommand}" ToolTip="새 컬럼 추가 (최대 8개)" Style="{StaticResource ModernButtonStyle}" Height="28" Width="28" Padding="0" FontSize="12" Margin="0,0,3,0"/>
                                    <Button Content="➖" Command="{Binding RemoveColumnCommand}" ToolTip="마지막 컬럼 삭제" Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Height="28" Width="28" Padding="0" FontSize="12"/>
                                </StackPanel>
                                
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,3" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding LoadedExcelFileName, StringFormat='📄 {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2. DataGrid Table with Double Click & Context Menu on Headers -->
                        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <DataGrid x:Name="MainDataGrid" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Background="Transparent" BorderThickness="0" RowHeight="30" FontSize="12.5" ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}" PreviewMouseDoubleClick="MainDataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonUp="MainDataGrid_PreviewMouseRightButtonUp">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🖨️ 선택 항목 출력" Command="{Binding ReprintSelectedRecordsCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ 선택 항목 삭제" Command="{Binding DeleteSelectedRecordCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}"/>
                                        <MenuItem Header="🧹 전체 목록 비우기" Command="{Binding ClearAllRecordsCommand}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <!-- 체크박스 컬럼 -->
                                    <DataGridCheckBoxColumn Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="44">
                                        <DataGridCheckBoxColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Content" Value="선택"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="12.5"/>
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="Padding" Value="4,5"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGridCheckBoxColumn.HeaderStyle>
                                    </DataGridCheckBoxColumn>
                                    
                                    <!-- 순번 (No.) 컬럼 -->
                                    <DataGridTextColumn Header="순번" Binding="{Binding Index}" Width="50" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="12.5"/>
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="Padding" Value="4,5"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>

                                    <!-- 데이터 컬럼 1 ~ 8 -->
                                    <DataGridTextColumn x:Name="GridCol1" Header="{Binding DataContext.Column1Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col1, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol2" Header="{Binding DataContext.Column2Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col2, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol3" Header="{Binding DataContext.Column3Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col3, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol4" Header="{Binding DataContext.Column4Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col4, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol5" Header="{Binding DataContext.Column5Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col5, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol6" Header="{Binding DataContext.Column6Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col6, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol7" Header="{Binding DataContext.Column7Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col7, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                    <DataGridTextColumn x:Name="GridCol8" Header="{Binding DataContext.Column8Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col8, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 3. 완벽 반응형 2단 하단 인쇄 툴바: (상단) 옵션 설정 & 건수 / (하단) 3대 인쇄 버튼 균등 배치 -->
                        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="10,8" Margin="0,6,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 1단: 인쇄 옵션 (매수 + 구간) & 총 건수 -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 인쇄 매수 설정 -->
                                        <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="매수:" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0"/>
                                                <Button Content="-" Command="{Binding DecreaseExcelPrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="13" FontWeight="Bold"/>
                                                <TextBox Text="{Binding ExcelPrintCopies, UpdateSourceTrigger=PropertyChanged}" Width="32" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" BorderThickness="0" Background="Transparent" Margin="2,0"/>
                                                <Button Content="+" Command="{Binding IncreaseExcelPrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="13" FontWeight="Bold" Margin="0,0,4,0"/>
                                                <TextBlock Text="매" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 출력 구간 설정 -->
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="구간:" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,4,0"/>
                                                <Button Content="-" Command="{Binding DecreasePrintRangeStartCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="13" FontWeight="Bold"/>
                                                <TextBox Text="{Binding PrintRangeStart, UpdateSourceTrigger=PropertyChanged}" Width="32" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" BorderThickness="0" Background="Transparent" Margin="2,0"/>
                                                <Button Content="+" Command="{Binding IncreasePrintRangeStartCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="13" FontWeight="Bold" Margin="0,0,4,0"/>

                                                <TextBlock Text="~" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" Margin="2,0"/>

                                                <Button Content="-" Command="{Binding DecreasePrintRangeEndCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="13" FontWeight="Bold" Margin="4,0,0,0"/>
                                                <TextBox Text="{Binding PrintRangeEnd, UpdateSourceTrigger=PropertyChanged}" Width="32" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" BorderThickness="0" Background="Transparent" Margin="2,0"/>
                                                <Button Content="+" Command="{Binding IncreasePrintRangeEndCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="22" Height="24" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 총 데이터 건수 표시 (우측) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Records.Count, StringFormat='총 {0}건'}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 2단: 3대 인쇄 실행 버튼 (균등 분할 1:1:1 배치로 절대 가려지지 않음) -->
                                <UniformGrid Grid.Row="1" Columns="3">
                                    <Button Content="🖨️ 선택 출력" Command="{Binding ReprintSelectedRecordsCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="36" FontSize="13" FontWeight="Bold" Margin="0,0,4,0" ToolTip="선택한 행 또는 체크된 항목만 인쇄합니다 (미인증 시 비활성화)."/>
                                    <Button Content="📑 구간 출력" Command="{Binding PrintRangeCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="#4F46E5" Height="36" FontSize="13" FontWeight="Bold" Margin="2,0,2,0" ToolTip="지정한 시작~끝 번호 범위의 데이터를 인쇄합니다 (미인증 시 비활성화)."/>
                                    <Button Content="🚀 전체 출력" Command="{Binding PrintAllRecordsCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Height="36" FontSize="13" FontWeight="Bold" Margin="4,0,0,0" ToolTip="목록의 전체 데이터를 일괄 인쇄합니다 (미인증 시 비활성화)."/>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            </Grid>
        </Grid>

        <!-- 2. Status Bar -->
        <StatusBar Grid.Row="2" Background="White" Margin="0,6,0,0" Padding="8,4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding ConnectionInfo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
