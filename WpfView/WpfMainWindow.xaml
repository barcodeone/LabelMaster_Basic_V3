                                                        </Border>

                                                        <Button DockPanel.Dock="Left" Content="다음 ▶" Command="{Binding PreviewNextPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="52" Height="26" FontSize="11.5" Margin="0,0,4,0" ToolTip="다음 행"/>
                                                        <Button DockPanel.Dock="Left" Content="⏭" Command="{Binding PreviewLastPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="26" FontSize="11" ToolTip="마지막 행"/>
                                                    </DockPanel>
                                                    <TextBlock Text="💡 행을 이동하면 라벨에 해당 엑셀 행의 데이터가 실시간 표시됩니다." FontSize="10.5" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 엑셀 데이터 목록 테이블 (MainDataGrid) -->
                                            <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Height="150" Margin="0,0,0,4">
                                                <DataGrid x:Name="MainDataGrid" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Background="Transparent" BorderThickness="0" RowHeight="26" FontSize="11.5" ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}" PreviewMouseDoubleClick="MainDataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonUp="MainDataGrid_PreviewMouseRightButtonUp">
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="🖨️ 선택 항목 출력" Command="{Binding ReprintSelectedRecordsCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}"/>
                                                            <Separator/>
                                                            <MenuItem Header="🗑️ 선택 항목 삭제" Command="{Binding DeleteSelectedRecordCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}"/>
                                                            <MenuItem Header="🧹 전체 목록 비우기" Command="{Binding ClearAllRecordsCommand}"/>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <!-- 체크박스 컬럼 -->
                                                        <DataGridCheckBoxColumn Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="38"/>
                                                        <!-- 순번 -->
                                                        <DataGridTextColumn Header="No" Binding="{Binding Index}" Width="40" IsReadOnly="True"/>
                                                        <!-- 데이터 컬럼 1 ~ 8 -->
                                                        <DataGridTextColumn x:Name="GridCol1" Header="{Binding DataContext.Column1Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col1, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol2" Header="{Binding DataContext.Column2Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col2, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol3" Header="{Binding DataContext.Column3Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col3, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol4" Header="{Binding DataContext.Column4Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col4, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol5" Header="{Binding DataContext.Column5Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col5, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol6" Header="{Binding DataContext.Column6Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col6, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol7" Header="{Binding DataContext.Column7Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col7, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol8" Header="{Binding DataContext.Column8Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col8, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Border>

                                            <!-- 그리드 빠른 관리 바 -->
                                            <DockPanel Margin="0,2,0,0">
                                                <Button DockPanel.Dock="Left" Content="🗑️ 선택 삭제" Command="{Binding DeleteSelectedRecordCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Foreground="#DC2626" ToolTip="선택한 행 삭제"/>
                                                <Button DockPanel.Dock="Right" Content="🧹 비우기" Command="{Binding ClearRecordsCommand}" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" ToolTip="목록 비우기"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
            </Grid>
            </Grid>
            </Border>
        </Grid>

        <!-- 2. Status Bar (하단 페이지 시트 탭 + 상태 메시지 + 프린터 상태/선택) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측: 구글 시트 스타일 작은 페이지 탭 ([1P] [2P] [+] [⧉]) -->
                <Border x:Name="PageNavigatorBorder" Grid.Column="0" Focusable="True" FocusVisualStyle="{x:Null}" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4,2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="260">
                            <ItemsControl ItemsSource="{Binding TemplatePages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,3,0" Padding="9,3" CornerRadius="4" Cursor="Hand"
                                                AllowDrop="True"
                                                MouseLeftButtonDown="OnPageThumbnailMouseDown"
                                                MouseMove="OnPageThumbnailMouseMove"
                                                MouseLeftButtonUp="OnPageThumbnailMouseUp"
                                                DragOver="OnPageThumbnailDragOver"
                                                Drop="OnPageThumbnailDrop"
                                                ToolTip="{Binding PageNumber, StringFormat='{}{0}페이지 (클릭: 전환 / 드래그: 순서 변경 / Del: 삭제)'}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="1,1,1,2"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                                            <Setter Property="BorderThickness" Value="1,1,1,2.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="현재 페이지 복제" Command="{Binding DataContext.DuplicatePageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    <MenuItem Header="이 페이지 삭제" Click="OnDeletePageThumbnailClick" Tag="{Binding PageIndex}" IsEnabled="{Binding DataContext.HasMultiplePages, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PageNumber, StringFormat='{}{0}P'}" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <Button Content="✕"
                                                        Click="OnDeletePageThumbnailClick"
                                                        Tag="{Binding PageIndex}"
                                                        Width="14" Height="14"
                                                        Margin="5,0,0,0"
                                                        Padding="0"
                                                        FontSize="8.5" FontWeight="Bold"
                                                        Foreground="#64748B"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="이 페이지 삭제">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                        <Condition Binding="{Binding DataContext.HasMultiplePages, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="+" Command="{Binding AddPageCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="22" Height="22" Padding="0" Margin="2,0,2,0" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Background="Transparent" BorderThickness="0" ToolTip="새 빈 페이지 추가"/>
                        <Button Content="⧉" Command="{Binding DuplicatePageCommand}" Style="{StaticResource ModernAlignIconBtnStyle}" Width="22" Height="22" Padding="0" FontSize="12" FontWeight="Bold" Foreground="#475569" Background="Transparent" BorderThickness="0" ToolTip="현재 페이지 복제"/>
                    </StackPanel>
                </Border>

                <!-- 중앙: 상태 안내 메시지 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 우측: 프린터 상태 뱃지 + 설정 + 대시보드 + 연결정보 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Height="26" Padding="8,0" Margin="0,0,5,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="상태" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding PrinterStatusBadge}" Foreground="{Binding PrinterStatusColor}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding OpenPrinterSettingsCommand}" Style="{StaticResource ModernHeaderBtnStyle}" Background="#F8FAFC" BorderBrush="#BFDBFE" Foreground="#1D4ED8" Height="26" Padding="9,0" Margin="0,0,5,0" ToolTip="프린터 선택 및 하드웨어 설정창 열기 (연결, 농도, 속도, 용지 규격)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="설정" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnGoHomeClick" Style="{StaticResource ModernHeaderBtnStyle}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" Height="26" Padding="9,0" Margin="0,0,6,0" Cursor="Hand" ToolTip="초기 메인 화면(대시보드)으로 돌아갑니다">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="대시보드" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding ConnectionInfo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
