                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ComboBox ItemsSource="{Binding AvailableExcelColumnOptions}"
                                                                  SelectedValue="{Binding Col8ExcelColumn}"
                                                                  SelectedValuePath="Code"
                                                                  DisplayMemberPath="Name"
                                                                  Height="22" FontSize="10.5" Width="105" VerticalContentAlignment="Center"
                                                                  ToolTip="8열에 매핑할 엑셀 컬럼을 변경합니다."/>
                                                        <Button Content="✕ 해제" Command="{Binding UnlinkColumnExcelCommand}" CommandParameter="8"
                                                                Visibility="{Binding IsCol8ExcelLinked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="4,0" FontSize="10" Foreground="#DC2626" Margin="4,0,0,0"
                                                                ToolTip="8열의 엑셀 연동을 해제하고 직접 입력 모드로 전환합니다."/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBox x:Name="TxtCol8" Tag="7" PreviewKeyDown="OnInputPreviewKeyDown"
                                                         IsEnabled="{Binding IsCol8DirectInputEnabled}"
                                                         Text="{Binding Col8EffectiveText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Height="28" FontSize="12" Padding="6,2" BorderBrush="#CBD5E1"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <!-- 3. 인쇄 설정 및 실행 카드 -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🖨️ 인쇄 설정 및 출력" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                        <!-- A. 엑셀 연동 시 인쇄 옵션 -->
                                        <StackPanel Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="인쇄 매수" Width="65" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-" Command="{Binding DecreaseExcelPrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="26" FontSize="13" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding ExcelPrintCopies, UpdateSourceTrigger=PropertyChanged}" Width="36" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" FontWeight="Bold" BorderBrush="#CBD5E1" Margin="2,0"/>
                                                    <Button Content="+" Command="{Binding IncreaseExcelPrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="26" FontSize="13" FontWeight="Bold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="매 / 행당" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="출력 구간" Width="65" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding PrintRangeStart, UpdateSourceTrigger=PropertyChanged}" Width="36" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" FontWeight="Bold" BorderBrush="#CBD5E1"/>
                                                    <TextBlock Text=" ~ " VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="4,0"/>
                                                    <TextBox Text="{Binding PrintRangeEnd, UpdateSourceTrigger=PropertyChanged}" Width="36" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" FontWeight="Bold" BorderBrush="#CBD5E1" Margin="0,0,6,0"/>
                                                    <TextBlock Text="행" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- 엑셀 출력 버튼 2단 배치 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🖨️ 현재 1건" Command="{Binding SinglePrintCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Foreground="White" Height="34" FontSize="12" FontWeight="Bold" ToolTip="현재 행 1건만 인쇄"/>
                                                <Button Grid.Column="2" Content="📑 구간 출력" Command="{Binding PrintRangeCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="#4F46E5" Foreground="White" Height="34" FontSize="12" FontWeight="Bold" ToolTip="지정 구간 인쇄"/>
                                            </Grid>

                                            <Button Content="🚀 엑셀 전체 일괄 인쇄" Command="{Binding PrintAllRecordsCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Foreground="White" Height="38" FontSize="13" FontWeight="Bold" ToolTip="엑셀 전체 데이터 일괄 인쇄"/>
                                        </StackPanel>

                                        <!-- B. 엑셀 미연동 시 단건 인쇄 옵션 -->
                                        <StackPanel Visibility="{Binding IsExcelFileNotLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="인쇄 매수" Width="65" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-" Command="{Binding DecreaseSinglePrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="26" FontSize="13" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding SinglePrintCopies, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" BorderBrush="#CBD5E1" Margin="2,0"/>
                                                    <Button Content="+" Command="{Binding IncreaseSinglePrintCopiesCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="26" FontSize="13" FontWeight="Bold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="매" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <Button Content="🖨️ 라벨 인쇄 (Enter)" Command="{Binding SinglePrintCommand}" IsEnabled="{Binding IsCurrentPrinterAuthorized}" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" Height="40" FontSize="13.5" FontWeight="Bold" ToolTip="현재 보이는 라벨을 인쇄합니다."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 엑셀 데이터 연동 카드 -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📊 엑셀 데이터 연동" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Records.Count, StringFormat='총 {0}건'}" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- 연동 해제 버튼 -->
                                            <Button Content="❌ 연동 해제" Command="{Binding UnlinkExcelCommand}" Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="10.5" Foreground="#DC2626" HorizontalAlignment="Right" ToolTip="엑셀 파일 연동을 해제합니다."/>
                                        </DockPanel>

                                        <!-- A. 엑셀 미연동 상태 안내 및 파일 불러오기 -->
                                        <Border Visibility="{Binding IsExcelFileNotLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,16" Margin="0,2,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="연결된 엑셀 파일이 없습니다" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="엑셀 파일을 불러오면 각 라벨 요소(텍스트/바코드)의 속성에서 열(컬럼)을 매칭하여 대량 인쇄할 수 있습니다." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                                                <Button Content="📂 엑셀 파일 불러오기" Command="{Binding ImportFromExcelCommand}" Style="{StaticResource ModernButtonStyle}" Background="#059669" Foreground="White" Height="32" Padding="14,0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="엑셀 파일(*.xlsx) 불러오기"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- B. 엑셀 연동 상태: 파일 정보 + 데이터 행 탐색기 + 목록 테이블 -->
                                        <StackPanel Visibility="{Binding IsExcelFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- 파일 정보 & 변경 버튼 -->
                                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding LoadedExcelFileName, StringFormat='📄 {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                    <Button Content="🔄 파일 변경" Command="{Binding ImportFromExcelCommand}" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="10.5" HorizontalAlignment="Right" ToolTip="다른 엑셀 파일로 교체"/>
                                                </DockPanel>
                                            </Border>

                                            <!-- 실시간 데이터 행 탐색기 (◀ 1 / 45 ▶) -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="🔍 미리보기 데이터 행 탐색" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                    <DockPanel LastChildFill="False">
                                                        <Button DockPanel.Dock="Left" Content="⏮" Command="{Binding PreviewFirstPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="26" FontSize="11" ToolTip="첫 행"/>
                                                        <Button DockPanel.Dock="Left" Content="◀ 이전" Command="{Binding PreviewPreviousPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="52" Height="26" FontSize="11.5" Margin="4,0,0,0" ToolTip="이전 행"/>

                                                        <Border DockPanel.Dock="Left" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,0" Height="26" Margin="6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PreviewPageText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <Button DockPanel.Dock="Left" Content="다음 ▶" Command="{Binding PreviewNextPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="52" Height="26" FontSize="11.5" Margin="0,0,4,0" ToolTip="다음 행"/>
                                                        <Button DockPanel.Dock="Left" Content="⏭" Command="{Binding PreviewLastPageCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="26" Height="26" FontSize="11" ToolTip="마지막 행"/>
                                                    </DockPanel>
                                                    <TextBlock Text="💡 행을 이동하면 라벨에 해당 엑셀 행의 데이터가 실시간 표시됩니다." FontSize="10.5" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 엑셀 데이터 목록 테이블 (MainDataGrid) -->
                                            <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Height="150" Margin="0,0,0,4">
                                                <DataGrid x:Name="MainDataGrid" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Background="Transparent" BorderThickness="0" RowHeight="26" FontSize="11.5" ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}" PreviewMouseDoubleClick="MainDataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonUp="MainDataGrid_PreviewMouseRightButtonUp">
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="🖨️ 선택 항목 출력" Command="{Binding ReprintSelectedRecordsCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}"/>
                                                            <Separator/>
                                                            <MenuItem Header="🗑️ 선택 항목 삭제" Command="{Binding DeleteSelectedRecordCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}"/>
                                                            <MenuItem Header="🧹 전체 목록 비우기" Command="{Binding ClearAllRecordsCommand}"/>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <!-- 체크박스 컬럼 -->
                                                        <DataGridCheckBoxColumn Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="38"/>
                                                        <!-- 순번 -->
                                                        <DataGridTextColumn Header="No" Binding="{Binding Index}" Width="40" IsReadOnly="True"/>
                                                        <!-- 데이터 컬럼 1 ~ 8 -->
                                                        <DataGridTextColumn x:Name="GridCol1" Header="{Binding DataContext.Column1Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col1, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol2" Header="{Binding DataContext.Column2Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col2, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol3" Header="{Binding DataContext.Column3Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col3, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol4" Header="{Binding DataContext.Column4Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col4, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol5" Header="{Binding DataContext.Column5Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col5, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol6" Header="{Binding DataContext.Column6Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col6, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol7" Header="{Binding DataContext.Column7Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col7, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                        <DataGridTextColumn x:Name="GridCol8" Header="{Binding DataContext.Column8Header, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Col8, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Border>

                                            <!-- 그리드 빠른 관리 바 -->
                                            <DockPanel Margin="0,2,0,0">
                                                <Button DockPanel.Dock="Left" Content="🗑️ 선택 삭제" Command="{Binding DeleteSelectedRecordCommand}" CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItems}" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" Foreground="#DC2626" ToolTip="선택한 행 삭제"/>
                                                <Button DockPanel.Dock="Right" Content="🧹 비우기" Command="{Binding ClearRecordsCommand}" Style="{StaticResource MiniStepBtnStyle}" Height="22" Padding="6,0" FontSize="11" ToolTip="목록 비우기"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
            </Grid>
            </Grid>
            </Border>
        </Grid>

        <!-- 2. Status Bar -->
        <StatusBar Grid.Row="2" Background="White" Margin="0,6,0,0" Padding="8,4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding ConnectionInfo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
