<Window x:Class="BarcodePrint.WpfView.ColumnFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎨 항목 서식 및 바코드 설정"
        Width="560" Height="500" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        FontFamily="Malgun Gothic"
        Background="#F8FAFC">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Button Styles -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniStepBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tgBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBoxBorder" Width="18" Height="18" CornerRadius="4" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path x:Name="chkCheckMark" Data="M 3.5,9.5 L 7.5,13.5 L 14.5,5.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBoxBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="chkBoxBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="chkCheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Body Form -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Close Button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ColBadgeBorder" Background="#2563EB" CornerRadius="4" Padding="7,3" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtColBadge" Text="1열" FontWeight="Bold" FontSize="12.5" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="항목 서식 및 바코드 설정" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="실시간 자동 적용" FontSize="11.5" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 1. Body Form Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 글꼴 및 텍스트 스타일 -->
                <Border Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔤 글꼴 및 텍스트 스타일" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="항목 제목" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtHeaderName" Grid.Column="1" Height="28" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#94A3B8" BorderThickness="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="글꼴" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="CmbFont" Grid.Column="1" Height="28" FontSize="12" VerticalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="글자 크기" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnSizeMinus" Content="-" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="26" Click="OnSizeMinusClick"/>
                                <TextBox x:Name="TxtSize" Width="36" Height="26" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,0" BorderBrush="#94A3B8" BorderThickness="1"/>
                                <Button x:Name="BtnSizePlus" Content="+" Style="{StaticResource MiniStepBtnStyle}" Width="24" Height="26" Margin="0,0,12,0" Click="OnSizePlusClick"/>

                                <ToggleButton x:Name="TglBold" Style="{StaticResource ModernToggleBtnStyle}" Width="28" Height="26" Margin="0,0,4,0" ToolTip="굵게 (Bold)">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="12"/>
                                </ToggleButton>
                                <ToggleButton x:Name="TglItalic" Style="{StaticResource ModernToggleBtnStyle}" Width="28" Height="26" Margin="0,0,12,0" ToolTip="기울임 (Italic)">
                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="12"/>
                                </ToggleButton>

                                <ComboBox x:Name="CmbAlign" Width="80" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,0,0,0">
                                    <ComboBoxItem Content="좌측 정렬" Tag="LEFT"/>
                                    <ComboBoxItem Content="가운데 정렬" Tag="CENTER"/>
                                    <ComboBoxItem Content="우측 정렬" Tag="RIGHT"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. 특수 출력 및 바코드 설정 -->
                <Border Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🏷️ 바코드 및 서식 옵션" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="ChkIncludeHeader" Content="📋 라벨에 항목 제목 함께 출력" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" Margin="0,0,16,6"/>
                            <CheckBox x:Name="ChkPriceFormat" Content="💰 금액 서식 (3자리 콤마 및 ₩ 자동적용)" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,6"/>
                        </WrapPanel>

                        <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <CheckBox x:Name="ChkBarcode" Content="🏷️ 바코드 / 2D 코드로 출력" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" FontWeight="Bold" Foreground="#EA580C" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="포맷: " FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbBarcodeType" Width="120" Height="26" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="ChkShowBarcodeText" Content="바코드 아래 값(텍스트) 표시" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. 위치 및 크기 조절 (mm) -->
                <Border Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📐 위치 및 크기 설정 (mm 단위)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="X 좌표 (mm)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtOffsetX" Height="26" FontSize="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Y 좌표 (mm)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtOffsetY" Height="26" FontSize="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="너비 (mm)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" ToolTip="0은 자동 너비"/>
                                <TextBox x:Name="TxtWidth" Height="26" FontSize="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel x:Name="PnlRowHeight" Grid.Column="3">
                                <TextBlock Text="표 행높이 (mm)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" ToolTip="표 양식 모드에서 특정 행의 높이를 고정할 때 사용 (0은 자동 균등)"/>
                                <TextBox x:Name="TxtRowHeight" Height="26" FontSize="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Bottom Close Button -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,10,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="💡 창을 닫으면 변경된 서식이 즉시 라벨에 반영됩니다." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Content="✔ 설정 완료 (닫기)" Style="{StaticResource ModernButtonStyle}" Background="#059669" Height="30" Padding="16,0" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
