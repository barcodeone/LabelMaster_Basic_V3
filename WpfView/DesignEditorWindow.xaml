                                            <ToggleButton IsChecked="{Binding Col8Bold}" Style="{StaticResource ModernToggleBtnStyle}" Width="24" Height="26" Margin="0,0,3,0" ToolTip="굵게"><TextBlock Text="B" FontWeight="Bold" FontSize="11.5"/></ToggleButton>
                                            <ToggleButton IsChecked="{Binding Col8Italic}" Style="{StaticResource ModernToggleBtnStyle}" Width="24" Height="26" Margin="0,0,6,0" ToolTip="기울임"><TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="11.5"/></ToggleButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsTableBorderEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="행높이:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <Button Content="-" Command="{Binding DecreaseColRowHeightCommand}" CommandParameter="8" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26"/>
                                                <TextBox Text="{Binding Col8RowHeight, UpdateSourceTrigger=PropertyChanged}" Width="24" Height="26" FontSize="11.5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="1,0" ToolTip="0은 자동 균등분할"/>
                                                <Button Content="+" Command="{Binding IncreaseColRowHeightCommand}" CommandParameter="8" Style="{StaticResource MiniStepBtnStyle}" Width="18" Height="26"/>
                                            </StackPanel>

                                            <CheckBox Content="💰 금액(₩)" IsChecked="{Binding IsColumn8PriceFormat}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,18,0" ToolTip="숫자에 3자리 콤마(,) 및 원화(₩) 기호를 자동 적용합니다."/>

                                            <CheckBox Content="🏷️ 바코드" IsChecked="{Binding IsColumn8Barcode}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11.5" Foreground="#EA580C" Margin="0,0,5,0" ToolTip="해당 항목을 1D/2D 바코드로 출력합니다."/>
                                            <ComboBox ItemsSource="{Binding AvailableBarcodeTypes}" SelectedItem="{Binding Col8BarcodeType}" IsEnabled="{Binding IsColumn8Barcode}" Width="92" Height="26" FontSize="10.5" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="바코드 포맷 선택"/>
                                            <CheckBox Content="값 표시" IsChecked="{Binding Col8ShowBarcodeText}" IsEnabled="{Binding IsColumn8Barcode}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="11" ToolTip="바코드 하단에 읽을 수 있는 텍스트(HRI) 출력 여부"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2. 추가 디자인 & 상세 서식 설정 그룹 (표 / 제목 / 순번 / 날짜) 통합 Expander -->
                        <Expander Style="{StaticResource ModernCardExpanderStyle}" IsExpanded="False" Margin="0,0,0,8">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="⚙️ 추가 디자인 &amp; 상세 서식 설정" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="(표 적용, 상단 제목, 순번, 날짜/시간 포맷)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <!-- 2-1. 표 적용 및 테두리/격자 설정 카드 -->
                                <Border Background="#F8FAFC" CornerRadius="7" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <CheckBox Content="📐 표 적용" IsChecked="{Binding IsTableBorderEnabled}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            <Button Content="⚖️ 표 간격 균등 분할" Command="{Binding MakeRowHeightsEqualCommand}" IsEnabled="{Binding IsTableBorderEnabled}" ToolTip="모든 행의 높이를 동일한 비율로 균등 분할 초기화" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="26" Padding="10,0" FontSize="11.5" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="방향:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <ComboBox SelectedIndex="{Binding TableOrientation}" IsEnabled="{Binding IsTableBorderEnabled}" Width="120" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,2,10,2">
                                                <ComboBoxItem Content="세로형 (헤더 좌측)" ToolTip="각 항목이 행으로 아래로 쌓이며 헤더가 왼쪽에 위치"/>
                                                <ComboBoxItem Content="가로형 (헤더 상단)" ToolTip="각 항목이 열로 나란히 배치되며 헤더가 상단에 위치"/>
                                            </ComboBox>

                                            <TextBlock Text="형태:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <ComboBox SelectedIndex="{Binding TableBorderStyle}" IsEnabled="{Binding IsTableBorderEnabled}" Width="95" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,2,10,2">
                                                <ComboBoxItem Content="전체 격자"/>
                                                <ComboBoxItem Content="외곽 박스"/>
                                                <ComboBoxItem Content="가로선만"/>
                                            </ComboBox>

                                            <TextBlock Text="두께:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <ComboBox SelectedIndex="{Binding TableBorderThicknessIndex}" IsEnabled="{Binding IsTableBorderEnabled}" Width="65" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,2,10,2">
                                                <ComboBoxItem Content="1 pt"/>
                                                <ComboBoxItem Content="2 pt"/>
                                                <ComboBoxItem Content="3 pt"/>
                                                <ComboBoxItem Content="4 pt"/>
                                                <ComboBoxItem Content="5 pt"/>
                                            </ComboBox>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2-2. 표 상단 제목 인쇄 설정 카드 -->
                                <Border Background="#F8FAFC" CornerRadius="7" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox Content="🏷️ 표 상단 제목 인쇄" IsChecked="{Binding IsTableTitleEnabled}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <CheckBox Content="제목 구분선" IsChecked="{Binding IsTableTitleUnderline}" IsEnabled="{Binding IsTableTitleEnabled}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="11.5" Margin="12,0,0,0"/>
                                        </DockPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="제목명:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <TextBox Text="{Binding TableTitleText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTableTitleEnabled}" Width="120" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,2,8,2"/>

                                            <TextBlock Text="글꼴:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <ComboBox ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding TableTitleFont}" IsEnabled="{Binding IsTableTitleEnabled}" Width="92" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,2,8,2"/>

                                            <TextBlock Text="크기:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <TextBox Text="{Binding TableTitleSize, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTableTitleEnabled}" Width="28" Height="24" FontSize="11.5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,2,8,2"/>

                                            <TextBlock Text="정렬:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,2,4,2"/>
                                            <ComboBox SelectedValue="{Binding TableTitleAlign}" SelectedValuePath="Tag" IsEnabled="{Binding IsTableTitleEnabled}" Width="65" Height="26" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,2,8,2">
                                                <ComboBoxItem Content="좌측" Tag="LEFT"/>
                                                <ComboBoxItem Content="중앙" Tag="CENTER"/>
                                                <ComboBoxItem Content="우측" Tag="RIGHT"/>
                                            </ComboBox>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2-3. 순번(Serial) 및 날짜/시간 인쇄 설정 카드 -->
                                <Border Background="#F8FAFC" CornerRadius="7" Padding="12,10" Margin="0,0,0,2" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <!-- 순번 설정 1행: 사용 여부 및 양식/방향/시작값 -->
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox Content="🔢 순번(Serial) 인쇄" IsChecked="{Binding IsSerialEnabled}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="양식:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox SelectedIndex="{Binding SerialFormatIndex}" IsEnabled="{Binding IsSerialEnabled}" Width="75" Height="26" FontSize="11" Margin="0,0,6,0">
                                                    <ComboBoxItem Content="1, 2, 3"/>
                                                    <ComboBoxItem Content="01, 02"/>
                                                    <ComboBoxItem Content="001"/>
                                                    <ComboBoxItem Content="0001"/>
                                                    <ComboBoxItem Content="No.1"/>
                                                    <ComboBoxItem Content="#01"/>
                                                    <ComboBoxItem Content="[1]"/>
                                                    <ComboBoxItem Content="(001)"/>
                                                </ComboBox>

                                                <TextBlock Text="방향:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox SelectedIndex="{Binding SerialDirectionIndex}" IsEnabled="{Binding IsSerialEnabled}" Width="65" Height="26" FontSize="11" Margin="0,0,6,0">
                                                    <ComboBoxItem Content="증가(+)"/>
                                                    <ComboBoxItem Content="감소(-)"/>
                                                </ComboBox>

                                                <TextBlock Text="시작:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding SerialStartNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSerialEnabled}" Width="40" Height="26" FontSize="11.5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 순번 설정 2행: 글꼴, 크기(-/+), 굵게, 기울임, 실시간 미리보기 -->
                                        <DockPanel Margin="0,0,0,6" IsEnabled="{Binding IsSerialEnabled}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="글꼴:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding SerialFont}" Width="92" Height="26" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,6,0"/>

                                                <TextBlock Text="크기:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button Content="-" Command="{Binding DecreaseSerialSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26"/>
                                                <TextBox Text="{Binding SerialSize, UpdateSourceTrigger=PropertyChanged}" Width="26" Height="26" FontSize="11.5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="1,0"/>
                                                <Button Content="+" Command="{Binding IncreaseSerialSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,6,0"/>

                                                <ToggleButton IsChecked="{Binding SerialBold}" Style="{StaticResource ModernToggleBtnStyle}" Width="24" Height="26" Margin="0,0,3,0" ToolTip="굵게"><TextBlock Text="B" FontWeight="Bold" FontSize="11.5"/></ToggleButton>
                                                <ToggleButton IsChecked="{Binding SerialItalic}" Style="{StaticResource ModernToggleBtnStyle}" Width="24" Height="26" Margin="0,0,6,0" ToolTip="기울임"><TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="11.5"/></ToggleButton>
                                            </StackPanel>
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSerialPreview, StringFormat='미리보기: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                            </Border>
                                        </DockPanel>

                                        <Separator Margin="0,4,0,6" Background="#CBD5E1"/>

                                        <!-- 날짜/시간 설정 1행: 사용 여부, 접두사, 양식 -->
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox Content="🕒 날짜/시간 인쇄" IsChecked="{Binding IsDateTimeEnabled}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="접두사:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBox Text="{Binding DateTimePrefix, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDateTimeEnabled}" Width="55" Height="26" FontSize="11" VerticalContentAlignment="Center" Padding="4,1" Margin="0,0,8,0" ToolTip="날짜 앞에 붙을 문구 (예: 일시: , 제조일: , 비워두기 등)"/>

                                                <TextBlock Text="양식:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox SelectedIndex="{Binding DateTimeFormatIndex}" IsEnabled="{Binding IsDateTimeEnabled}" Width="165" Height="26" FontSize="11">
                                                    <ComboBoxItem Content="YYYY-MM-DD (기본)"/>
                                                    <ComboBoxItem Content="YYYY/MM/DD"/>
                                                    <ComboBoxItem Content="YYYY.MM.DD"/>
                                                    <ComboBoxItem Content="YYYY년 MM월 DD일"/>
                                                    <ComboBoxItem Content="YYYY-MM-DD HH:mm"/>
                                                    <ComboBoxItem Content="YYYY-MM-DD HH:mm:ss"/>
                                                    <ComboBoxItem Content="YY.MM.DD"/>
                                                    <ComboBoxItem Content="YYYYMMDD (숫자만)"/>
                                                    <ComboBoxItem Content="HH:mm:ss (시간만)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 날짜/시간 설정 2행: 글꼴, 크기(-/+), 굵게, 기울임, 실시간 미리보기 -->
                                        <DockPanel IsEnabled="{Binding IsDateTimeEnabled}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="글꼴:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding DateTimeFont}" Width="92" Height="26" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,6,0"/>

                                                <TextBlock Text="크기:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button Content="-" Command="{Binding DecreaseDateTimeSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26"/>
                                                <TextBox Text="{Binding DateTimeSize, UpdateSourceTrigger=PropertyChanged}" Width="26" Height="26" FontSize="11.5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="1,0"/>
                                                <Button Content="+" Command="{Binding IncreaseDateTimeSizeCommand}" Style="{StaticResource MiniStepBtnStyle}" Width="20" Height="26" Margin="0,0,6,0"/>

                                                <ToggleButton IsChecked="{Binding DateTimeBold}" Style="{StaticResource ModernToggleBtnStyle}" Width="24" Height="26" Margin="0,0,3,0" ToolTip="굵게"><TextBlock Text="B" FontWeight="Bold" FontSize="11.5"/></ToggleButton>
                                                <ToggleButton IsChecked="{Binding DateTimeItalic}" Style="{StaticResource ModernToggleBtnStyle}" Width="24" Height="26" Margin="0,0,6,0" ToolTip="기울임"><TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="11.5"/></ToggleButton>
                                            </StackPanel>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedDateTimePreview, StringFormat='미리보기: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        <!-- 2. Bottom Action Bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="💡 여기서 설정한 서식과 표/바코드 디자인은 메인 인쇄(단건 &amp; 엑셀)에 실시간으로 자동 적용됩니다." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Content="✔️ 닫기" Click="CloseButton_Click" Style="{StaticResource ModernButtonStyle}" Background="#059669" Height="32" Padding="18,0" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
