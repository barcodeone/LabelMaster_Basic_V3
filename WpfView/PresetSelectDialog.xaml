<Window x:Class="BarcodePrint.WpfView.PresetSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자주 사용하는 라벨 규격 선택" Height="480" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic" WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DlgBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Presets List / Grid -->
            <RowDefinition Height="*"/>
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="기본 규격 복원 ↺" Click="OnResetClick" Style="{StaticResource DlgBtnStyle}" Height="28" FontSize="11" Margin="0,0,6,0" Foreground="#64748B"/>
                    <Button Content="규격 관리 &amp; 순서 ⚙️" Click="OnManageClick" Style="{StaticResource DlgBtnStyle}" Height="28" FontSize="11" Foreground="#2563EB" Background="#EFF6FF" BorderBrush="#BFDBFE"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="자주 사용하는 라벨 규격 선택" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                        <TextBlock Text="작업할 라벨 규격을 선택하거나 더블클릭하면 즉시 편집 화면이 열립니다." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Presets Items List -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="6" Margin="0,0,0,16">
            <ListBox x:Name="LstPresets" BorderThickness="0" Background="Transparent" SelectionMode="Single" MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 아이콘/순번 -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="🏷️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 명칭 및 설명 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplaySize}" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- 오른쪽 선택 버튼 텍스트 -->
                            <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                <TextBlock Text="선택 ➔" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom Action Buttons -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="✏️ 선택한 규격 수정" Click="OnEditSelectedClick" Style="{StaticResource DlgBtnStyle}" Height="34" ToolTip="선택한 라벨 규격의 이름과 크기를 변경합니다"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Click="OnCancelClick" Style="{StaticResource DlgBtnStyle}" Height="34" Width="80" Margin="0,0,8,0"/>
                <Button Content="이 규격으로 편집 시작 ➔" Click="OnConfirmClick" Style="{StaticResource DlgPrimaryBtnStyle}" Height="34"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
