<Window x:Class="BarcodePrint.WpfView.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="라벨마스터 - LabelMaster (v1.1.8)"
        Width="1180" Height="720" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Pretendard, 맑은 고딕, Malgun Gothic, Segoe UI, sans-serif"
        FontSize="13"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Gradients & Brushes (Premium Navy & Modern Accent) -->
        <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E293B" Offset="0.0"/>
            <GradientStop Color="#0F172A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Eye-Catching Premium Orange Store Banner Gradient -->
        <LinearGradientBrush x:Key="StoreBannerGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EA580C" Offset="0.0"/>
            <GradientStop Color="#F97316" Offset="0.45"/>
            <GradientStop Color="#FB923C" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- New Template Hero CTA Gradient (Normal) -->
        <LinearGradientBrush x:Key="NewTemplateHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0.0"/>
            <GradientStop Color="#1D4ED8" Offset="0.55"/>
            <GradientStop Color="#1E40AF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- New Template Hero CTA Gradient (Hover: 진한 딥 블루) -->
        <LinearGradientBrush x:Key="NewTemplateHeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D4ED8" Offset="0.0"/>
            <GradientStop Color="#1E3A8A" Offset="0.55"/>
            <GradientStop Color="#172554" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- New Template Hero CTA Gradient (Pressed: 딥 네이비) -->
        <LinearGradientBrush x:Key="NewTemplateHeroPressedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E3A8A" Offset="0.0"/>
            <GradientStop Color="#172554" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="MacPrimaryBlue" Color="#2563EB"/>

        <!-- Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
        <DropShadowEffect x:Key="BannerShadow" Color="#EA580C" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.25"/>
        <DropShadowEffect x:Key="HeroShadow" Color="#1D4ED8" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.25"/>

        <!-- Hero New Template Button Style (Hover시 진한색으로 변경) -->
        <Style x:Key="HeroNewTemplateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NewTemplateHeroGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="heroBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Effect="{StaticResource HeroShadow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="heroBorder" Property="Background" Value="{StaticResource NewTemplateHeroHoverBrush}"/>
                                <Setter TargetName="heroBorder" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="heroBorder" Property="Background" Value="{StaticResource NewTemplateHeroPressedBrush}"/>
                                <Setter TargetName="heroBorder" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Active Item Style -->
        <Style x:Key="SidebarActiveNavItemStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="#EFF6FF" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Button Style -->
        <Style x:Key="PresetCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Effect="{StaticResource CardShadow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#FAFCFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mini Action Button Style -->
        <Style x:Key="MacMiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="MacPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Left Fixed Sidebar (Width: 274 - 배너 230px + 스크롤바 여유 폭 확보) -->
            <ColumnDefinition Width="274"/>
            <!-- 2. Right Main Dashboard Workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- [1. LEFT DESKTOP SIDEBAR] (통합 네비게이션 허브)               -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,12,6,12">
                <Grid.RowDefinitions>
                    <!-- Brand Logo & App Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Divider -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu Navigation List -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Compact Printer Status & Store -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <DockPanel Grid.Row="0" Margin="2,2,2,10">
                    <Border Width="40" Height="40" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LabelMaster;component/resource/Logo_LM.jpg" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LABEL MASTER" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock x:Name="TxtAppVersion" Text="라벨마스터 v1.1.8" FontSize="11.5" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Divider -->
                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,8"/>

                <!-- Navigation Menu List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="빠른 메뉴" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" Margin="6,0,0,4"/>

                        <!-- 1. 홈 (대시보드) -->
                        <Button Style="{StaticResource SidebarActiveNavItemStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏠" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="홈 (대시보드)" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MacPrimaryBlue}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. 새 라벨 만들기 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnNewTemplateClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="➕" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="새 라벨 만들기" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. 서식 파일 열기 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnLoadTemplateClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="서식 파일 열기" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. PDF 문서 인쇄 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnPdfPrintClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PDF 문서 인쇄" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#F1F5F9" Margin="4,8,4,8"/>
                        <TextBlock Text="환경 설정 및 도구" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" Margin="6,0,0,4"/>

                        <!-- 5. 프린터 관리 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnOpenPrinterSettingsClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프린터 관리" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. 프로그램 정보 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnAboutClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프로그램 정보" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. 사이드바 HTML 배너 공간 (가로 230px, 세로 230px 고정) -->
                        <Border x:Name="SidebarBannerBorder" Width="230" Height="230" HorizontalAlignment="Center" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0" Effect="{StaticResource CardShadow}">
                            <Border CornerRadius="9" ClipToBounds="True">
                                <WebBrowser x:Name="SidebarWebBrowser" Width="230" Height="230" Navigating="OnSidebarWebBrowserNavigating" LoadCompleted="OnSidebarWebBrowserLoadCompleted"/>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- [2. RIGHT MAIN WORKSPACE] (핵심 작업 중심 2단 대시보드)         -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header Bar (64px) -->
                <RowDefinition Height="64"/>
                <!-- Main Content Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar (프린터 상태 및 설정 통합 단일화) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="라벨마스터" FontWeight="Bold" FontSize="24" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Top Right Printer Status Box & Settings Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BorderTopPrinterStatus" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,5" ToolTip="현재 연결된 프린터 상태">
                            <DockPanel LastChildFill="True">
                                <Ellipse x:Name="DotSidebarPrinter" Width="9" Height="9" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSidePrinterStatusText" Text="프린터 확인 중..." FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtSidePrinterName" Text="-" FontSize="10.5" Foreground="{StaticResource TextSubBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" MaxWidth="200"/>
                                    <TextBlock x:Name="TxtSidePrinterPort" Text="포트: -" FontSize="10" Foreground="#94A3B8" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Button Click="OnOpenPrinterSettingsClick" Style="{StaticResource MacPrimaryBtnStyle}" Height="36" Padding="14,0" Margin="10,0,0,0" ToolTip="프린터 하드웨어 설정 (인쇄 농도, 속도, 용지 규격, 센서 측정)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프린터 설정" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Dashboard Content + Bottom Docked 4-Column Banner -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="MainDashboardScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnDashboardSizeChanged">
                    <StackPanel Margin="24,12,24,8" MaxWidth="1550">

                    <!-- ============================================================== -->
                    <!-- [1. 최상단] 🏢 한국 Xprinter 공식 홈페이지 배너                     -->
                    <!-- ============================================================== -->
                    <Border Background="{StaticResource StoreBannerGradientBrush}" 
                            CornerRadius="12" Padding="18,11" Margin="0,0,0,12" 
                            Cursor="Hand" MouseLeftButtonDown="OnOfficialSiteClick" Effect="{StaticResource BannerShadow}"
                            ToolTip="클릭하여 한국 Xprinter 공식 홈페이지(xprinter.co.kr)로 이동합니다">
                        <DockPanel LastChildFill="True">
                            <!-- 우측 구매 버튼 (화이트 & 오렌지 텍스트로 가시성 극대화) -->
                            <Border DockPanel.Dock="Right" Background="White" CornerRadius="8" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="홈페이지 바로가기 ➔" FontSize="13" FontWeight="Bold" Foreground="#EA580C"/>
                            </Border>

                            <!-- 좌측 배너 아이콘 + 뱃지 + 텍스트 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#2BFFFFFF" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="한국 Xprinter" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Text="#대한민국 넘버원 택배/라벨프린터  #드라이버 설치 및 고객지원"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ============================================================== -->
                    <!-- [2. 메인 1순위] ➕ 새 라벨 만들기 (대형 블루 그라디언트 히어로 CTA) -->
                    <!-- ============================================================== -->
                    <Button Click="OnNewTemplateClick" Style="{StaticResource HeroNewTemplateBtnStyle}" Margin="0,0,0,14">
                        <Grid Height="106" Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 큼직한 화이트 서클 플러스 아이콘 -->
                            <Border Grid.Column="0" Width="58" Height="58" CornerRadius="29" Background="White" VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="➕" FontSize="25" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 제목 및 직관적인 안내 문구 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="새 라벨 만들기" FontSize="21" FontWeight="Bold" Foreground="White"/>
                                    <Border Background="#33FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="자유 규격 마법사" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="용지 크기(가로×세로 mm)와 여백, 종류를 직접 설정하여 새로운 빈 라벨을 디자인하고 인쇄합니다." FontSize="13" Foreground="#DBEAFE" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- 우측 대형 강조 화이트 CTA 버튼 -->
                            <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="20,12" VerticalAlignment="Center" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="➕ 시작하기 ➔" FontSize="14.5" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- ============================================================== -->
                    <!-- [3. 메인 2순위] 🕒 최근 작업 내역 (최신순 최대 4개 표시)          -->
                    <!-- ============================================================== -->
                    <DockPanel Margin="2,0,2,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🕒 최근 작업 내역" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock Text="최근에 작업하던 라벨 크기와 내용을 불러와 바로 작업을 이어갑니다." FontSize="11.5" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
