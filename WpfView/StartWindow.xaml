<Window x:Class="BarcodePrint.WpfView.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="라벨마스터 - LabelMaster"
        Width="1260" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Pretendard, 맑은 고딕, Malgun Gothic, Segoe UI, sans-serif"
        FontSize="13"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Gradients & Brushes (Premium Navy & Modern Accent) -->
        <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E293B" Offset="0.0"/>
            <GradientStop Color="#0F172A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Eye-Catching Premium Orange Store Banner Gradient -->
        <LinearGradientBrush x:Key="StoreBannerGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EA580C" Offset="0.0"/>
            <GradientStop Color="#F97316" Offset="0.45"/>
            <GradientStop Color="#FB923C" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- New Template Hero CTA Gradient (Normal) -->
        <LinearGradientBrush x:Key="NewTemplateHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0.0"/>
            <GradientStop Color="#1D4ED8" Offset="0.55"/>
            <GradientStop Color="#1E40AF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- New Template Hero CTA Gradient (Hover: 진한 딥 블루) -->
        <LinearGradientBrush x:Key="NewTemplateHeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D4ED8" Offset="0.0"/>
            <GradientStop Color="#1E3A8A" Offset="0.55"/>
            <GradientStop Color="#172554" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- New Template Hero CTA Gradient (Pressed: 딥 네이비) -->
        <LinearGradientBrush x:Key="NewTemplateHeroPressedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E3A8A" Offset="0.0"/>
            <GradientStop Color="#172554" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="MacPrimaryBlue" Color="#2563EB"/>

        <!-- Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
        <DropShadowEffect x:Key="BannerShadow" Color="#EA580C" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.25"/>
        <DropShadowEffect x:Key="HeroShadow" Color="#1D4ED8" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.25"/>

        <!-- Hero New Template Button Style (Hover시 진한색으로 변경) -->
        <Style x:Key="HeroNewTemplateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NewTemplateHeroGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="heroBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Effect="{StaticResource HeroShadow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="heroBorder" Property="Background" Value="{StaticResource NewTemplateHeroHoverBrush}"/>
                                <Setter TargetName="heroBorder" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="heroBorder" Property="Background" Value="{StaticResource NewTemplateHeroPressedBrush}"/>
                                <Setter TargetName="heroBorder" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Active Item Style -->
        <Style x:Key="SidebarActiveNavItemStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="#EFF6FF" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Button Style -->
        <Style x:Key="PresetCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Effect="{StaticResource CardShadow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#FAFCFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mini Action Button Style -->
        <Style x:Key="MacMiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="MacPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Left Fixed Sidebar (Width: 230) -->
            <ColumnDefinition Width="230"/>
            <!-- 2. Right Main Dashboard Workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- [1. LEFT DESKTOP SIDEBAR] (통합 네비게이션 허브)               -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,16,14,16">
                <Grid.RowDefinitions>
                    <!-- Brand Logo & App Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Divider -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu Navigation List -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Compact Printer Status & Store -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <DockPanel Grid.Row="0" Margin="4,4,4,14">
                    <Border Width="40" Height="40" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/LabelMaster;component/resource/Logo_LM.jpg" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LABEL MASTER" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock x:Name="TxtAppVersion" Text="라벨마스터 v1.0.1" FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Divider -->
                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,12"/>

                <!-- Navigation Menu List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="빠른 메뉴" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,6"/>

                        <!-- 1. 홈 (대시보드) -->
                        <Button Style="{StaticResource SidebarActiveNavItemStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="홈 (대시보드)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MacPrimaryBlue}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. 새 라벨 만들기 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnNewTemplateClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="➕" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="새 라벨 만들기" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. 서식 파일 열기 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnLoadTemplateClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="서식 파일 열기" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. PDF 문서 인쇄 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnPdfPrintClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PDF 문서 인쇄" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#F1F5F9" Margin="6,10,6,10"/>
                        <TextBlock Text="환경 설정 및 도구" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,6"/>

                        <!-- 5. 프린터 관리 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnOpenPrinterSettingsClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프린터 관리" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. 프로그램 정보 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnAboutClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프로그램 정보" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. 공식 소모품 스토어 -->
                        <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnStoreLinkClick" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="정품 소모품 몰" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Compact Printer Status Badge in Sidebar (상태 동기화 보장) -->
                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                    <DockPanel LastChildFill="True">
                        <Ellipse x:Name="DotSidebarPrinter" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSidePrinterStatusText" Text="프린터 확인 중..." FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtSidePrinterName" Text="-" FontSize="10.5" Foreground="{StaticResource TextSubBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtSidePrinterPort" Text="포트: -" FontSize="9.5" Foreground="#94A3B8" Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- [2. RIGHT MAIN WORKSPACE] (핵심 작업 중심 2단 대시보드)         -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header Bar (56px) -->
                <RowDefinition Height="56"/>
                <!-- Main Content Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar (프린터 상태 및 설정 통합 단일화) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="라벨마스터" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                        </Border>
                    </StackPanel>

                    <!-- Top Right Single Printer Status Badge & Settings Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BorderPrinterBadge" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="18" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="OnPrinterBadgeClick" ToolTip="클릭하여 프린터 검색 및 연결 마법사를 실행합니다">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotPrinterStatus" Width="9" Height="9" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPrinterStatus" Text="프린터 상태 확인 중..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▾" FontSize="10" Foreground="{StaticResource TextSubBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Click="OnOpenPrinterSettingsClick" Style="{StaticResource MacPrimaryBtnStyle}" Height="30" Padding="12,0" Margin="10,0,0,0" ToolTip="프린터 하드웨어 설정 (인쇄 농도, 속도, 용지 규격, 센서 측정)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프린터 설정" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Dashboard Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,28" MaxWidth="1320">

                    <!-- ============================================================== -->
                    <!-- [1. 최상단] 🛒 소모품 스토어 공식 배너 (선명한 비비드 오렌지 복원) -->
                    <!-- ============================================================== -->
                    <Border Background="{StaticResource StoreBannerGradientBrush}" 
                            CornerRadius="12" Padding="20,16" Margin="0,0,0,20" 
                            Cursor="Hand" MouseLeftButtonDown="OnStoreLinkClick" Effect="{StaticResource BannerShadow}">
                        <DockPanel LastChildFill="True">
                            <!-- 우측 구매 버튼 (화이트 & 오렌지 텍스트로 가시성 극대화) -->
                            <Border DockPanel.Dock="Right" Background="White" CornerRadius="8" Padding="16,8" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="스토어 바로가기 ➔" FontSize="13" FontWeight="Bold" Foreground="#EA580C"/>
                            </Border>

                            <!-- 좌측 배너 아이콘 + 뱃지 + 텍스트 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🛒" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#2BFFFFFF" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="공식 인증 스토어" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="TSPL 공식 인증 감열 롤라벨 및 잉크 리본 최저가 구매 바로가기" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ============================================================== -->
                    <!-- [2. 메인 1순위] ➕ 새 라벨 만들기 (대형 블루 그라디언트 히어로 CTA - 세로 크기 확대) -->
                    <!-- ============================================================== -->
                    <Button Click="OnNewTemplateClick" Style="{StaticResource HeroNewTemplateBtnStyle}" Margin="0,0,0,26">
                        <Grid Height="138" Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 큼직한 화이트 서클 플러스 아이콘 -->
                            <Border Grid.Column="0" Width="66" Height="66" CornerRadius="33" Background="White" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="➕" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 제목 및 직관적인 안내 문구 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="새 라벨 만들기" FontSize="21" FontWeight="Bold" Foreground="White"/>
                                    <Border Background="#33FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="자유 규격 마법사" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="용지 크기(가로×세로 mm)와 여백, 종류를 직접 설정하여 새로운 빈 라벨을 디자인하고 인쇄합니다." FontSize="13" Foreground="#DBEAFE" Margin="0,7,0,0"/>
                            </StackPanel>

                            <!-- 우측 대형 강조 화이트 CTA 버튼 -->
                            <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="22,12" VerticalAlignment="Center" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="➕ 시작하기 ➔" FontSize="14.5" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- ============================================================== -->
                    <!-- [3. 메인 2순위] 🕒 최근 작업 내역 (최신순 최대 4개 표시)          -->
                    <!-- ============================================================== -->
                    <DockPanel Margin="2,0,2,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🕒 최근 작업 내역" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock Text="최근에 작업하던 라벨 크기와 내용을 불러와 바로 작업을 이어갑니다." FontSize="11.5" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="OnLoadTemplateClick" Style="{StaticResource MacMiniBtnStyle}" Height="30" Padding="12,0" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" Background="#F5F3FF" BorderBrush="#DDD6FE" ToolTip="PC에 저장된 서식 파일(*.lbm)을 엽니다">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="내 템플릿 보관함" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- 최근 작업내역 4열 균등 그리드 (최대 4개 표시) -->
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- [0. 최근 작업 없을 때] 📭 빈 카드 (Empty Card) -->
                        <Border x:Name="CardRecentEmpty" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Visibility="Collapsed">
                            <Grid Height="140" Margin="14,14">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="📭" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="최근 작업 내역 없음" FontWeight="Bold" FontSize="13.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="새 라벨을 제작하면 여기에 표시됩니다." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- [1. 최신 작업 1순위] -->
                        <Button x:Name="BtnRecent0" Grid.Column="0" Style="{StaticResource PresetCardButtonStyle}" Click="OnRecentCardClick" Tag="0" Visibility="Collapsed">
                            <Grid Height="140" Margin="14,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="18" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRecentTitle0" Text="이전 작업" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                            <Border Background="#ECFDF5" CornerRadius="4" Padding="5,1.5" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtRecentSize0" Text="70×100 mm" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1" x:Name="TxtRecentSubtitle0" Text="마지막으로 편집하던 라벨 작업을 이어갑니다." FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                <DockPanel Grid.Row="2">
                                    <TextBlock Text="이어서 열기 ➔" FontSize="11.5" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Button>

                        <!-- [2. 최신 작업 2순위] -->
                        <Button x:Name="BtnRecent1" Grid.Column="2" Style="{StaticResource PresetCardButtonStyle}" Click="OnRecentCardClick" Tag="1" Visibility="Collapsed">
                            <Grid Height="140" Margin="14,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="🏷️" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRecentTitle1" Text="최근 작업 2" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="5,1.5" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtRecentSize1" Text="80×50 mm" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1" x:Name="TxtRecentSubtitle1" Text="편집하던 라벨 작업을 이어갑니다." FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                <DockPanel Grid.Row="2">
                                    <TextBlock Text="이어서 열기 ➔" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Button>

                        <!-- [3. 최신 작업 3순위] -->
                        <Button x:Name="BtnRecent2" Grid.Column="4" Style="{StaticResource PresetCardButtonStyle}" Click="OnRecentCardClick" Tag="2" Visibility="Collapsed">
                            <Grid Height="140" Margin="14,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="📝" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRecentTitle2" Text="최근 작업 3" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                            <Border Background="#F5F3FF" CornerRadius="4" Padding="5,1.5" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtRecentSize2" Text="50×30 mm" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1" x:Name="TxtRecentSubtitle2" Text="편집하던 라벨 작업을 이어갑니다." FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                <DockPanel Grid.Row="2">
                                    <TextBlock Text="이어서 열기 ➔" FontSize="11.5" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Button>

                        <!-- [4. 최신 작업 4순위] -->
                        <Button x:Name="BtnRecent3" Grid.Column="6" Style="{StaticResource PresetCardButtonStyle}" Click="OnRecentCardClick" Tag="3" Visibility="Collapsed">
                            <Grid Height="140" Margin="14,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="📐" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRecentTitle3" Text="최근 작업 4" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                            <Border Background="#FFFBEB" CornerRadius="4" Padding="5,1.5" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtRecentSize3" Text="40×20 mm" FontSize="10.5" FontWeight="Bold" Foreground="#D97706"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1" x:Name="TxtRecentSubtitle3" Text="편집하던 라벨 작업을 이어갑니다." FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                <DockPanel Grid.Row="2">
                                    <TextBlock Text="이어서 열기 ➔" FontSize="11.5" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- [4. 하단 HTML 웹뷰 배너 공간] (새 라벨 만들기 버튼과 동일한 크기)   -->
                    <!-- ============================================================== -->
                    <Border x:Name="QuickToolsHtmlBorder" Height="138" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,14,0,26" Effect="{StaticResource CardShadow}">
                        <Border CornerRadius="11" ClipToBounds="True">
                            <WebBrowser x:Name="QuickToolsWebBrowser" Height="138" Navigating="OnQuickToolsWebBrowserNavigating" LoadCompleted="OnQuickToolsWebBrowserLoadCompleted"/>
                        </Border>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
